#!/usr/bin/env bash
# wallpaper-interval -- how often the wallpaper rotates.
#
# The rotation itself is wallpaper-rotate.timer, which is a TRACKED file in
# this repository. This does not touch it. It writes a systemd DROP-IN, which
# is systemd's own answer to "override one setting without editing the unit",
# and is the same boundary hypr-tweak draws against hyprland.lua: the shell
# owns the generated fragment, the person owns the unit.
#
#   ~/.config/systemd/user/wallpaper-rotate.timer.d/interval.conf
#
# THE EMPTY ASSIGNMENT IS NOT DECORATION. Timer options accumulate: a drop-in
# that just says OnUnitActiveSec=45min gives the unit TWO triggers, the
# original 30 and the new 45, and it fires on both. Assigning the empty string
# first resets the list, which is the documented way to replace rather than
# add.
#
# NO RESTART, ONLY A RELOAD, and that was measured before being relied on:
# after `daemon-reload` alone, `systemctl show -p TimersMonotonic` reported the
# new interval and list-timers recalculated the next elapse from the LAST run.
# Restarting the timer would re-arm OnActiveSec instead, so changing "every 30
# minutes" to "every 6 hours" would drag the next change to five minutes from
# now -- a settings change that quietly moves something else.
#
# OnActiveSec is deliberately left alone for the same reason. It is the delay
# after login before the first change, which is a different question from how
# often, and the unit's own comment explains why it is five minutes.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/wallpaper-interval"

DROPIN_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/wallpaper-rotate.timer.d"
DROPIN="$DROPIN_DIR/interval.conf"

# The unit's own value, which is what "no drop-in" means. Repeated here
# because a script cannot read a comment; if the unit ever changes, this is
# the line that has to follow it.
readonly DEFAULT_MINUTES=30

# Five minutes is the floor because matugen runs on every change: a full
# palette regeneration and ten template renders. A week is the ceiling because
# past that "automatic" stops being a useful word for it.
readonly MIN_MINUTES=5
readonly MAX_MINUTES=10080

usage() {
    cat >&2 <<'EOF'
Usage:
  wallpaper-interval            print the interval in minutes
  wallpaper-interval <minutes>  set it (5 - 10080)
  wallpaper-interval clear      back to the unit's own value
EOF
    exit 2
}

current() {
    local value
    if [[ -r $STATE_FILE ]]; then
        read -r value < "$STATE_FILE" || value=""
        if [[ $value =~ ^[0-9]+$ ]] \
            && (( value >= MIN_MINUTES && value <= MAX_MINUTES )); then
            printf '%s' "$value"
            return
        fi
    fi
    printf '%s' "$DEFAULT_MINUTES"
}

apply() {
    local minutes=$1

    mkdir -p "$DROPIN_DIR"
    cat > "$DROPIN" <<EOF
# GENERATED by wallpaper-interval. Do not edit: it is rewritten whenever the
# interval changes in the settings window (SUPER + C) or from a terminal.
# Delete it, or run 'wallpaper-interval clear', and the rotation goes back to
# whatever wallpaper-rotate.timer says.
#
# The empty assignment resets the list. Without it this would ADD a second
# trigger to the unit's own rather than replacing it.
[Timer]
OnUnitActiveSec=
OnUnitActiveSec=${minutes}min
EOF

    # Best-effort: outside a user session -- a chroot, a build -- there is no
    # manager to tell, and the file is still correct for the next login.
    systemctl --user daemon-reload 2>/dev/null || true
}

case "${1:-show}" in
    show)
        echo "$(current)"
        ;;

    clear)
        rm -f "$DROPIN" "$STATE_FILE"
        rmdir "$DROPIN_DIR" 2>/dev/null || true
        systemctl --user daemon-reload 2>/dev/null || true
        echo "Back to ${DEFAULT_MINUTES} minutes, the unit's own value."
        ;;

    *)
        [[ $1 =~ ^[0-9]+$ ]] || usage
        (( $1 >= MIN_MINUTES && $1 <= MAX_MINUTES )) || {
            echo "wallpaper-interval: must be between $MIN_MINUTES and $MAX_MINUTES minutes." >&2
            exit 2
        }

        mkdir -p "$STATE_DIR"
        printf '%s\n' "$1" > "$STATE_FILE"
        apply "$1"
        ;;
esac
