#!/usr/bin/env bash
# hypr-tweak -- the old name of `desktop-tweak`, kept so nothing breaks.
#
# The script stopped being about Hyprland the moment it learned to write niri's
# override layer too, and a name that says which compositor it serves is a name
# that has to be looked past every time a third one is added. So it was
# renamed, and this is left behind: a machine that pulls these dotfiles while a
# local.lua, a local.kdl or somebody's fingers still say `hypr-tweak` keeps
# working instead of failing at the one moment nobody is watching -- a keybind
# that quietly does nothing.
#
# NOT A SYMLINK, on purpose: this file is what says the old name is old. A
# symlink says the two names are equal.
#
# Resolved through this file's own location rather than $PATH, because the one
# caller that matters is a compositor keybind, and a compositor's idea of $PATH
# is whatever it inherited from the session -- which is exactly the environment
# where ~/.local/bin has been known not to be on it.
set -euo pipefail

exec "$(dirname "$(readlink -f "$0")")/desktop-tweak" "$@"
