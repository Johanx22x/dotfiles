#!/usr/bin/env bash
# hypr-tweak -- the compositor settings the settings window can change.
#
# Gaps, corner rounding, border thickness, mouse behaviour, the cursor and the
# keyboard layouts. One script for all of them, and that is the point: the
# alternative -- which this repository briefly had -- is one script, one state
# file and one reader function in hyprland.lua PER VALUE, which is three new
# pieces every time a row is added to a settings page.
#
# HOW IT REACHES THE COMPOSITOR, twice, on purpose:
#
#   1. `hyprctl eval` for the running session, so the change is visible before
#      the finger comes off the button. NOT `hyprctl keyword`, which on a Lua
#      config refuses and EXITS 0 WHILE REFUSING -- see the header of
#      DisplayPage.qml, where that cost an afternoon.
#   2. ~/.config/hypr/tweaks.lua, generated, which hyprland.lua reads at the
#      very end. That is what survives `hyprctl reload`, which re-runs
#      hyprland.lua and throws away everything eval'd.
#
# The generated file is a pure override layer and never has to know what it is
# overriding: it is the LAST thing hyprland.lua reads, and a later assignment
# of a hyprlang variable replaces the earlier one. Same arrangement, and the
# same argument, as monitors.lua.
#
# WHY IT DOES NOT EDIT hyprland.lua. That file is a stow symlink into a git
# repo, a thousand lines of hand-written prose in an order a person chose. A
# program rewriting it would flatten the commentary on the first change. The
# boundary is: the shell owns tweaks.lua, the person owns hyprland.lua.
#
# THE CURSOR IS THE ODD ONE and does not go through hl.config at all. Three
# separate things have to be told: Hyprland for the session (`hyprctl
# setcursor`), the environment for anything launched afterwards (XCURSOR_*,
# which is why it lands in the generated file as hl.env), and GTK through
# gsettings, because GTK applications ask the settings portal and not the
# compositor. Miss any one and the pointer changes over some windows and not
# others.
#
# THE KEYBOARD LAYOUTS ARE A LIST AND THE FIRST ONE IS THE ACTIVE ONE.
# `layouts` holds the whole cycle -- "us,latam" -- and switching ROTATES it
# rather than moving an index: "latam,us", then "us,latam" again. It is worth
# saying why, because `hyprctl switchxkblayout` exists and looks like the
# obvious answer:
#
#   - The index is session state and lives nowhere. It goes back to zero on
#     `hyprctl reload`, and also every time ANY value on this page is changed,
#     because applying them re-evaluates the whole input block and Hyprland
#     rebuilds the keymaps. Changing the mouse speed would have put the
#     keyboard back to English.
#   - Rotating stores the answer in the one place that survives both, and the
#     cycle ORDER is preserved by a rotation, so nothing about the sequence is
#     lost. The first entry is simply where the cycle currently is.
#
# So there is no active-layout state anywhere: the list is the state, and
# everything that switches -- the bar widget, the settings window, SUPER + K
# -- comes through `hypr-tweak layout` so that all of them agree.
#
# FOUR AT MOST, AND THAT IS XKB'S LIMIT AND NOT A CHOICE HERE. An xkb keymap
# has four groups; a fifth layout is accepted by the parser and then silently
# never reached. Measured on this machine: with five configured, cycling goes
# 0, 1, 2, 3, 0. Refusing the fifth is the only way that failure is visible.
#
# ONE THING CAN STILL OVERRULE ALL OF THIS: local.lua, which hyprland.lua reads
# AFTER the generated file. A machine that sets kb_layout there keeps whatever
# it says, and the settings window would then be showing a cycle nothing is
# using. Machines that want the picker take the layout out of local.lua.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/hypr-tweaks"
GENERATED="$HOME/.config/hypr/tweaks.lua"

# key|minimum|maximum|default. The bounds are the settings window's range as
# well: it reads them from nowhere, so the two have to agree, and this is the
# copy that gets to refuse.
#
# SENSITIVITY IS IN HUNDREDTHS because bash does not do floating point and a
# shell script that shells out to bc to validate a number is a shell script
# looking for a different language. -100..100 here is Hyprland's -1.0..1.0,
# divided again on the way into the Lua.
readonly -A NUMERIC=(
    [gaps-in]="0|40|5"
    [gaps-out]="0|80|20"
    [rounding]="0|30|10"
    [border]="0|6|2"
    [sensitivity]="-100|100|0"
    [repeat-rate]="10|80|25"
    [repeat-delay]="150|800|600"
    [cursor-size]="16|48|24"
)

# The ones that are not numbers, with their accepted values.
readonly -A CHOICES=(
    [accel]="adaptive flat"
    [natural-scroll]="0 1"
)

# How many layouts an xkb keymap can hold. See the header: this is the
# format's limit, and going over it fails silently rather than loudly.
readonly LAYOUT_MAX=4

# Where the layout codes and their English names come from. The `evdev` rules
# are the ones in force -- xkbcommon's default, and hyprland.lua leaves
# kb_rules empty -- so this is the list the compositor will actually accept,
# rather than a copy of it kept here and going stale. base.lst is the fallback
# for a system that ships only the legacy rules; on this machine the two files
# hold the same 99 layouts.
readonly XKB_LST_CANDIDATES=(
    /usr/share/X11/xkb/rules/evdev.lst
    /usr/share/X11/xkb/rules/base.lst
)

usage() {
    cat >&2 <<'EOF'
Usage:
  hypr-tweak set <key> <value>   set one and apply it
  hypr-tweak reset <key>         put one back to its default
  hypr-tweak show                print every key, its value and its range
  hypr-tweak apply               re-apply everything (after a compositor restart)
  hypr-tweak clear               forget the lot
  hypr-tweak layout next|prev    move the keyboard cycle on by one
  hypr-tweak layout <code>       make that layout the active one
  hypr-tweak layouts             list every layout xkb offers, code and name

Keys:
  gaps-in gaps-out rounding border      look
  sensitivity accel natural-scroll      mouse
  repeat-rate repeat-delay layouts      keyboard
  cursor-theme cursor-size              pointer

`accel` is adaptive or flat, `natural-scroll` is 0 or 1, `sensitivity` is in
hundredths (-100..100 is Hyprland's -1.0..1.0), and `cursor-theme` is the name
of a directory under /usr/share/icons or ~/.icons.

`layouts` is the whole keyboard cycle as a comma-separated list of xkb codes,
up to four of them, and the FIRST one is the layout in use:

  hypr-tweak set layouts us,latam    two layouts, English active
  hypr-tweak layout latam            same two, Spanish (Latin American) active
  hypr-tweak layout next             whichever comes next in the cycle
EOF
    exit 2
}

# ---------------------------------------------------------------------------
# The store. Tab-separated, one key per line, sorted -- so a diff of it is
# readable and the settings window can parse it by splitting on a tab.

declare -A VALUES=()

load() {
    [[ -r $STATE_FILE ]] || return 0

    local key value
    while IFS=$'\t' read -r key value; do
        [[ -n ${key:-} ]] || continue
        VALUES[$key]=$value
    done < "$STATE_FILE"
}

save() {
    mkdir -p "$STATE_DIR"

    local key
    for key in "${!VALUES[@]}"; do
        printf '%s\t%s\n' "$key" "${VALUES[$key]}"
    done | sort > "$STATE_FILE"
}

# The value in effect: what was set, or the default. Every reader below goes
# through this, so an unset key behaves exactly like one set to its default
# rather than like a hole.
current() {
    local key=$1

    if [[ -n ${VALUES[$key]:-} ]]; then
        printf '%s' "${VALUES[$key]}"
        return
    fi

    if [[ -n ${NUMERIC[$key]:-} ]]; then
        printf '%s' "${NUMERIC[$key]##*|}"
        return
    fi

    case "$key" in
        accel)          printf 'adaptive' ;;
        natural-scroll) printf '0' ;;
        # Empty, and it means "whatever the system already has". There is no
        # sensible default cursor name to invent: the theme in use came from
        # the distribution, and overwriting it with a guess would change the
        # pointer on a machine where nobody asked for it.
        cursor-theme)   printf '' ;;
        # The same value hyprland.lua carries, on purpose. A machine that has
        # never touched the picker gets a generated file that says exactly
        # what the tracked config already said, so this key appearing in
        # tweaks.lua changes nothing until somebody chooses something.
        layouts)        printf 'us' ;;
    esac
}

validate() {
    local key=$1 value=$2

    if [[ -n ${NUMERIC[$key]:-} ]]; then
        local spec=${NUMERIC[$key]} min max
        IFS='|' read -r min max _ <<< "$spec"

        [[ $value =~ ^-?[0-9]+$ ]] || {
            echo "hypr-tweak: $key takes a whole number ($min to $max)." >&2
            exit 2
        }
        (( value >= min && value <= max )) || {
            echo "hypr-tweak: $key must be between $min and $max." >&2
            exit 2
        }
        return
    fi

    if [[ -n ${CHOICES[$key]:-} ]]; then
        local option
        for option in ${CHOICES[$key]}; do
            [[ $value == "$option" ]] && return
        done
        echo "hypr-tweak: $key must be one of: ${CHOICES[$key]}." >&2
        exit 2
    fi

    if [[ $key == layouts ]]; then
        local -a wanted=()
        IFS=',' read -r -a wanted <<< "$value"

        (( ${#wanted[@]} >= 1 )) || {
            echo "hypr-tweak: layouts needs at least one layout." >&2
            exit 2
        }
        (( ${#wanted[@]} <= LAYOUT_MAX )) || {
            echo "hypr-tweak: at most $LAYOUT_MAX layouts -- an xkb keymap has" \
                 "$LAYOUT_MAX groups, and a fifth one is never reached." >&2
            exit 2
        }

        # Read WHOLE and then searched, rather than piping the list into a
        # `grep -q` per code: with pipefail set, grep leaving early on a match
        # kills `cut` with SIGPIPE and the pipeline reports 141, which would
        # turn every valid layout into "no such layout".
        local available
        available=$(layouts | cut -f1)

        local code seen=""
        for code in "${wanted[@]}"; do
            # Checked against what xkb actually ships rather than accepted
            # blind, for the same reason the cursor theme is: an unknown code
            # does not fail, it drops that group and leaves the settings
            # window showing a layout nothing on the machine agrees with.
            grep -qx -- "$code" <<< "$available" || {
                echo "hypr-tweak: no keyboard layout called '$code'." >&2
                echo "  Try: hypr-tweak layouts" >&2
                exit 2
            }
            # A repeat is not harmless: it takes one of the four groups and
            # adds a step to the cycle that changes nothing when you reach it.
            case " $seen " in
                *" $code "*)
                    echo "hypr-tweak: '$code' is in the list twice." >&2
                    exit 2
                    ;;
            esac
            seen="$seen $code"
        done
        return
    fi

    if [[ $key == cursor-theme ]]; then
        # Checked against the directories that actually exist rather than
        # accepted blind: a cursor theme that is not installed does not fail,
        # it silently leaves the old pointer in place, and the settings window
        # would show a name nothing on screen agrees with.
        [[ -d /usr/share/icons/$value || -d $HOME/.icons/$value ]] || {
            echo "hypr-tweak: no cursor theme called '$value'." >&2
            echo "  Installed: $(themes | tr '\n' ' ')" >&2
            exit 2
        }
        return
    fi

    echo "hypr-tweak: unknown key '$key'." >&2
    usage
}

# Every directory under the icon paths that has a cursors/ subdirectory. An
# icon theme without one is an application icon set, not a pointer, and
# offering it would produce a choice that does nothing.
themes() {
    local dir theme
    for dir in "$HOME/.icons" /usr/share/icons; do
        [[ -d $dir ]] || continue
        for theme in "$dir"/*/; do
            # An `if` and not `[[ ... ]] && basename`, which is what this was
            # and which broke `show` outright: under `set -e` the loop takes
            # the status of its last command, so a final directory without a
            # cursors/ subdirectory made the whole function exit 1 and took
            # the script with it. The last entry under /usr/share/icons here
            # is `hicolor`, which never has one.
            if [[ -d ${theme}cursors ]]; then
                basename "$theme"
            fi
        done
    done | sort -u
}

# Every layout xkb offers, as `code<TAB>English name`. Two columns because the
# settings window needs both and neither one alone is enough: `latam` is what
# the compositor takes and "Spanish (Latin American)" is what a person is
# looking for in a list of ninety-nine.
#
# The `! layout` section of the rules list, which is a flat table indented by
# two spaces and terminated by the next `!` heading -- the variants come right
# after it, and reading past the boundary would offer `nativo` and `dvorak` as
# though they were layouts.
layouts() {
    local lst
    for lst in "${XKB_LST_CANDIDATES[@]}"; do
        [[ -r $lst ]] || continue

        awk '
            /^! layout/ { inside = 1; next }
            /^!/        { inside = 0 }
            inside && NF {
                code = $1
                $1 = ""
                sub(/^[ \t]+/, "")
                printf "%s\t%s\n", code, $0
            }
        ' "$lst"
        return
    done

    echo "hypr-tweak: no xkb rules list found -- is xkeyboard-config installed?" >&2
    exit 1
}

# The cycle as a bash array, in order, active one first.
cycle() {
    local -a list=()
    IFS=',' read -r -a list <<< "$(current layouts)"
    printf '%s\n' "${list[@]}"
}

# Rotate the cycle so that `target` leads it. `next` and `prev` step by one;
# anything else is a layout code and has to already be in the cycle -- adding
# one is `set layouts`, which is a different intention and validates the whole
# list rather than one member of it.
rotate() {
    local target=$1
    local -a list=()
    mapfile -t list < <(cycle)

    local count=${#list[@]}
    (( count > 1 )) || {
        # Not an error. SUPER + K on a machine with one layout is somebody
        # asking a question whose answer is "there is nowhere to go", and a
        # failing keybind would be a notification about nothing.
        echo "hypr-tweak: only one layout configured ('${list[0]}'); nothing to switch to." >&2
        exit 0
    }

    local at=0 i
    case "$target" in
        next) at=1 ;;
        prev) at=$(( count - 1 )) ;;
        *)
            at=-1
            for i in "${!list[@]}"; do
                [[ ${list[$i]} == "$target" ]] && { at=$i; break; }
            done
            (( at >= 0 )) || {
                echo "hypr-tweak: '$target' is not one of the configured layouts (${list[*]})." >&2
                echo "  Add it with: hypr-tweak set layouts $(current layouts),$target" >&2
                exit 2
            }
            ;;
    esac

    local -a rotated=()
    for (( i = 0; i < count; i++ )); do
        rotated+=( "${list[$(( (at + i) % count ))]}" )
    done

    local joined
    joined=$(IFS=','; printf '%s' "${rotated[*]}")

    VALUES[layouts]=$joined
    save
    generate
    apply_live
}

# ---------------------------------------------------------------------------
# Applying

# Hyprland wants a float here and bash has kept hundredths, so the decimal
# point is put back by hand. printf and not bc: one is in the shell, the other
# is a dependency.
sensitivity_float() {
    local hundredths sign
    hundredths=$(current sensitivity)
    sign=""
    (( hundredths < 0 )) && { sign="-"; hundredths=$(( -hundredths )); }
    printf '%s%d.%02d' "$sign" $(( hundredths / 100 )) $(( hundredths % 100 ))
}

# The Lua both halves send. Built once so the running compositor and the
# generated file cannot drift apart -- which they would, given two copies of
# this and one of them edited.
config_lua() {
    local natural="false"
    [[ $(current natural-scroll) == 1 ]] && natural="true"

    cat <<LUA
hl.config({
    general = {
        gaps_in  = $(current gaps-in),
        gaps_out = $(current gaps-out),
        border_size = $(current border),
    },
    decoration = {
        rounding = $(current rounding),
    },
    input = {
        kb_layout      = "$(current layouts)",
        sensitivity    = $(sensitivity_float),
        accel_profile  = "$(current accel)",
        natural_scroll = $natural,
        repeat_rate    = $(current repeat-rate),
        repeat_delay   = $(current repeat-delay),
    },
})
LUA
}

apply_live() {
    hyprctl eval "$(config_lua)" >/dev/null || true

    local theme size
    theme=$(current cursor-theme)
    size=$(current cursor-size)

    if [[ -n $theme ]]; then
        hyprctl setcursor "$theme" "$size" >/dev/null || true
    fi

    # GTK asks the settings portal, which reads these, and never asks the
    # compositor -- so without this half the pointer changes everywhere except
    # over GTK applications, which on this desktop is most of them.
    if command -v gsettings >/dev/null; then
        [[ -n $theme ]] && gsettings set org.gnome.desktop.interface cursor-theme "$theme" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface cursor-size "$size" 2>/dev/null || true
    fi
}

generate() {
    mkdir -p "$(dirname "$GENERATED")"

    {
        echo "-- GENERATED by hypr-tweak. Do not edit: it is rewritten whenever"
        echo "-- a value changes in the settings window (SUPER + C) or from a"
        echo "-- terminal. Delete it and the compositor goes back to whatever"
        echo "-- hyprland.lua says."
        echo "--"
        echo "-- Read LAST by hyprland.lua, so everything here is an override."
        echo
        config_lua

        local theme size
        theme=$(current cursor-theme)
        size=$(current cursor-size)

        echo
        if [[ -n $theme ]]; then
            echo "hl.env(\"XCURSOR_THEME\", \"$theme\")"
            echo "hl.env(\"HYPRCURSOR_THEME\", \"$theme\")"
        fi
        echo "hl.env(\"XCURSOR_SIZE\", \"$size\")"
        echo "hl.env(\"HYPRCURSOR_SIZE\", \"$size\")"
    } > "$GENERATED"
}

load

case "${1:-show}" in
    set)
        [[ $# -eq 3 ]] || usage
        validate "$2" "$3"
        VALUES[$2]=$3
        save
        generate
        apply_live
        ;;

    reset)
        [[ $# -eq 2 ]] || usage
        unset "VALUES[$2]"
        save
        generate
        apply_live
        ;;

    apply)
        generate
        apply_live
        ;;

    clear)
        VALUES=()
        rm -f "$STATE_FILE" "$GENERATED"
        # NOT re-applied. Clearing means "go back to hyprland.lua", and the
        # only honest way to reach that state is the reload the message asks
        # for -- eval'ing the defaults from here would put THIS script's idea
        # of them into the compositor, which is not the same thing.
        echo "Cleared. Run 'hyprctl reload' to go back to hyprland.lua's own values."
        ;;

    layout)
        [[ $# -eq 2 ]] || usage
        rotate "$2"
        ;;

    show)
        printf '%-16s %-14s %s\n' KEY VALUE RANGE
        local_keys=(gaps-in gaps-out rounding border sensitivity accel natural-scroll repeat-rate repeat-delay layouts cursor-theme cursor-size)
        for key in "${local_keys[@]}"; do
            if [[ -n ${NUMERIC[$key]:-} ]]; then
                IFS='|' read -r min max _ <<< "${NUMERIC[$key]}"
                range="$min..$max"
            elif [[ -n ${CHOICES[$key]:-} ]]; then
                range="${CHOICES[$key]// /, }"
            elif [[ $key == layouts ]]; then
                # Not the ninety-nine codes, which would bury the rest of the
                # table. `hypr-tweak layouts` is the list; what belongs here
                # is the rule that governs the value.
                range="up to $LAYOUT_MAX xkb codes, active one first"
            else
                range="$(themes | tr '\n' ' ')"
            fi
            printf '%-16s %-14s %s\n' "$key" "$(current "$key")" "$range"
        done
        ;;

    themes) themes ;;

    layouts) layouts ;;

    *) usage ;;
esac
