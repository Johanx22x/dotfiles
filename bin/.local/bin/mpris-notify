#!/usr/bin/env bash
# mpris-notify - notificacion de dunst al cambiar de pista en el navegador
#
# Lo arranca hyprland.lua en el autostart, junto a los otros vigilantes
# (wl-paste, cliphist). No lleva unidad de systemd a proposito: aqui el
# patron son los hl.exec_cmd del autostart, y esto es exactamente eso.
#
# Para probarlo a mano, sin reiniciar la sesion:
#   pkill -f 'playerctl.*--follow'; mpris-notify &

set -uo pipefail

# Una sola instancia. Dos vigilantes vivos = dos notificaciones por
# pista, y es facil acabar asi: basta con lanzarlo a mano para probar y
# olvidarse de que el autostart ya lo tenia corriendo. El descriptor 9
# se queda abierto mientras vive el proceso, asi que el cerrojo se
# suelta solo al morir, incluso a la brava.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/mpris-notify.lock"
flock -n 9 || exit 0

# Solo navegadores. mpv y Celluloid tambien hablan MPRIS, y una
# notificacion por cada pelicula que abres no es lo que se pidio.
# playerctl empareja por prefijo, asi que "brave" pilla
# brave.instance3689 y lo que venga.
JUGADORES="${MPRIS_NOTIFY_PLAYERS:-brave,firefox,chromium}"

# La carátula se copia aqui antes de notificar. Chromium borra su
# archivo temporal en cuanto cambia la pista, y dunst lee la imagen un
# instante despues de recibir la notificacion: sin la copia, la carrera
# se pierde de vez en cuando y la notificacion sale sin imagen.
PORTADA="${XDG_RUNTIME_DIR:-/tmp}/mpris-notify-cover"

# id fijo -> cada pista SUSTITUYE la notificacion anterior en vez de
# apilarse. Encadenar cinco canciones no deja cinco popups.
ID=2593

# Segundos de margen para que el navegador publique la caratula de
# verdad (ver la nota larga en el bucle). Si alguna vez sigue saliendo
# el icono del navegador, sube esto antes que tocar nada mas.
ESPERA_CARATULA="${MPRIS_NOTIFY_DELAY:-1.5}"

# Separador para partir la linea de playerctl. Se usa un caracter de
# control (unit separator) y no ":" o "|" porque los titulos de YouTube
# llevan de todo.
SEP=$'\x1f'

# Al morir hay que llevarse el playerctl. Con una tuberia normal no
# pasaba: matabas el script y el vigilante seguia vivo, huerfano, hasta
# cerrar sesion -- y cada prueba dejaba otro. Por eso se usa sustitucion
# de proceso, que si da su PID en $!.
limpiar() { [[ -n "${VIGILANTE:-}" ]] && kill "$VIGILANTE" 2>/dev/null; }

# Dos traps y no uno: en bash, un manejador de INT/TERM que no llama a
# exit deja el script CORRIENDO despues de atenderlo. Con un solo
# "trap limpiar EXIT INT TERM", un kill se llevaba el playerctl y el
# script seguia vivo, reenganchandose a los cinco segundos.
trap limpiar EXIT
trap 'limpiar; exit 0' INT TERM

while :; do
    # "metadata" no es opcional: --format es un modificador del comando,
    # no de playerctl. Sin el, playerctl escupe el modo de empleo por
    # stderr y sale, que con el 2>/dev/null de al lado es un fallo mudo.
    exec 3< <(playerctl --player "$JUGADORES" --follow metadata \
        --format "{{title}}${SEP}{{artist}}${SEP}{{mpris:artUrl}}" 2>/dev/null)
    VIGILANTE=$!

    while IFS="$SEP" read -r titulo artista arte <&3; do
        # Al parar la reproduccion playerctl emite una linea vacia.
        [[ -z "${titulo// /}" ]] && continue

        # YouTube Music publica el artista como "Fulano - Topic": son
        # los canales que genera automaticamente para la musica. El
        # sufijo no aporta nada en una notificacion.
        artista="${artista% - Topic}"

        # Misma pista con metadatos retocados (a YouTube le da por
        # reescribir artUrl a mitad de cancion) no vuelve a notificar.
        actual="${titulo}${SEP}${artista}"
        [[ "${anterior:-}" == "$actual" ]] && continue
        anterior="$actual"

        # -- Esperar a que llegue la caratula de verdad --
        # Al empezar una pista, Brave publica primero el titulo y el
        # artista, y deja mpris:artUrl apuntando a un provisional: el
        # icono de la pagina. Si se notifica en ese instante sale el
        # logo de Brave en vez de la portada del disco.
        #
        # Asi que se deja un respiro y se vuelve a preguntar. La
        # notificacion sale un segundo mas tarde, que en un aviso de
        # cambio de cancion no lo nota nadie.
        sleep "$ESPERA_CARATULA"

        titulo_ahora=$(playerctl --player "$JUGADORES" metadata title 2>/dev/null)
        if [[ -n "$titulo_ahora" && "$titulo_ahora" != "$titulo" ]]; then
            # Cambio de pista durante la espera (saltaste de cancion).
            # No se notifica esta: la linea de la nueva ya viene en cola
            # y esa si llevara su caratula.
            #
            # La condicion pide titulo NO VACIO a proposito. Durante la
            # transicion el navegador puede devolver un titulo vacio un
            # instante; si eso contara como "cambio de pista" se saltaria
            # la notificacion, y como "anterior" ya quedo apuntado, esa
            # cancion no volveria a avisar nunca.
            continue
        fi

        # Si la consulta falla o vuelve vacia nos quedamos con el artUrl
        # que traia la linea: peor una caratula provisional que ninguna.
        arte_fresco=$(playerctl --player "$JUGADORES" metadata mpris:artUrl 2>/dev/null)
        [[ -n "$arte_fresco" ]] && arte="$arte_fresco"

        # -- Caratula --
        # Los navegadores basados en Chromium dan un file:// local ya
        # descargado. Firefox suele dar la URL https de origen, asi que
        # hay que bajarla; con tope de tiempo, que una notificacion no
        # puede quedarse esperando a la red.
        imagen=()
        case "$arte" in
            file://*)
                origen="${arte#file://}"
                [[ -r "$origen" ]] && cp -f -- "$origen" "$PORTADA" \
                    && imagen=(-i "$PORTADA")
                ;;
            http://*|https://*)
                curl -sfL --max-time 3 -o "$PORTADA" -- "$arte" \
                    && imagen=(-i "$PORTADA")
                ;;
        esac

        # Sin caratula se cae al icono de tema por defecto en vez de
        # quedarse sin nada.
        [[ ${#imagen[@]} -eq 0 ]] && imagen=(-i multimedia-player)

        dunstify -a "mpris-notify" -u low -t 6000 -r "$ID" \
            "${imagen[@]}" -- "$titulo" "$artista"
    done

    # Si el navegador se cierra, playerctl --follow termina. Se espera y
    # se vuelve a enganchar en vez de morir para el resto de la sesion.
    exec 3<&-
    limpiar
    sleep 5
done
