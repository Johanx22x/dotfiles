#!/usr/bin/env bash
# mpris-notify - dunst notification when the browser changes track
#
# Started by hyprland.lua in autostart, next to the other watchers
# (wl-paste, cliphist). No systemd unit on purpose: the pattern here is the
# hl.exec_cmd entries of autostart, and this is exactly that.
#
# To test it by hand, without restarting the session:
#   pkill -f 'playerctl.*--follow'; mpris-notify &

set -uo pipefail

# One instance only. Two live watchers = two notifications per track, and it
# is easy to end up there: launch it by hand to test and forget autostart
# already had one running. File descriptor 9 stays open for the life of the
# process, so the lock releases on its own when it dies, even abruptly.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/mpris-notify.lock"
flock -n 9 || exit 0

# Browsers only. mpv and Celluloid speak MPRIS too, and a notification for
# every film you open is not what was asked for. playerctl matches by
# prefix, so "brave" catches brave.instance3689 and whatever else.
JUGADORES="${MPRIS_NOTIFY_PLAYERS:-brave,firefox,chromium}"

# The cover art is copied here before notifying. Chromium deletes its
# temporary file as soon as the track changes, and dunst reads the image an
# instant after receiving the notification: without the copy, the race is
# lost every now and then and the notification comes up with no image.
PORTADA="${XDG_RUNTIME_DIR:-/tmp}/mpris-notify-cover"

# Fixed id -> each track REPLACES the previous notification instead of
# stacking. Playing five songs in a row does not leave five popups.
ID=2593

# Seconds of slack for the browser to publish the real cover art (see the
# long note in the loop). If the browser icon still shows up sometimes,
# raise this before touching anything else.
ESPERA_CARATULA="${MPRIS_NOTIFY_DELAY:-1.5}"

# Separator used to split playerctl's line. A control character (unit
# separator) is used rather than ":" or "|" because YouTube titles contain
# absolutely anything.
SEP=$'\x1f'

# On exit the playerctl has to go too. With a plain pipe it did not: you
# killed the script and the watcher stayed alive, orphaned, until you logged
# out -- and every test left another one. Hence process substitution, which
# does give its PID in $!.
limpiar() { [[ -n "${VIGILANTE:-}" ]] && kill "$VIGILANTE" 2>/dev/null; }

# Two traps and not one: in bash, an INT/TERM handler that does not call
# exit leaves the script RUNNING after handling it. With a single
# "trap cleanup EXIT INT TERM", a kill took the playerctl down and the
# script stayed alive, reattaching five seconds later.
trap limpiar EXIT
trap 'limpiar; exit 0' INT TERM

while :; do
    # "metadata" is not optional: --format is a modifier of the command, not
    # of playerctl. Without it, playerctl prints its usage to stderr and
    # exits, which with the 2>/dev/null next to it is a silent failure.
    exec 3< <(playerctl --player "$JUGADORES" --follow metadata \
        --format "{{title}}${SEP}{{artist}}${SEP}{{mpris:artUrl}}" 2>/dev/null)
    VIGILANTE=$!

    while IFS="$SEP" read -r titulo artista arte <&3; do
        # When playback stops, playerctl emits an empty line.
        [[ -z "${titulo// /}" ]] && continue

        # YouTube Music publishes the artist as "Someone - Topic": those are
        # the channels it auto-generates for music. The suffix adds nothing
        # to a notification.
        artista="${artista% - Topic}"

        # The same track with tweaked metadata (YouTube likes rewriting
        # artUrl mid-song) does not notify again.
        actual="${titulo}${SEP}${artista}"
        [[ "${anterior:-}" == "$actual" ]] && continue
        anterior="$actual"

        # -- Wait for the real cover art --
        # When a track starts, Brave publishes the title and artist first and
        # leaves mpris:artUrl pointing at a placeholder: the page icon. Notify
        # at that instant and you get the Brave logo instead of the album
        # cover.
        #
        # So it waits a beat and asks again. The notification arrives a second
        # later, which in a track-change alert nobody notices.
        sleep "$ESPERA_CARATULA"

        titulo_ahora=$(playerctl --player "$JUGADORES" metadata title 2>/dev/null)
        if [[ -n "$titulo_ahora" && "$titulo_ahora" != "$titulo" ]]; then
            # Track changed during the wait (you skipped). This one is not
            # notified: the new track's line is already queued and that one
            # will carry its cover.
            #
            # The condition asks for a NON-EMPTY title on purpose. During the
            # transition the browser can return an empty title for an
            # instant; if that counted as "track changed" the notification
            # would be skipped, and since "previous" was already recorded,
            # that song would never announce itself again.
            continue
        fi

        # If the query fails or comes back empty we keep the artUrl the line
        # carried: a placeholder cover beats no cover.
        arte_fresco=$(playerctl --player "$JUGADORES" metadata mpris:artUrl 2>/dev/null)
        [[ -n "$arte_fresco" ]] && arte="$arte_fresco"

        # -- Cover art --
        # Chromium-based browsers give a local file:// already downloaded.
        # Firefox usually gives the origin https URL, so it has to be
        # fetched; with a timeout, because a notification cannot sit waiting
        # on the network.
        imagen=()
        case "$arte" in
            file://*)
                origen="${arte#file://}"
                [[ -r "$origen" ]] && cp -f -- "$origen" "$PORTADA" \
                    && imagen=(-i "$PORTADA")
                ;;
            http://*|https://*)
                curl -sfL --max-time 3 -o "$PORTADA" -- "$arte" \
                    && imagen=(-i "$PORTADA")
                ;;
        esac

        # With no cover it falls back to a default theme icon instead of
        # showing nothing.
        [[ ${#imagen[@]} -eq 0 ]] && imagen=(-i multimedia-player)

        dunstify -a "mpris-notify" -u low -t 6000 -r "$ID" \
            "${imagen[@]}" -- "$titulo" "$artista"
    done

    # If the browser closes, playerctl --follow ends. It waits and reattaches
    # instead of dying for the rest of the session.
    exec 3<&-
    limpiar
    sleep 5
done
