#!/usr/bin/env bash
# night-light -- the blue light filter, on or off and how warm.
#
# A thin wrapper over whichever daemon owns the colour on this session. There
# are two, one per compositor flavor (see BACKENDS below), and neither of them
# has the one thing this script adds: somewhere to remember what was asked for.
#
# WHY THE STATE FILE IS NOT OPTIONAL. `hyprctl hyprsunset temperature` looks
# like it answers "is the filter on", and it does not. Measured: set 4000,
# then `identity` to turn the filter off, and it still reads back 4000. The
# temperature it reports is the last one it was told, not the one on screen.
# So a settings window trusting that reading would draw the switch as on with
# the screen plainly untinted. The file below is the truth; the daemon is told
# what it says.
#
# The other daemon tells the same lie in D-Bus. wl-gammarelay-rs's Temperature
# property is the value it was last handed and not a reading of the output --
# see the long note over gammarelay_temperature, which is where that costs
# something rather than merely being untidy.
#
# That is also what keeps the two backends interchangeable: the shell's
# NightLight.qml reads this file and calls `night-light on|off|temp N`, and it
# has no idea which compositor is running or which daemon answered. Everything
# flavor-specific stops at apply().
#
# TWO LINES, enabled then temperature, in the same shape desktop-font uses --
# readable by hand, parsed with `read`, no JSON in a shell script.
#
# The temperature is remembered even while the filter is off, so turning it
# back on returns to the warmth that was chosen rather than to a default.

set -euo pipefail

# FOUND NEXT TO THIS SCRIPT AND NOT THROUGH $PATH -- see the note further down
# about why the `compositor` this brings in has to be found this way, and what
# happens silently when it is not. `wait_until` and `state_write` come from the
# same place.
BIN_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/desktop-lib.sh
. "$BIN_DIR/../lib/desktop-lib.sh"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/night-light"

# 2500K is candlelight and 6000K is roughly daylight, which is where
# hyprsunset sits with no filter at all. Below 2500 the screen goes orange
# enough that reds stop being distinguishable; above 6000 there is nothing to
# see, so the top of the range IS the off switch and does not need to be
# offered twice.
MIN_TEMP=2500
MAX_TEMP=6000
DEFAULT_TEMP=4000

# "No filter" for wl-gammarelay-rs, and deliberately OUTSIDE the range above:
# it is never written to the state file and never offered as a choice, it is
# only what the daemon is told while the filter is off. See apply_gammarelay()
# for why this exact number and not 6000.
NEUTRAL_TEMP=6500

# The daemon's well-known bus name and interface. Note they are spelled
# differently on purpose -- a hyphen in the name, a dot in the interface -- and
# swapping them gets "Unknown interface" rather than anything readable.
GAMMARELAY_BUS=rs.wl-gammarelay
GAMMARELAY_IFACE=rs.wl.gammarelay

usage() {
    cat >&2 <<'EOF'
Usage:
  night-light on               turn the filter on
  night-light off              turn it off
  night-light toggle           flip it
  night-light temp <2500-6000> set the temperature in kelvin
  night-light apply            re-apply what is saved (login, compositor restart)
  night-light show             print the saved state
EOF
    exit 2
}

read_state() {
    enabled=0
    temperature=$DEFAULT_TEMP

    [[ -r $STATE_FILE ]] || return 0

    { read -r saved_enabled || true; read -r saved_temperature || true; } < "$STATE_FILE"

    [[ ${saved_enabled:-} == 1 ]] && enabled=1

    # Validated rather than trusted, like every other reader in this
    # repository: a mangled file falls back to the default instead of handing
    # hyprsunset something it will refuse, which would leave the screen tinted
    # with no way back from the settings window.
    if [[ ${saved_temperature:-} =~ ^[0-9]+$ ]] \
        && (( saved_temperature >= MIN_TEMP && saved_temperature <= MAX_TEMP )); then
        temperature=$saved_temperature
    fi
}

# THROUGH state_write AND NOT `>`, for both halves of what that buys. This is a
# read-modify-write -- every command here calls read_state first and then writes
# back the field it did not change -- so `night-light on` and `night-light temp`
# arriving together used to lose one of the two. And the file is replaced rather
# than emptied and refilled, so the settings window, which reads it back, can no
# longer catch it holding nothing.
write_state() {
    printf '%s\n%s\n' "$enabled" "$temperature" | state_write "$STATE_FILE"
}

# =============================================================================
# BACKENDS
# =============================================================================
# Tinting the screen is not something a compositor lends out in a portable way,
# so each flavor is served by a different daemon and this script picks one:
#
#   Hyprland -> hyprsunset, over hyprland-ctm-control-v1. That protocol has
#               exactly one implementation, Hyprland's own. Started anywhere
#               else hyprsunset comes up, accepts every command and tints
#               nothing -- SILENTLY, which is the dangerous part and the whole
#               reason `compositor can gamma` exists.
#   niri     -> wl-gammarelay-rs, a D-Bus daemon driving
#               wlr-gamma-control-unstable-v1 (verified in its source:
#               src/wayland.rs uses ZwlrGammaControlManagerV1), which niri does
#               implement. Chosen over wlsunset because it is the only one of
#               the two that maps 1:1 onto a temperature slider -- wlsunset
#               0.4.0 cannot be handed a temperature while running at all: it
#               walks three fixed states on SIGUSR1 and refuses `-T X -t X`
#               outright.
#
# NEVER BOTH AT ONCE. Hyprland implements wlr-gamma-control too, so
# wl-gammarelay-rs would "work" there as well, and both flavors can be stowed
# on the same machine -- which makes this a real thing to trip over rather than
# a theoretical one. Two daemons each holding gamma control of the same outputs
# means whichever uploaded a ramp last wins, and the loser's state file keeps
# claiming otherwise. The dispatch below is what prevents it: exactly one
# backend is ever reachable per session. If a session ever needs both installed,
# only hyprsunset gets a systemd unit bound to graphical-session.target --
# wl-gammarelay-rs is started on demand from here and only under niri.
#
# ADDING A THIRD FLAVOR: one branch in backend(), one apply_* function.

# FOUND NEXT TO THIS SCRIPT AND NOT THROUGH $PATH. ~/.local/bin is on the PATH
# of a login shell and of very little else: the settings window in Quickshell
# inherits the compositor's environment, install.sh calls these scripts by
# absolute path with whatever PATH it was started with, and a systemd --user
# unit gets neither. That is why the library sourced at the top of this file is
# resolved through readlink rather than looked up, and why `compositor` comes
# out of it instead of off the PATH.

# THE FAILURE HERE IS THE SILENT ONE, which is why resolving it matters even
# though nothing in this file dies without it. Both calls below sit inside an
# `if` with stderr thrown away, so a `compositor` that cannot be run is
# indistinguishable from a compositor that cannot tint: backend() answers
# `none`, `show` prints "daemon: none for this compositor", and `apply` -- which
# is what runs at login and after a compositor restart -- says there is no gamma
# backend for a session that has one. Verified before the shim: `env
# PATH=/usr/bin:/bin night-light show` reported backend none in a live niri
# session. It is the same silence the BACKENDS note above warns about for
# hyprsunset started on the wrong compositor.

# `can gamma` and not `is hyprland`, because the question this script is really
# asking is whether the compositor's OWN filter works here -- that is what the
# capability means and hyprsunset is that filter.
#
# niri is then matched by name rather than by a capability, and that is on
# purpose: wlr-gamma-control is a generic protocol that other compositors speak
# too, but `compositor` only carries capabilities some script here actually
# branches on. The day a third flavor needs this branch, that is when it earns a
# capability of its own instead of a second name in this case.
backend() {
    if compositor can gamma 2>/dev/null; then
        echo hyprsunset
    elif compositor is niri 2>/dev/null; then
        echo gammarelay
    else
        echo none
    fi
}

# ---- hyprsunset (Hyprland) --------------------------------------------------

# hyprsunset has to be running before anything can be sent to it. The systemd
# user unit ships with the package and is bound to graphical-session.target,
# so this is normally a no-op -- it is here for the session where the unit was
# never enabled, and for the moment right after installing it.
#
# NOT started with a bare `hyprsunset &`: a daemon spawned from whatever shell
# happens to call this dies with it, and the filter would come off at a moment
# unrelated to anything the user did.
ensure_hyprsunset() {
    pgrep -x hyprsunset >/dev/null && return 0

    systemctl --user start hyprsunset.service 2>/dev/null || return 1

    # The socket appears a moment after the process does, and a command sent
    # before it exists is simply lost.
    wait_until 10 0.1 pgrep -x hyprsunset >/dev/null
}

apply_hyprsunset() {
    if ! ensure_hyprsunset; then
        echo "night-light: hyprsunset is not running and could not be started." >&2
        echo "  Install it with 'sudo pacman -S hyprsunset', then" >&2
        echo "  'systemctl --user enable --now hyprsunset.service'." >&2
        return 1
    fi

    if (( enabled )); then
        hyprctl hyprsunset temperature "$temperature" >/dev/null
    else
        # identity, not temperature 6000. They look the same on screen and
        # they are not the same thing: identity removes the colour matrix
        # altogether, which is what "off" should mean for something sitting
        # between every application and the display.
        hyprctl hyprsunset identity >/dev/null
    fi
}

# ---- wl-gammarelay-rs (niri) ------------------------------------------------

# WHY THIS IS A D-BUS QUESTION AND NOT A pgrep ONE. Two separate reasons, and
# the first one is a trap rather than a preference:
#
#   - `pgrep -x wl-gammarelay-rs` can NEVER match. The name is 16 characters
#     and the kernel caps comm at 15, so pgrep refuses the pattern outright --
#     measured: "pattern that searches for process name longer than 15
#     characters will result in zero matches", exit 1. Matching the truncated
#     `wl-gammarelay-r` does work, and is exactly the kind of line nobody
#     recognises as load-bearing six months later.
#   - The process existing is not what has to be true anyway. A busctl call
#     needs somebody to OWN the well-known name, which happens a moment after
#     exec() -- the same gap the hyprsunset poll above exists for.
#
# NameHasOwner answers precisely that. CAREFUL WITH ITS EXIT STATUS: busctl
# prints "b true" or "b false" and exits 0 for BOTH (measured), so the output is
# what gets tested and never the status.
gammarelay_running() {
    local answer
    answer="$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
                  org.freedesktop.DBus NameHasOwner s "$GAMMARELAY_BUS" 2>/dev/null)" || return 1
    [[ $answer == "b true" ]]
}

ensure_gammarelay() {
    gammarelay_running && return 0

    command -v wl-gammarelay-rs >/dev/null || return 1

    # systemd-run rather than `wl-gammarelay-rs run &`, for the same reason the
    # hyprsunset branch goes through systemctl: a daemon spawned from whatever
    # shell called this dies with it, and the filter would come off at a moment
    # unrelated to anything the user did.
    #
    # A TRANSIENT unit and not a shipped one because the package has no unit of
    # its own, and because a unit bound to graphical-session.target would start
    # the daemon under Hyprland too -- which is exactly the collision the note
    # at the top of this section is about. Started from here it can only ever
    # run in a session that reached the niri branch.
    #
    # --collect so a failed run does not linger in "failed" state, which would
    # make the NEXT start fail with "unit already exists". The error is
    # swallowed on purpose: a second caller racing this one gets that same
    # message and is not a failure, so the poll below is the real answer.
    systemd-run --user --quiet --collect \
        --unit=wl-gammarelay-rs \
        --description="Wayland gamma relay (night-light backend)" \
        wl-gammarelay-rs run >/dev/null 2>&1 || true

    wait_until 10 0.1 gammarelay_running
}

# WHY THE TEMPERATURE IS WRITTEN TWICE, and why nothing in this file may be
# built on reading it back. Both halves come out of wl-gammarelay-rs 1.0.1's
# own source, and both were measured on this machine.
#
#   - THE SET IS GUARDED. `set_temperature_root_cb` in its dbus_server.rs is
#     wrapped in `if ctx.state.color().temp != val`, and `Output::set_color` in
#     its wayland.rs in `if color != self.color`. Handing the daemon the
#     temperature it already holds is therefore not a cheap re-apply, it is
#     NOTHING AT ALL: no ramp uploaded, no property signal, no screen.
#   - THE PROPERTY IS A WRITE CACHE, not a reading. `get_temperature_root_cb`
#     hands back that same in-memory field, and wlr-gamma-control has no request
#     that asks what is on the output, so no reading of the truth exists
#     anywhere to compare it against. Measured: with the daemon reporting 4100
#     the CRTC's GAMMA_LUT held the 4100 ramp, and an hour earlier, with the
#     daemon reporting the same 4100, the screen carried no filter at all. One
#     number, two opposite realities.
#
# Together those mean a filter the compositor drops underneath the daemon --
# and it can, the ramp lives on the CRTC and is reset by paths the daemon is
# never told about -- CANNOT be repaired by asserting the saved temperature,
# because that assertion is the no-op above. Turning the filter off and then on
# is what worked by hand, and it worked because it is two CHANGES rather than
# one.
#
# So the ramp is forced rather than asked for: one step off the target, then the
# target. Whatever the daemon believed on the way in, it believes target+1 after
# the first call, so the second is always a real change and the ramp that lands
# is always the target's.
#
# +1 K AND NOT THE NEUTRAL POINT. The intermediate value is on screen for one
# round trip, and one kelvin cannot be seen, where a bounce through 6500 is a
# visible flash to no filter at all. The daemon clamps to 1000..10000, so
# target+1 is in range above both the top of the slider (6000) and neutral
# (6500).
gammarelay_temperature() {
    busctl --user set-property "$GAMMARELAY_BUS" / "$GAMMARELAY_IFACE" \
        Temperature q "$1" >/dev/null
}

apply_gammarelay() {
    # Off with nothing running is already off. Starting a daemon just to tell it
    # to do nothing would hand it gamma control of every output for no reason,
    # and this is not a corner case: it is every single login where the filter
    # is off, through the `apply` the shell runs as it starts.
    if (( ! enabled )) && ! gammarelay_running; then
        return 0
    fi

    if ! ensure_gammarelay; then
        echo "night-light: wl-gammarelay-rs is not running and could not be started." >&2
        echo "  Install it from the AUR ('yay -S wl-gammarelay-rs'). It needs no" >&2
        echo "  unit of its own -- this script starts it with systemd-run." >&2
        return 1
    fi

    local target=$NEUTRAL_TEMP
    (( enabled )) && target=$temperature

    # 6500 K IS THE "identity" OF THE OTHER BRANCH, not an approximation of it,
    # and that is why off does not stop the daemon here.
    #
    # wl-gammarelay-rs has no identity call: the only way to hand the ramps back
    # to the compositor is to kill the process, which buys a restart and its
    # race on every toggle and flashes the screen while it happens. 6500 costs
    # neither, because in this daemon it is not merely the default -- it is the
    # entry in its blackbody table that reads exactly 1.0, 1.0, 1.0 (verified in
    # src/color.rs), so with gamma and brightness left at 1.0 the ramp it
    # uploads is the identity ramp bar integer rounding. Off looks off.
    #
    # NOT 6000: that is MAX_TEMP, the top of the slider, and its table entry is
    # 0.919, 1.0, 0.965 -- visibly warm. The two numbers answer different
    # questions and must not be merged.
    gammarelay_temperature $(( target + 1 ))
    gammarelay_temperature "$target"
}

# ---- no backend -------------------------------------------------------------

apply_none() {
    # The state file was written before this ran and stays written, so nothing
    # is lost: a later `night-light apply` under a session that does have a
    # backend picks up exactly what was asked for here.
    echo "night-light: no gamma backend for this session." >&2
    echo "  Hyprland uses hyprsunset and niri uses wl-gammarelay-rs; the" >&2
    echo "  compositor answering now ($(compositor 2>/dev/null || echo unknown)) is neither." >&2
    return 1
}

apply() {
    case "$(backend)" in
        hyprsunset) apply_hyprsunset ;;
        gammarelay) apply_gammarelay ;;
        *)          apply_none ;;
    esac
}

read_state

case "${1:-show}" in
    on)     enabled=1; write_state; apply ;;
    off)    enabled=0; write_state; apply ;;
    toggle) enabled=$(( 1 - enabled )); write_state; apply ;;

    temp)
        [[ $# -eq 2 ]] || usage
        [[ $2 =~ ^[0-9]+$ ]] || usage
        (( $2 >= MIN_TEMP && $2 <= MAX_TEMP )) || {
            echo "night-light: temperature must be between $MIN_TEMP and $MAX_TEMP." >&2
            exit 2
        }
        temperature=$2
        write_state
        # Only reaches the screen when the filter is on. Choosing a warmth
        # with the filter off is setting what it will be, not turning it on by
        # the side door.
        #
        # AN `if` AND NOT `(( enabled )) && apply`. This is the last statement
        # of the branch, so its status is the script's, and the && form hands
        # back the failed test: `night-light temp 4000` with the filter off
        # exited 1 after doing exactly what was asked. The settings window fires
        # this on every drag of the warmth slider.
        if (( enabled )); then
            apply
        fi
        ;;

    apply)  apply ;;

    show)
        echo "enabled:     $enabled"
        echo "temperature: ${temperature}K"

        # The daemon is named as well as its state, because "not running" means
        # two very different things depending on which one it is -- and because
        # a backend reading `none` is the first thing to look at when the switch
        # does everything except tint the screen.
        current_backend="$(backend)"
        echo "backend:     $current_backend"
        case "$current_backend" in
            hyprsunset)
                pgrep -x hyprsunset >/dev/null \
                    && echo "daemon:      hyprsunset, running" \
                    || echo "daemon:      hyprsunset, not running"
                ;;
            gammarelay)
                # AND THEN THE WARNING, because everything above this line can
                # agree and the screen still carry no filter: the daemon's
                # Temperature property is the last value it was handed, not a
                # reading of the output, and there is no reading of the output
                # to be had. See the note over gammarelay_temperature. An hour
                # went into "all four checks say 4100 and the screen is white"
                # before that was understood, so the answer ships with the
                # question.
                if gammarelay_running; then
                    echo "daemon:      wl-gammarelay-rs, running"
                    echo "note:        neither the daemon nor this script can"
                    echo "             see what is on the screen. If the filter"
                    echo "             is missing while the lines above look"
                    echo "             right, run 'night-light apply'."
                else
                    echo "daemon:      wl-gammarelay-rs, not running"
                fi
                ;;
            *)
                echo "daemon:      none for this compositor"
                ;;
        esac
        ;;

    *) usage ;;
esac
