#!/usr/bin/env python3
"""Media module for waybar, replacing the native "mpris" module.

WHY THIS SCRIPT AND NOT THE NATIVE MODULE
-----------------------------------------
The "mpris" module in waybar 0.15.0 corrupts memory and takes the whole bar down
when Brave (or any Chromium) starts playing. The coredump shows it
unambiguously: Brave emits PropertiesChanged, libplayerctl
reenvia, y el handler de waybar termina llamando a un Glib::Dispatcher cuyo
internal pointer is already overwritten with ASCII garbage:

    Glib::DispatchNotifier::send_notification (this=0x3fe0303030303030)
      <- playerctl_player_properties_changed_callback (playerctl-player.c:187)

Since libplayerctl runs INSIDE the waybar process, that crash takes the
entire bar with it (clock, tray, workspaces, everything). Here playerctl runs as a
separate process: if it crashes, waybar only loses this module and relaunches
it per
"restart-interval". El bug de arriba deja de poder matar la barra.

Output: one JSON line per change, streamed and read by waybar.
Palette: Tokyo Night, same as waybar-system.
"""

import json
import subprocess
import sys

# ---- Tokyo Night ----
C_ARTISTA = "#565f89"   # comment -- secundario en el tooltip
C_TXT = "#c0caf5"       # fg
C_DIM = "#a9b1d6"       # fg_dark

# Maximum text length on the bar (equivalent to the native module's "dynamic-len")
MAX_LEN = 40

# Separator between title and artist on the bar
SEP = "  ·  "

# Per-player icons. The key is compared against {{playerName}}, which
# playerctl already delivers without the instance suffix
# (brave.instance3631 -> brave).
ICONS = {
    "brave": "󰊯",
    "chromium": "󰊯",
    "chrome": "󰊯",
    "firefox": "󰈹",
    "spotify": "",
    "vlc": "󰕼",
    "mpv": "",
}
ICONO_DEFECTO = "󰝚"
PAUSE_ICON = "󰏤"


def escape(text):
    """Escape what Pango would interpret as markup.

    Titles come from arbitrary web pages: a single unescaped '&' leaves the
    module blank. Same criterion as in waybar-system.
    """
    return (text.replace("&", "&amp;")
                 .replace("<", "&lt;")
                 .replace(">", "&gt;"))


def recortar(text, limite):
    if len(text) <= limite:
        return text
    return text[:max(1, limite - 1)].rstrip() + "…"


def bar_text(title, artist):
    """Titulo y artist recortados a MAX_LEN.

    Reproduces the "dynamic-order" behaviour: if both do not fit, the artist
    is sacrificed before the title.
    """
    if not title and not artist:
        return ""
    if not title:
        return recortar(artist, MAX_LEN)
    if artist and len(title) + len(SEP) + len(artist) <= MAX_LEN:
        return title + SEP + artist
    return recortar(title, MAX_LEN)


def emit(payload):
    print(json.dumps(payload, ensure_ascii=False), flush=True)


def empty():
    """No player: empty text makes waybar hide the module."""
    emit({"text": "", "tooltip": "", "class": "stopped"})


def procesar(linea):
    campos = linea.split("\x1f")
    if len(campos) != 5 or not linea.strip("\x1f").strip():
        empty()
        return

    player, estado, title, artist, album = (c.strip() for c in campos)

    # YouTube Music publishes the artist as "Someone - Topic": those are the
    # channels YouTube auto-generates for music. On a bar where space is
    # counted in characters (MAX_LEN), eight of them saying nothing is exactly
    # what makes the real name get truncated.
    # Stripped here, before bar_text() and the tooltip, so both come out the
    # same. ~/.local/bin/mpris-notify does the same for notifications.
    if artist.endswith(" - Topic"):
        artist = artist[: -len(" - Topic")]

    if estado not in ("Playing", "Paused"):
        empty()
        return

    body = bar_text(title, artist)
    if not body:
        empty()
        return

    icon = ICONS.get(player.lower(), ICONO_DEFECTO)
    body = escape(body)

    if estado == "Paused":
        text = f"{PAUSE_ICON} <i>{body}</i>"
        clase = "paused"
    else:
        text = f"{icon} {body}"
        clase = "playing"

    lineas = [f"<span color='{C_TXT}'><b>{escape(title)}</b></span>"]
    if artist:
        lineas.append(f"<span color='{C_DIM}'>{escape(artist)}</span>")
    if album:
        lineas.append(f"<span color='{C_ARTISTA}'>{escape(album)}</span>")
    lineas.append(f"<span color='{C_ARTISTA}'>{escape(player)}</span>")

    emit({"text": text, "tooltip": "\n".join(lineas), "class": clase})


def main():
    # \x1f (unit separator) as the delimiter: it does not appear in real
    # titles, so there is no guessing where a field ends.
    cmd = [
        "playerctl", "--follow", "--format",
        "{{playerName}}\x1f{{status}}\x1f{{title}}\x1f{{artist}}\x1f{{album}}",
        "metadata",
    ]

    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                text=True, bufsize=1)
    except OSError as e:
        emit({"text": "󰋔", "tooltip": f"playerctl no disponible: {e}",
                "class": "critical"})
        # Without exiting with an error: waybar retries per restart-interval
        return

    # Initial state: if playerctl is slow to emit, the module starts hidden
    # instead of keeping the text from the previous run.
    empty()

    try:
        for linea in proc.stdout:
            procesar(linea.rstrip("\n"))
    except Exception:
        pass
    finally:
        proc.terminate()

    # playerctl ended (no players, or it died): clear the module and exit so
    # waybar relaunches the script.
    empty()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    except Exception as e:  # never leave the module stuck with stale text
        emit({"text": "󰋔", "tooltip": str(e), "class": "critical"})
        sys.exit(0)
