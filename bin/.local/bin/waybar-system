#!/usr/bin/env python3
"""Unified waybar module: CPU + RAM + GPU in a single pill.

Prints JSON with Pango markup, so each segment carries its own colour
inside the same module.

The three segment colours are generated by matugen from the wallpaper
(~/.config/waybar/colors.json); the Tokyo Night ones below are the fallback.
The text greys and the alert colours are fixed.

CPU usage: computed as the difference against the previous reading of
/proc/stat, kept in a cache. That way the process does not have to sleep to
take two samples, and waybar does not block on every refresh.
"""

import json
import os
import re
import subprocess
import sys
import time

# ---- Accents (overridden by the wallpaper, see load_palette) ----
# Fallback values: Tokyo Night, the tones matugen starts from.
C_CPU = "#bb9af7"   # magenta
C_RAM = "#9ece6a"   # green
C_GPU = "#7aa2f7"   # blue

# ---- Fixed ----
C_SEP = "#565f89"   # comment -- fg_gutter (#3b4261) queda invisible
                    # against the module group background
# Alerts: they deliberately do NOT follow the wallpaper. Amber and red always
# mean the same thing, and if the wallpaper were red the "critical" one would
# get lost among the other segments.
C_WARN = "#e0af68"  # yellow
C_CRIT = "#f7768e"  # red
C_TXT = "#c0caf5"   # fg
# Secondary tooltip text. fg_dark is used rather than comment (#565f89):
# over the tooltip background the latter is too dark to read.
C_DIM = "#a9b1d6"   # fg_dark
# Only for the "GPU unavailable" dash on the bar, where going unnoticed is
# actually what you want.
C_MUTED = "#565f89"  # comment

CACHE = os.path.expanduser("~/.cache/waybar-system-cpu")
PALETTE = os.path.expanduser("~/.config/waybar/colors.json")
HIGH_THRESHOLD = 85    # % above which the segment is painted as an alert

_HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


def load_palette():
    """Override C_CPU/C_RAM/C_GPU with the current wallpaper palette.

    La escribe matugen (plantilla waybar-colors.json). Cualquier fallo
    -- it may not exist yet, or it may be read exactly while matugen is
    rewriting it -- the Tokyo Night values are kept: the module is never
    left colourless.
    """
    global C_CPU, C_RAM, C_GPU
    try:
        with open(PALETTE) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return

    def leer(clave, respaldo):
        valor = data.get(clave)
        # The hex is validated because it goes straight into a Pango markup
        # attribute: an invalid one leaves the whole module blank.
        if isinstance(valor, str) and _HEX.match(valor):
            return valor
        return respaldo

    C_CPU = leer("cpu", C_CPU)
    C_RAM = leer("ram", C_RAM)
    C_GPU = leer("gpu", C_GPU)


def read_cpu_totals():
    """Return (total, idle) accumulated since boot."""
    with open("/proc/stat") as f:
        campos = [int(v) for v in f.readline().split()[1:]]
    ocioso = campos[3] + campos[4]          # idle + iowait
    return sum(campos), ocioso


def uso_cpu():
    """CPU % since the previous reading. With no cache, samples for 0.15s."""
    total, ocioso = read_cpu_totals()

    previo = None
    try:
        with open(CACHE) as f:
            p_total, p_ocioso, p_ts = (float(v) for v in f.read().split())
        # Stale cache (waybar restarted, suspend): not usable
        if time.time() - p_ts < 60:
            previo = (p_total, p_ocioso)
    except (OSError, ValueError):
        pass

    if previo is None:
        time.sleep(0.15)
        p_total, p_ocioso = total, ocioso
        total, ocioso = read_cpu_totals()
    else:
        p_total, p_ocioso = previo

    try:
        with open(CACHE, "w") as f:
            f.write(f"{total} {ocioso} {time.time()}")
    except OSError:
        pass

    d_total = total - p_total
    d_ocioso = ocioso - p_ocioso
    if d_total <= 0:
        return 0.0
    return max(0.0, min(100.0, 100.0 * (d_total - d_ocioso) / d_total))


def info_cpu():
    """Modelo abreviado y numero de hilos."""
    modelo, hilos = "CPU", 0
    try:
        with open("/proc/cpuinfo") as f:
            for linea in f:
                if linea.startswith("model name") and modelo == "CPU":
                    modelo = linea.split(":", 1)[1].strip()
                elif linea.startswith("processor"):
                    hilos += 1
    except OSError:
        pass

    # "13th Gen Intel(R) Core(TM) i5-13600K" -> "Intel Core i5-13600K"
    for basura in ("(R)", "(TM)", "(tm)", "CPU"):
        modelo = modelo.replace(basura, "")
    modelo = re.sub(r"\d+th Gen\s*", "", modelo)
    modelo = re.sub(r"\s+@.*$", "", modelo)
    return re.sub(r"\s{2,}", " ", modelo).strip(), hilos


def freq_cpu():
    """(current average GHz, maximum GHz). None if there is no cpufreq."""
    base = "/sys/devices/system/cpu"
    try:
        actuales = []
        for entrada in os.listdir(base):
            ruta = f"{base}/{entrada}/cpufreq/scaling_cur_freq"
            if entrada.startswith("cpu") and entrada[3:].isdigit():
                try:
                    with open(ruta) as f:
                        actuales.append(int(f.read()))
                except OSError:
                    pass
        if not actuales:
            return None
        with open(f"{base}/cpu0/cpufreq/scaling_max_freq") as f:
            maxima = int(f.read())
        # The values come in kHz
        return sum(actuales) / len(actuales) / 1e6, maxima / 1e6
    except OSError:
        return None


def temp_cpu():
    """Package temperature in °C, or None."""
    import glob
    for ruta in glob.glob("/sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input"):
        try:
            with open(ruta) as f:
                return int(f.read()) / 1000
        except OSError:
            continue
    return None


def uso_ram():
    """Devuelve (porcentaje, usados_gib, totales_gib)."""
    data = {}
    with open("/proc/meminfo") as f:
        for linea in f:
            clave, _, resto = linea.partition(":")
            data[clave] = int(resto.split()[0])  # kB

    total = data["MemTotal"]
    disponible = data.get("MemAvailable", data["MemFree"])
    usada = total - disponible
    return 100.0 * usada / total, usada / 1048576, total / 1048576


def datos_gpu():
    """Query nvidia-smi. Returns None if it is unavailable."""
    try:
        salida = subprocess.run(
            ["nvidia-smi",
             "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=2.5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None

    if salida.returncode != 0 or not salida.stdout.strip():
        return None

    try:
        nombre, uso, vram_u, vram_t, temp = (
            c.strip() for c in salida.stdout.strip().split("\n")[0].split(",")
        )
        return {
            "nombre": nombre,
            "uso": float(uso),
            "vram_usada": float(vram_u) / 1024,   # GiB
            "vram_total": float(vram_t) / 1024,
            "temp": float(temp),
        }
    except (ValueError, IndexError):
        return None


def color_by_load(valor, base):
    """The base colour unless the value is high."""
    if valor >= 95:
        return C_CRIT
    if valor >= HIGH_THRESHOLD:
        return C_WARN
    return base


def escape(texto):
    """Escape what Pango would interpret as markup.

    The model name comes from the kernel and could contain '&' or '<'.
    Without this, a single such character leaves the tooltip blank.
    """
    return (texto.replace("&", "&amp;")
                 .replace("<", "&lt;")
                 .replace(">", "&gt;"))


def seg(icono, texto, color):
    return f"<span color='{color}'>{icono}  {texto}</span>"


def main():
    load_palette()

    cpu = uso_cpu()
    ram_pct, ram_usada, ram_total = uso_ram()
    gpu = datos_gpu()

    separador = f"<span color='{C_SEP}'> │ </span>"

    partes = [
        seg("󰻠", f"{cpu:.0f}%", color_by_load(cpu, C_CPU)),
        seg("󰍛", f"{ram_pct:.0f}%", color_by_load(ram_pct, C_RAM)),
    ]
    if gpu:
        partes.append(seg("󰢮", f"{gpu['uso']:.0f}%",
                          color_by_load(gpu["uso"], C_GPU)))
    else:
        # With no readable GPU it is greyed out rather than disappearing, so
        # the module width does not jump around.
        partes.append(seg("󰢮", "—", C_MUTED))

    # ---- Tooltip ----
    modelo, hilos = info_cpu()
    freq = freq_cpu()
    temp = temp_cpu()

    def dato(label, valor):
        return (f"<span color='{C_DIM}'>{label}  </span>"
                f"<span color='{C_TXT}'>{valor}</span>")

    lineas = [
        f"<span color='{C_CPU}'><b>󰻠  CPU</b></span>   "
        f"<span color='{C_TXT}'><b>{cpu:.1f}%</b></span>",
        f"<span color='{C_DIM}'>{escape(modelo)}  ·  {hilos} threads</span>",
    ]

    detalle = []
    if freq:
        detalle.append(dato("clock", f"{freq[0]:.2f} / {freq[1]:.2f} GHz"))
    if temp is not None:
        color_t = C_CRIT if temp >= 85 else (C_WARN if temp >= 75 else C_TXT)
        detalle.append(f"<span color='{C_DIM}'>temp  </span>"
                       f"<span color='{color_t}'>{temp:.0f}°C</span>")
    if detalle:
        lineas.append("    ".join(detalle))

    lineas += [
        "",
        f"<span color='{C_RAM}'><b>󰍛  RAM</b></span>   "
        f"<span color='{C_TXT}'><b>{ram_pct:.0f}%</b></span>",
        dato("used", f"{ram_usada:.1f} / {ram_total:.1f} GiB"),
    ]

    if gpu:
        color_tg = (C_CRIT if gpu["temp"] >= 85
                    else (C_WARN if gpu["temp"] >= 75 else C_TXT))
        lineas += [
            "",
            f"<span color='{C_GPU}'><b>󰢮  GPU</b></span>   "
            f"<span color='{C_TXT}'><b>{gpu['uso']:.0f}%</b></span>",
            f"<span color='{C_DIM}'>{escape(gpu['nombre'])}</span>",
            dato("VRAM", f"{gpu['vram_usada']:.1f} / {gpu['vram_total']:.1f} GiB")
            + f"    <span color='{C_DIM}'>temp  </span>"
              f"<span color='{color_tg}'>{gpu['temp']:.0f}°C</span>",
        ]
    else:
        lineas += ["", f"<span color='{C_DIM}'>󰢮  GPU unavailable</span>"]

    # CSS class so the whole module reacts if something spikes
    pico = max([cpu, ram_pct] + ([gpu["uso"]] if gpu else []))
    clase = "critical" if pico >= 95 else ("warning" if pico >= HIGH_THRESHOLD else "")

    print(json.dumps({
        "text": separador.join(partes),
        "tooltip": "\n".join(lineas),
        "class": clase,
    }, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # never leave the module blank
        print(json.dumps({"text": "󰋔  error", "tooltip": str(e), "class": "critical"}))
        sys.exit(0)
