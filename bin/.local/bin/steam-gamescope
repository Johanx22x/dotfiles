#!/usr/bin/env bash
# =============================================================
#  steam-gamescope — the whole of Steam inside gamescope, console mode
#
#  Starts Steam in Big Picture inside a fullscreen gamescope. Every game you
#  launch inherits a single virtual 2560x1440@165 monitor, so none of them
#  can get confused by the two-screen setup (one of them portrait). No launch
#  options are needed on any game.
#
#  Here -e / --steam IS used: that flag exists precisely for when gamescope
#  IS the compositor of the Steam session. It is what makes the overlay
#  (Shift+Tab) and Steam Input work properly.
#
#  Variables:
#    SG_W / SG_H      Output resolution           (def. the monitor you are on)
#    SG_HZ            Refresh rate                (def. that monitor's refresh rate)
#    SG_VRR=1         Adaptive sync / FreeSync
#    SG_HUD=1         FPS overlay (mangoapp)
#    SG_DESKTOP=1     Regular Steam instead of Big Picture
# =============================================================
set -uo pipefail

# The virtual output defaults to the monitor you are actually on, queried from
# the compositor. It used to default to 2560x1440@165, which is this machine
# and nothing else: on any other screen gamescope would have been handed a
# resolution the display cannot show, and the literals are wrong in a way you
# only find out when a game comes up letterboxed or refuses the mode.
#
# The same block as in `gs`, kept deliberately identical rather than shared:
# these two scripts have no common file to put it in, and a copy that reads the
# same is easier to keep honest than a third script sourced by both.
#
# The flavor is what is switched on rather than the `monitor-query` capability,
# because knowing the answer is yes does not tell you which IPC to speak -- the
# capability is for callers that only need to decide whether to bother asking.
#
# The fallback keeps the old numbers for the case there is nothing to ask --
# running this from a TTY, or from a compositor that cannot be queried.

# Found NEXT TO THIS SCRIPT and not through $PATH, same as in `gs`: readlink
# resolves the stow symlink back into the repo, so the helper is found whether
# this was started from ~/.local/bin or straight out of the checkout.
BIN_DIR="$(dirname "$(readlink -f "$0")")"
compositor() { host "$BIN_DIR/compositor" "$@"; }

# ASKING THE COMPOSITOR HAS TO HAPPEN OUTSIDE STEAM'S LOADER ENVIRONMENT.
# Steam exports its own LD_LIBRARY_PATH into everything it launches, this script
# included, and its pinned libraries shadow the system ones. That is not a
# hypothetical here: it is exactly what stopped mpvpaper from restarting and
# left the desktop frozen on a still frame, and it hid from testing because the
# poison only exists when Steam is the launcher.
#
# hyprctl happens to survive it. Whether `niri msg` does was never tested, and
# the failure would be invisible -- an empty answer drops straight through to
# the 2560x1440@165 fallback, so a 4K monitor would quietly get a 1440p
# gamescope and nothing on screen would say why. Cheaper to strip the
# environment than to find that out from a bug report.
host() { env -u LD_LIBRARY_PATH -u LD_PRELOAD "$@"; }

monitor_mode() {
    case "$(compositor 2>/dev/null)" in
        hyprland)
            host hyprctl monitors -j 2>/dev/null \
                | jq -r 'map(select(.focused))[0] // .[0]
                         | "\(.width) \(.height) \(.refreshRate | round)"' 2>/dev/null
            ;;
        niri)
            # focused-output rather than `outputs`, and not only because it
            # saves the picking: `niri msg -j outputs` answers with an OBJECT
            # keyed by connector name, not an array, so `.[0]` and `map()` --
            # the shape the Hyprland branch above uses -- do not apply to it.
            #
            # current_mode is an INDEX into modes and it is null while the
            # output is asleep or off. Guarded here rather than left to throw:
            # jq would exit non-zero, print nothing and drop through to the
            # fallback, which is a defensible answer for a dark screen but an
            # accidental one.
            #
            # refresh_rate is in MILLIHERTZ (165000 = 165 Hz), unlike
            # Hyprland's refreshRate, which is already in Hz.
            host niri msg -j focused-output 2>/dev/null \
                | jq -r 'if .current_mode == null then empty else
                             .modes[.current_mode]
                             | "\(.width) \(.height) \(.refresh_rate / 1000 | round)"
                         end' 2>/dev/null
            ;;
    esac
}
read -r DEF_W DEF_H DEF_HZ < <(monitor_mode) || true
[[ ${DEF_W:-null} == null || -z ${DEF_W:-} ]] && { DEF_W=2560; DEF_H=1440; DEF_HZ=165; }

W="${SG_W:-$DEF_W}"
H="${SG_H:-$DEF_H}"
HZ="${SG_HZ:-$DEF_HZ}"

command -v gamescope >/dev/null || { echo "gamescope is not installed" >&2; exit 1; }
command -v steam     >/dev/null || { echo "steam is not installed" >&2; exit 1; }

# -------------------------------------------------------------
# Steam only allows one instance. If one is already open on the desktop,
# the new one just talks to it and exits, leaving you with an empty
# gamescope. It has to be closed first.
# -------------------------------------------------------------
if pgrep -x steam >/dev/null 2>&1; then
    echo "Steam is already open on the desktop. Closing it..."
    steam -shutdown >/dev/null 2>&1
    for i in {1..30}; do
        pgrep -x steam >/dev/null 2>&1 || break
        sleep 1
    done
    if pgrep -x steam >/dev/null 2>&1; then
        echo "It did not close on its own. Close it by hand and run me again." >&2
        exit 1
    fi
    echo "Closed."
fi

# -------------------------------------------------------------
# Environment for EVERY game in the session
# -------------------------------------------------------------
# Persistent shader cache: fewer stutters on the second run.
export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
export __GL_SHADER_DISK_CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/nv"
mkdir -p "$__GL_SHADER_DISK_CACHE_PATH"

# DLSS / Reflex / Frame Generation on the 5070, via dxvk-nvapi.
export PROTON_ENABLE_NVAPI=1
# Ray tracing in DX12 games.
export VKD3D_CONFIG="${VKD3D_CONFIG:-dxr11,dxr}"

# Do NOT export SDL_VIDEODRIVER or QT_QPA_PLATFORM: they break games with
# older SDL2. Letting them fall back to XWayland inside gamescope is the
# right thing.

# -------------------------------------------------------------
# gamescope
# -------------------------------------------------------------
args=(
    -W "$W" -H "$H"
    -r "$HZ"
    -f                  # fullscreen
    -e                  # Steam integration: overlay and Steam Input
    --expose-wayland    # lets native games speak Wayland directly
)

[[ ${SG_VRR:-0} == 1 ]] && args+=( --adaptive-sync )
[[ ${SG_HUD:-0} == 1 ]] && args+=( --mangoapp )

if [[ ${SG_DESKTOP:-0} == 1 ]]; then
    steam_args=( steam )
else
    steam_args=( steam -gamepadui )   # Big Picture
fi

echo "Launching Steam in gamescope ${W}x${H}@${HZ}..."
echo "The window can take 10-15 seconds to appear. That is normal."
exec gamescope "${args[@]}" -- "${steam_args[@]}"
