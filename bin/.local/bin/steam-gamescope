#!/usr/bin/env bash
# =============================================================
#  steam-gamescope — the whole of Steam inside gamescope, console mode
#
#  Starts Steam in Big Picture inside a fullscreen gamescope. Every game you
#  launch inherits a single virtual 2560x1440@165 monitor, so none of them
#  can get confused by the two-screen setup (one of them portrait). No launch
#  options are needed on any game.
#
#  Here -e / --steam IS used: that flag exists precisely for when gamescope
#  IS the compositor of the Steam session. It is what makes the overlay
#  (Shift+Tab) and Steam Input work properly.
#
#  Variables:
#    SG_W / SG_H      Output resolution           (def. 2560x1440)
#    SG_HZ            Refresh rate                (def. 165)
#    SG_VRR=1         Adaptive sync / FreeSync
#    SG_HUD=1         FPS overlay (mangoapp)
#    SG_DESKTOP=1     Regular Steam instead of Big Picture
# =============================================================
set -uo pipefail

W="${SG_W:-2560}"
H="${SG_H:-1440}"
HZ="${SG_HZ:-165}"

command -v gamescope >/dev/null || { echo "gamescope is not installed" >&2; exit 1; }
command -v steam     >/dev/null || { echo "steam is not installed" >&2; exit 1; }

# -------------------------------------------------------------
# Steam only allows one instance. If one is already open on the desktop,
# the new one just talks to it and exits, leaving you with an empty
# gamescope. It has to be closed first.
# -------------------------------------------------------------
if pgrep -x steam >/dev/null 2>&1; then
    echo "Steam is already open on the desktop. Closing it..."
    steam -shutdown >/dev/null 2>&1
    for i in {1..30}; do
        pgrep -x steam >/dev/null 2>&1 || break
        sleep 1
    done
    if pgrep -x steam >/dev/null 2>&1; then
        echo "It did not close on its own. Close it by hand and run me again." >&2
        exit 1
    fi
    echo "Closed."
fi

# -------------------------------------------------------------
# Environment for EVERY game in the session
# -------------------------------------------------------------
# Persistent shader cache: fewer stutters on the second run.
export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
export __GL_SHADER_DISK_CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/nv"
mkdir -p "$__GL_SHADER_DISK_CACHE_PATH"

# DLSS / Reflex / Frame Generation on the 5070, via dxvk-nvapi.
export PROTON_ENABLE_NVAPI=1
# Ray tracing in DX12 games.
export VKD3D_CONFIG="${VKD3D_CONFIG:-dxr11,dxr}"

# Do NOT export SDL_VIDEODRIVER or QT_QPA_PLATFORM: they break games with
# older SDL2. Letting them fall back to XWayland inside gamescope is the
# right thing.

# -------------------------------------------------------------
# gamescope
# -------------------------------------------------------------
args=(
    -W "$W" -H "$H"
    -r "$HZ"
    -f                  # fullscreen
    -e                  # Steam integration: overlay and Steam Input
    --expose-wayland    # lets native games speak Wayland directly
)

[[ ${SG_VRR:-0} == 1 ]] && args+=( --adaptive-sync )
[[ ${SG_HUD:-0} == 1 ]] && args+=( --mangoapp )

if [[ ${SG_DESKTOP:-0} == 1 ]]; then
    steam_args=( steam )
else
    steam_args=( steam -gamepadui )   # Big Picture
fi

echo "Launching Steam in gamescope ${W}x${H}@${HZ}..."
echo "The window can take 10-15 seconds to appear. That is normal."
exec gamescope "${args[@]}" -- "${steam_args[@]}"
