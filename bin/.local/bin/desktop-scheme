#!/usr/bin/env bash
# =============================================================
#  desktop-scheme — which base palette the desktop wears
#
#  The colour of this desktop has two halves that move independently. The
#  ACCENTS -- three of them, plus the Material 3 roles around them -- were
#  derived from the wallpaper on every change and from nothing else. The BASE --
#  surfaces, text, outlines, the sixteen ANSI slots, the alert colours -- was
#  Tokyo Night written out as 227 hex literals across ten files, and could not
#  be changed without editing all of them.
#
#  This script is the dial for both halves: WHICH scheme supplies the base, and
#  WHERE the accents come from -- still the wallpaper unless told otherwise, or
#  the scheme's own accent, or a colour picked by hand.
#
#      desktop-scheme                 print the scheme in effect
#      desktop-scheme tokyo-night     set it
#      desktop-scheme set NAME        the same, spelled out
#      desktop-scheme list            NAME<TAB>Label, one per line
#      desktop-scheme show            every field this script keeps
#      desktop-scheme path [NAME]     where the scheme file is
#      desktop-scheme accent [SOURCE] where the ACCENTS come from
#      desktop-scheme accent hex HEX  ... and the colour, when it is a seed
#      desktop-scheme accent-args IMG how matugen is called for that
#      desktop-scheme pin NAME        set it WITHOUT changing the user's choice
#      desktop-scheme unpin           go back to the user's choice
#
#  A scheme is a JSON file in the repository's schemes/ directory, and
#  schemes/README.md is the authoritative list of the 74 role names one has to
#  fill. Read that before writing a scheme or a template; a name invented at
#  either end is a palette that cannot be rendered at all.
#
#  WHAT IT TOUCHES, and how each one takes it:
#
#    the state file  ~/.local/state/desktop-scheme, the tab-separated store the
#                    library already writes for desktop-tweak and night-light.
#                    This script writes it; the settings window reads it.
#    everything else INDIRECTLY, and this is the whole design. Nothing here
#                    renders a colour. `wallpaper-switch` asks this script two
#                    questions -- `path` for the scheme file and `accent-args`
#                    for where the accents come from -- and hands both answers
#                    to matugen, which is what writes the generated files.
#                    So setting a scheme ends in `wallpaper-switch reapply` and
#                    every consumer picks it up exactly as it does on a
#                    wallpaper change -- kitty by signal, niri by watching its
#                    include, GTK and Zen at the next start.
#
#  WHY THE USER'S CHOICE IS KEPT SEPARATELY FROM THE ONE IN EFFECT. A theme
#  will later be able to PIN a scheme -- "this theme is Gruvbox, and while it is
#  on you get Gruvbox" -- and leaving that theme has to put back whatever was
#  there before, not the default and not the theme's. One key cannot answer both
#  questions, so there are two: `scheme` is what renders, `chosen` is what the
#  person last picked for themselves. `set` writes both; `pin` writes only the
#  first; `unpin` copies the second over the first. Nothing pins anything today
#  and the keys cost two lines.
#
#  Same shape as desktop-opacity and desktop-font, its siblings: one state file
#  under ~/.local/state, found through readlink rather than $PATH, written whole
#  and renamed over the old one.
# =============================================================
set -euo pipefail

# FOUND NEXT TO THIS SCRIPT AND NOT THROUGH $PATH, for the reason written out at
# the top of desktop-lib.sh: the settings window in Quickshell inherits the
# compositor's environment and ~/.local/bin is not on it. readlink resolves the
# stow symlink back into the repository, which is also how the schemes below are
# found -- they are versioned content, not machine state, so they live in the
# checkout rather than in ~/.config, and only the resolved path can reach them.
BIN_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/desktop-lib.sh
. "$BIN_DIR/../lib/desktop-lib.sh"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/desktop-scheme"

# bin/.local/bin -> the repository root. `cd` rather than string surgery so the
# path is normalised, and so a checkout laid out differently fails here with
# something readable instead of at the first `[[ -r ]]` three functions down.
REPO_DIR="$(cd "$BIN_DIR/../../.." && pwd)" \
    || die "cannot find the repository above $BIN_DIR"
SCHEME_DIR="$REPO_DIR/schemes"

DEFAULT_SCHEME="tokyo-night"

# WHERE THE ACCENTS COME FROM, which is the other axis and is deliberately not
# the same setting: a scheme says what the desktop is made of, this says which
# of the two halves is allowed to move with the picture behind it.
#
#   wallpaper  the image on the desktop. The default, and what this desktop has
#              always done.
#   scheme     the scheme's own `fb_*` block, which mirrors the 17 Material 3
#              roles one for one (schemes/README.md section 1.4). Those values
#              are the half of a scheme that nothing used to read: the base was
#              applied and the accent was not, which is why Tokyo Night looked
#              like every other wallpaper's blue rather than like #7aa2f7.
#   hex        a colour picked by hand. matugen derives a whole Material 3
#              palette from a seed with `matugen color hex`, which takes the
#              same flags as `matugen image` -- checked against 4.2.0, `--mode`,
#              `--prefer`, `--quiet`, `--import-json` and `--import-json-string`
#              are all on both -- so the wallpaper simply stops being the source.
#
# THE BASE IS UNTOUCHED BY ALL THREE. It comes from the scheme's `ui_`, `term_`
# and `sem_` roles, imported exactly as before; only the 17 M3 roles move. So
# `accent hex` is not "a scheme made of one colour", it is this scheme with a
# different accent in it.
#
# ONE MECHANISM, NOT THREE. matugen's imported JSON wins over what matugen
# derived -- measured, and written out in schemes/README.md -- so `scheme` is a
# matter of what goes into the import and nothing else. `hex` is the one that
# also changes the subcommand, which is why `accent-args` below hands back the
# whole opening of the matugen command line rather than a flag to append.
DEFAULT_ACCENT="wallpaper"
ACCENT_SOURCES=(wallpaper scheme hex)

# ---------------------------------------------------------------------------
# Reading
# ---------------------------------------------------------------------------

# A name is a filename, so it is checked before it is ever joined to a path: a
# `..` or a slash here would read a JSON file from somewhere else entirely and
# hand it to matugen as a palette.
valid_name() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

scheme_file() {
    printf '%s/%s.json\n' "$SCHEME_DIR" "$1"
}

# Every scheme the repository ships, by name, sorted. LC_ALL=C for the reason
# the library sorts its store that way: an order that moves with the locale is
# an order that differs between two machines sharing this repo.
list_names() {
    local path name
    for path in "$SCHEME_DIR"/*.json; do
        [[ -r "$path" ]] || continue
        name="${path##*/}"
        printf '%s\n' "${name%.json}"
    done | LC_ALL=C sort
}

# The same list on one line, for the tail of an error message. `paste` rather
# than `tr '\n' ' '`, which leaves a trailing space inside the closing bracket.
names_inline() {
    list_names | paste -sd' ' -
}

# The human-facing name, out of _meta.label. Falls back to the file's own name
# rather than failing: a scheme with no label is still a scheme, and a settings
# window with a blank row in it is worse than one showing `gruvbox-dark-medium`.
label_of() {
    local name="$1" label
    label="$(jq -r '._meta.label // empty' "$(scheme_file "$name")" 2>/dev/null || true)"
    printf '%s\n' "${label:-$name}"
}

# The scheme in effect. An unset key and an unreadable store read the same, so a
# fresh clone answers with the default rather than with nothing.
current() {
    local value
    value="$(state_get "$STATE_FILE" scheme)"
    printf '%s\n' "${value:-$DEFAULT_SCHEME}"
}

# The one the PERSON last picked, which is not always the one in effect -- see
# the note about pinning at the top.
chosen() {
    local value
    value="$(state_get "$STATE_FILE" chosen)"
    printf '%s\n' "${value:-$(current)}"
}

accent_source() {
    local value
    value="$(state_get "$STATE_FILE" accent)"
    printf '%s\n' "${value:-$DEFAULT_ACCENT}"
}

# The seed `hex` renders from, empty until somebody picks one. ITS OWN KEY and
# not part of `accent`, for the same reason `chosen` is kept apart from `scheme`
# further up: going to the wallpaper and back has to return the colour that was
# there, not ask for it again.
accent_seed() {
    state_get "$STATE_FILE" accent-hex
}

# `#rrggbb`, lower case, and the `#` is optional coming in. Every colour picker
# on the machine copies with one, and an unquoted argument that starts with one
# is a comment as far as the shell is concerned -- so both spellings arrive here
# and only one is ever stored.
normalise_hex() {
    local value="${1#\#}"
    [[ "$value" =~ ^[0-9a-fA-F]{6}$ ]] || return 1
    printf '#%s\n' "${value,,}"
}

# The 17 Material 3 roles, out of the scheme's `fb_*` block, in the shape
# matugen imports.
#
# THE MAPPING IS THE PREFIX AND NOTHING ELSE. The block mirrors the M3 names one
# for one by construction, so a list of the seventeen written out here would be
# a second copy of schemes/README.md section 1.4 to keep in step -- and the day
# they disagreed, the render would still succeed and simply leave a role on the
# wallpaper's colour. tests/scheme-roles.py is what guarantees the set is
# complete; the only thing worth refusing here is an EMPTY one, because that is
# the case where `accent scheme` would quietly mean `accent wallpaper`.
#
# `jq -c` so the whole payload is one line: `accent-args` is read a line at a
# time by its caller, and a pretty-printed object would arrive as forty
# arguments.
scheme_accent_payload() {
    local file="$1" payload
    payload="$(jq -c '{colors: (.colors
            | with_entries(select(.key | startswith("fb_"))
            | .key |= sub("^fb_"; "")))}' "$file")" \
        || die "could not read the accent roles out of $file"

    if [[ "$payload" == '{"colors":{}}' ]]; then
        die "the scheme at $file defines no fb_* roles, so it has no accent to give"
    fi

    printf '%s\n' "$payload"
}

# THE WHOLE OPENING OF THE matugen COMMAND LINE, one word per line, for
# `wallpaper-switch` to read into an array. Everything after it -- the mode, the
# preference, the scheme import -- is the same for all three sources and stays
# at that call site.
#
# WHY THE WORDS AND NOT A FLAG. Two of the three answers are `matugen image
# <wallpaper>` with something extra imported; the third is `matugen color hex
# <seed>`, a different subcommand with a different argument in place of the
# image. A seam that could only append could not express the third, and a
# `wallpaper-switch` that branched on the accent source itself would be the
# second reader of this store -- the thing the note above `rerender` exists to
# avoid.
#
# A PURE READ, so there is no loop: `set` calls `wallpaper-switch reapply`,
# `reapply` calls this, and this returns. Same contract as `path`.
accent_args() {
    local image="$1" source_name seed
    source_name="$(accent_source)"

    case "$source_name" in
        wallpaper)
            # Byte for byte what the call site used to spell out itself.
            printf 'image\n%s\n' "$image"
            ;;
        scheme)
            printf 'image\n%s\n--import-json-string\n%s\n' \
                "$image" "$(scheme_accent_payload "$(scheme_file "$(current)")")"
            ;;
        hex)
            seed="$(accent_seed)"
            [[ -n "$seed" ]] \
                || die "the accent source is 'hex' but no colour is set (try: desktop-scheme accent hex '#7aa2f7')"
            # `image` IS OVERRIDDEN ON PURPOSE, and it is the one name outside
            # `colors` this repository ever overrides. Twelve of the fourteen
            # templates open with `Wallpaper: {{image}}` as provenance -- every
            # one except ranger-accent and zathurarc. `matugen color hex` has
            # no image to put there and renders the word `Null`, which is not
            # "no wallpaper" but a lie about a desktop that has one. jq builds
            # the string so a path carrying a quote cannot break the JSON.
            printf 'color\nhex\n%s\n--import-json-string\n%s\n' "$seed" \
                "$(jq -cn --arg image "$image" --arg seed "$seed" \
                    '{image: ($image + " (accents seeded from " + $seed + ")")}')"
            ;;
        *)
            die "not an accent source: '$source_name' (have: ${ACCENT_SOURCES[*]})"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Applying
# ---------------------------------------------------------------------------

# THROUGH wallpaper-switch AND NOT BY CALLING matugen HERE. matugen has to be
# handed an image, and working out which image that is means knowing that a
# video is coloured from a cached frame instead -- `PALETTE_SOURCE` and
# `frame_for` in wallpaper-switch, twenty lines of it. A second copy of that
# reasoning is a second place for videos to be wrong.
#
# There is no loop back into this script: `reapply` asks for `desktop-scheme
# path`, and `path` reads a file and returns.
#
# NOT FATAL, and the state file is written before this runs. If the re-render
# fails -- no wallpaper set yet, matugen not installed -- the setting is still
# set, and the next wallpaper change renders it. Saying so is the whole job
# here; failing would be claiming the choice did not land when it did.
rerender() {
    local ws="$BIN_DIR/wallpaper-switch"
    if [[ ! -x "$ws" ]]; then
        warn "wallpaper-switch not found beside this script; nothing was re-rendered"
        return 0
    fi
    if "$ws" reapply >/dev/null; then
        note "palette: re-rendered from the current wallpaper"
    else
        warn "the palette could not be re-rendered; it will follow at the next wallpaper change"
    fi
}

# Write the keys, then re-render only if what renders actually moved. The state
# is written either way: `set` on the scheme already in effect still has to
# record it as the person's own choice, which is the case that matters the day
# a theme is pinning something.
commit() {
    local before="$1"
    local after
    after="$(current)"
    if [[ "$before" == "$after" ]]; then
        note "already in effect, nothing to re-render"
    else
        rerender
    fi
}

# ---------------------------------------------------------------------------
# The commands
# ---------------------------------------------------------------------------

set_scheme() {
    local name="$1" also_chosen="$2" before
    valid_name "$name" || die "not a scheme name: '$name'"
    [[ -r "$(scheme_file "$name")" ]] \
        || die "no such scheme: '$name' (try: $(names_inline))"

    before="$(current)"
    state_set "$STATE_FILE" scheme "$name"
    # An `if` and not `[[ ... ]] && ...`: a failed test at the end of a && list
    # is a non-zero statement, and `set -e` on the first line would take that as
    # the script failing rather than as the branch not being taken.
    if [[ "$also_chosen" == chosen ]]; then
        state_set "$STATE_FILE" chosen "$name"
    fi

    printf 'Desktop scheme: %s\n' "$(label_of "$name")"
    commit "$before"
}

# The other axis. Same shape as set_scheme: validate, write, say so, re-render
# only if what renders actually moved.
#
# THE SEED COUNTS AS PART OF "MOVED". `accent hex '#ff0000'` while already on
# `hex` changes every accent on the desktop and does not change the source, so
# comparing the source alone would leave the person looking at the old colour
# and a message saying the new one was applied.
set_accent() {
    local source_name="$1" seed_arg="${2-}"
    local allowed found=0 seed="" before after

    for allowed in "${ACCENT_SOURCES[@]}"; do
        if [[ "$source_name" == "$allowed" ]]; then
            found=1
            break
        fi
    done
    (( found )) \
        || die "not an accent source: '$source_name' (have: ${ACCENT_SOURCES[*]})"

    if [[ "$source_name" == hex ]]; then
        if [[ -n "$seed_arg" ]]; then
            seed="$(normalise_hex "$seed_arg")" \
                || die "not a colour: '$seed_arg' (expected #rrggbb)"
        else
            # No colour given and one already stored is `accent hex` meaning
            # "go back to the seed I picked", which is the same courtesy
            # `unpin` does for the scheme.
            seed="$(accent_seed)"
            [[ -n "$seed" ]] \
                || die "which colour? (try: desktop-scheme accent hex '#7aa2f7')"
        fi
    elif [[ -n "$seed_arg" ]]; then
        die "only 'hex' takes a colour; '$source_name' does not"
    fi

    before="$(accent_source) $(accent_seed)"
    state_set "$STATE_FILE" accent "$source_name"
    if [[ -n "$seed" ]]; then
        state_set "$STATE_FILE" accent-hex "$seed"
    fi
    after="$(accent_source) $(accent_seed)"

    if [[ "$source_name" == hex ]]; then
        printf 'Desktop accent source: %s (%s)\n' "$source_name" "$seed"
    else
        printf 'Desktop accent source: %s\n' "$source_name"
    fi

    if [[ "$before" == "$after" ]]; then
        note "already in effect, nothing to re-render"
    else
        rerender
    fi
}

MODE="${1:-}"

case "$MODE" in
    "")
        current
        ;;

    list)
        # NAME then a tab then the label: the shape the settings window already
        # parses everywhere else in this layer, and still readable by eye.
        while read -r name; do
            printf '%s\t%s\n' "$name" "$(label_of "$name")"
        done < <(list_names)
        ;;

    show)
        printf 'scheme\t%s\n' "$(current)"
        printf 'chosen\t%s\n' "$(chosen)"
        printf 'accent\t%s\n' "$(accent_source)"
        # Printed even when the source is not `hex`, because it is kept even
        # then: an empty value here means nobody has ever picked a colour, and
        # that is a different answer from "the accents come from the wallpaper".
        printf 'accent-hex\t%s\n' "$(accent_seed)"
        ;;

    path)
        # The seam wallpaper-switch uses. Defaults to the scheme in effect, so
        # the caller never has to know how that is stored.
        name="${2:-$(current)}"
        valid_name "$name" || die "not a scheme name: '$name'"
        file="$(scheme_file "$name")"
        [[ -r "$file" ]] || die "no such scheme: '$name'"
        printf '%s\n' "$file"
        ;;

    accent)
        # Bare, it answers with ONE WORD and never the colour: this is what the
        # settings window reads to light up a segment, and `show` below is where
        # the whole answer lives.
        if (( $# < 2 )); then
            accent_source
            exit 0
        fi
        set_accent "$2" "${3-}"
        ;;

    accent-args)
        # The seam wallpaper-switch renders through. It takes the image because
        # working out WHICH image -- a video is coloured from a cached frame --
        # is twenty lines that belong to that script and are not repeated here.
        (( $# >= 2 )) || die "accent-args needs the image matugen would read"
        accent_args "$2"
        ;;

    set)
        (( $# >= 2 )) || die "which scheme? (try: $(names_inline))"
        set_scheme "$2" chosen
        ;;

    pin)
        # For a theme. Changes what renders and leaves `chosen` alone, so
        # `unpin` can put the person's own scheme back.
        (( $# >= 2 )) || die "which scheme? (try: $(names_inline))"
        set_scheme "$2" keep
        ;;

    unpin)
        set_scheme "$(chosen)" chosen
        ;;

    -h|--help|help)
        # The header of this file is the help text; printing a second copy of it
        # is a second copy to keep in step. The two rules of `=` around it are
        # the frame, not the text, so they are dropped rather than printed.
        awk 'NR > 1 && /^# =====/ { if (seen++) exit; next }
             seen { sub(/^# ?/, ""); print }' "$(readlink -f "$0")"
        ;;

    *)
        # THE BARE FORM, and it is checked LAST so a scheme can never shadow a
        # command. Every word above is reserved; tests/scheme-roles.py reads
        # them back out of this `case` and refuses a scheme file named after
        # one, so `desktop-scheme list` cannot become ambiguous the day
        # somebody adds schemes/list.json.
        set_scheme "$MODE" chosen
        ;;
esac
