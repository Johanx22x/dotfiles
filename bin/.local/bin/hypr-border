#!/usr/bin/env bash
# =============================================================
#  hypr-border — how thick the border around a window is
#
#      hypr-border          print the current width
#      hypr-border 0        no border at all
#      hypr-border 2        back to what hyprland.lua sets
#
#  The border is the compositor's, not the shell's -- it is drawn around every
#  window including the ones this desktop knows nothing about -- so it cannot
#  be a Theme constant. It is here for the same reason the desktop opacity is:
#  a thing you look at, so a thing worth being able to change without opening
#  an editor.
#
#  APPLIED WITH `hyprctl eval`, NOT `hyprctl keyword`. With a Lua config
#  keyword is refused outright ("keyword can't work with non-legacy parsers")
#  and still exits 0, which is how desktop-opacity shipped a version that
#  reported success for a rule it had never applied. hl.config is the same
#  entry point wallpaper-switch already uses to push the border COLOUR.
#
#  Persisted in ~/.local/state, read back by hyprland.lua at load, so a
#  `hyprctl reload` does not undo it.
# =============================================================
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/hypr-border"

# The default is the one written in hyprland.lua. The two have to agree or
# "restore defaults" in the settings window would put the border somewhere the
# config never asked for.
DEFAULT=2

# Six is already thick enough that the border is the loudest thing on screen;
# past that it is not a border, it is a frame.
MAX=6

die() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }

if (( $# == 0 )); then
  [[ -r "$STATE_FILE" ]] && cat "$STATE_FILE" || printf '%s\n' "$DEFAULT"
  exit 0
fi

value="$1"

[[ "$value" =~ ^[0-9]+$ ]] || die "Not a whole number of pixels: '$value'"
(( value <= MAX )) || die "Out of range: $value (expected 0 to $MAX)"

mkdir -p "$STATE_DIR"
printf '%s\n' "$value" > "$STATE_FILE"

if command -v hyprctl >/dev/null && hyprctl monitors >/dev/null 2>&1; then
  hyprctl eval "hl.config({ general = { border_size = $value } })" >/dev/null
  printf 'Window border: %s px, applied\n' "$value"
else
  printf 'Window border: %s px, saved (Hyprland is not running)\n' "$value"
fi
