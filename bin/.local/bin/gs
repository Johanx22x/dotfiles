#!/usr/bin/env bash
# =============================================================
#  gs — game launcher for Steam on Wayland (Hyprland or niri)
#
#  Usage in Steam:  Game properties -> Launch options:
#
#      ~/.local/bin/gs -- %command%
#
#  Wraps the game in gamescope, which presents it with ONE single virtual
#  "monitor" of 2560x1440@165. The game never sees the two-screen setup (one
#  of them portrait), so it can no longer get the resolution wrong or open in
#  a tiny window.
#
#  Environment variables to tune per game (they go IN FRONT in the launch
#  options, e.g.:  GS_W=1920 GS_H=1080 gs -- %command%)
#
#    GS_OUT_W / GS_OUT_H  Real output resolution      (def. the monitor you are on)
#    GS_HZ                Refresh rate / FPS cap      (def. that monitor's refresh rate)
#    GS_W / GS_H          Internal render resolution; if lower than the
#                         output one, gamescope upscales with FSR.
#                         E.g. GS_W=1920 GS_H=1080 -> renders at 1080p and
#                         scales to 1440p. A good trick for heavy games.
#    GS_FSR               Scaling filter: fsr | nis | linear | nearest
#    GS_FPS               Framerate cap, applied by gamescope rather than the
#                         game. Must divide GS_HZ evenly, e.g.
#                         GS_HZ=120 GS_FPS=60.
#    GS_HUD               The MangoHud overlay, which is ALWAYS loaded and
#                         starts hidden. Press Shift_R+F12 in game to show or
#                         hide it (toggle_hud in MangoHud.conf).
#                           GS_HUD=1    start with it already visible
#                           GS_HUD=off  do not load it at all. Needed before
#                                       GS_WAYLAND=1 can work, since mangoapp
#                                       is an X11 client.
#    GS_WAYLAND=1         Native Wayland games talk to gamescope directly
#                         (--expose-wayland). Off by default: it breaks screen
#                         sharing and the HUD. See the note further down.
#    GS_VRR=1             Enables adaptive sync / FreeSync
#    GS_GRAB=1            Forces permanent relative mouse mode. Only if the
#                         mouse escapes to the other monitor. It makes the
#                         cursor look stuck while the game loads.
#    GS_GAMEMODE=0        Disables gamemoderun
#    GS_OFF=1             Skips gamescope entirely (native Wayland game)
#    GS_OVERLAY=1         Lets the Steam overlay load inside gamescope too.
#                         Off by default: it cannot draw there and it is what
#                         makes long sessions turn to treacle (gamescope #697).
#    GS_WALLPAPER=1       Keeps a video wallpaper playing while you play. By
#                         default it is frozen to a still frame for the length
#                         of the game and restored on exit: the picture stays,
#                         the ~2 GB of VRAM its decoder holds does not.
# =============================================================
set -euo pipefail

# Steam passes "gs -- <command>"; swallow the leading --.
[[ ${1:-} == "--" ]] && shift

if [[ $# -eq 0 || ${1:-} == "--help" || ${1:-} == "-h" ]]; then
    # Up to the closing rule rather than to a hardcoded line number, which
    # silently swallowed the last variables as soon as one was added above.
    sed -n '2,/^# =\+$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

# ---- NVIDIA / Proton settings common to every game ----
# Persistent shader cache: fewer stutters the second time you play.
export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
export __GL_SHADER_DISK_CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/nv"
mkdir -p "$__GL_SHADER_DISK_CACHE_PATH"

# DLSS / Reflex / Frame Generation on the 5070 via dxvk-nvapi.
export PROTON_ENABLE_NVAPI=1
# Ray tracing in DX12 games.
export VKD3D_CONFIG="${VKD3D_CONFIG:-dxr11,dxr}"

# ---- VRAM: the video wallpaper stands down while the game runs ----
# mpvpaper decodes into video memory and holds about 1.9 GB of it for as long
# as it lives -- 16% of the 12 GB on this card, spent on something no one can
# see behind a fullscreen game. It is not idle either: -p and -a FULL pause the
# PLAYBACK when a fullscreen window covers it, and a paused decoder still owns
# every buffer it allocated.
#
# That margin is not spare. Measured on 2026-08-13 with Kingdom Come:
# Deliverance 2 at 1440p, VRAM sat at 10697 of 12227 MiB with the game alone
# asking for 7013. When a game crosses what is left, the driver starts moving
# buffers out to system RAM over PCIe and the GPU spends its frames waiting on
# DMA instead of drawing: utilisation collapses to ~30% at ~88 W with no
# thermal or power throttling, and the game stutters while every sensor says
# the card is idle. Push a little further and allocation simply fails --
# fourteen "Failed to allocate NVKMS memory for GEM object" in the kernel log,
# then gamescope aborts on an assert in vulkan_remake_output_images() and takes
# the game down with it.
#
# FROZEN TO A STILL FRAME, not paused and not blanked.
#
# Pausing does nothing for the only thing being asked for here. Measured on
# 2026-08-13: mpvpaper held 2045 MiB while running, 2045 MiB under SIGSTOP with
# the process in state T, and 2045 MiB again once resumed. The buffers belong
# to the decoder, not to playback, and the process has to EXIT to give them up.
#
# Blanking would work and is still wrong: gamescope covers ONE monitor, so the
# portrait screen is in view for the whole session and would sit there empty.
# Freezing keeps exactly the same picture on it for no video memory at all.
#
# Both halves go through wallpaper-switch, which owns the backends and the
# frame cache: `still` swaps the video for its own cached frame under awww, and
# `reapply` puts the video back. A second copy of that logic in here would be
# one more thing to keep in step for no gain.
#
# THE RESTORE MUST NOT DEPEND ON THIS SCRIPT LIVING TO SEE IT. The first version
# used `trap restore EXIT INT TERM`, and it left the desktop stuck on the still
# frame for good on 2026-08-13. Two ways that happens, both real here:
#
#   - A trap cannot run on SIGKILL, and Steam tears a game down by signalling
#     the whole process tree. gs is in that tree.
#   - Even when the trap does run, the mpvpaper it forks is in the same process
#     group, so a group-wide kill arriving a moment later takes the new
#     wallpaper with it. The symptom is identical and hides the first cause.
#
# So the restore is handed to a WATCHDOG detached with `setsid` before the game
# starts. Its own session means no group-wide kill reaches it; it waits for this
# script's pid to disappear, however it disappears, and only then restores. One
# restorer and no trap, so there is no second path to keep in step and no double
# transition when both would have fired.
WALLPAPER_FROZEN=0

# STEAM'S LOADER ENVIRONMENT HAS TO GO before calling anything on the host.
# Steam exports its own LD_LIBRARY_PATH into everything it launches, this script
# included, and its pinned libraries shadow the system ones. mpvpaper does not
# survive it -- verified on 2026-08-13:
#
#   $ env LD_LIBRARY_PATH="$STEAM_LD_LIBRARY_PATH" mpvpaper --help
#   mpvpaper: .../steam-runtime/pinned_libs_64/libcurl.so.4: version
#   `CURL_OPENSSL_4' not found (required by /usr/lib/libsixel.so.1)
#   exit 1
#
# This is what left the desktop stuck on the still frame: the freeze worked,
# because awww and hyprctl come through that environment unharmed, and then the
# restore silently could not start mpvpaper. It also hid itself from testing --
# run gs from a normal shell and everything passes, because the poison only
# exists when Steam is the one launching it.
wallpaper_switch() {
    env -u LD_LIBRARY_PATH -u LD_PRELOAD "$HOME/.local/bin/wallpaper-switch" "$@"
}

# The watchdog has to end up OUT OF STEAM'S PROCESS TREE, and not merely out of
# this script's session, which is all `setsid` ever bought.
#
# Steam runs every game under steam-runtime-supervisor --terminate-when-signaled,
# and that implies --subreaper: "Do not exit until all descendant processes have
# exited", per the supervisor's own --help. A subreaper adopts orphans, session
# or no session, so the watchdog stayed a descendant of it -- and so did the
# mpvpaper it starts on the way out, which then plays for hours. The game was
# long gone and Steam still showed it as running, because the one thing it was
# still waiting on was the wallpaper. That is the game stuck on "Stop" in the
# library that nothing but restarting Steam would clear.
#
# systemd-run puts the watchdog under the user's systemd manager, which is
# nobody's descendant, so the last thing left in the tree dies with the game.
# setsid stays as the fallback: without a user manager the restore still runs,
# exactly as it did before, and only Steam's idea of "running" goes back to
# clearing late.
start_wallpaper_watchdog() {
    if command -v systemd-run >/dev/null 2>&1 &&
       systemctl --user show-environment >/dev/null 2>&1; then
        systemd-run --user --collect --quiet \
            --description="gs: restore the wallpaper when the game exits" \
            -- bash -c "$1" >/dev/null 2>&1 && return 0
    fi
    setsid -f bash -c "$1" >/dev/null 2>&1
}

freeze_video_wallpaper() {
    [[ ${GS_WALLPAPER:-0} == 1 ]] && return 0
    pgrep -x mpvpaper >/dev/null 2>&1 || return 0

    wallpaper_switch still >/dev/null 2>&1 || {
        echo "gs: could not freeze the video wallpaper, leaving it alone" >&2
        return 0
    }
    WALLPAPER_FROZEN=1

    # $$ is this script's pid, read inside the watchdog's own quoting. `kill -0`
    # only tests whether the pid is still there; it sends nothing.
    local watchdog='
        while kill -0 '"$$"' 2>/dev/null; do sleep 1; done
        exec env -u LD_LIBRARY_PATH -u LD_PRELOAD \
            "$HOME/.local/bin/wallpaper-switch" reapply
    '
    start_wallpaper_watchdog "$watchdog" || {
        echo "gs: could not start the wallpaper watchdog" >&2
    }

    # Wait for the process to be gone before handing the card to the game.
    # awww is already up by the time `still` returns, but mpvpaper exiting is
    # what releases the memory, and a game that starts a moment early measures
    # a card that is still 2 GB short of what it is about to be given.
    for _ in {1..20}; do
        pgrep -x mpvpaper >/dev/null 2>&1 || break
        sleep 0.05
    done

    echo "gs: video wallpaper frozen to a still, freeing its VRAM (GS_WALLPAPER=1 keeps it playing)" >&2
}

# Every path out of this script goes through here instead of exec'ing, so that
# the freeze happens once, in one place, whichever way the game is launched.
# The watchdog waits on this script's pid, so gs staying alive as the parent is
# what defines "the game is over" -- it exits when gamescope does, and it dies
# with it if the whole tree is killed. Cost: one sleeping bash process per game.
launch() {
    freeze_video_wallpaper
    "$@"
}

# ---- Exit without gamescope (native games that already behave) ----
if [[ ${GS_OFF:-0} == 1 ]]; then
    if [[ ${GS_GAMEMODE:-1} == 1 ]] && command -v gamemoderun >/dev/null; then
        launch gamemoderun "$@"
        exit
    fi
    launch "$@"
    exit
fi

if ! command -v gamescope >/dev/null; then
    echo "gs: gamescope is not installed, launching the game as is" >&2
    launch "$@"
    exit
fi

# If Steam is already running inside a gamescope session -- Steam Deck mode, or
# a gamescope started by hand around the whole client -- adding another
# gamescope per game nests it on itself: worse performance, odd input and a
# broken overlay. In that case do nothing and let the game through.
if [[ -n ${GAMESCOPE_WAYLAND_DISPLAY:-} ]]; then
    echo "gs: already inside gamescope, not nesting another one" >&2
    if [[ ${GS_GAMEMODE:-1} == 1 ]] && command -v gamemoderun >/dev/null; then
        launch gamemoderun "$@"
        exit
    fi
    launch "$@"
    exit
fi

# ---- Building the gamescope command line ----
# The virtual output defaults to the monitor you are actually on, queried from
# the compositor. It used to default to 2560x1440@165, which is this machine
# and nothing else: on any other screen gamescope would have been handed a
# resolution the display cannot show, and the literals are wrong in a way you
# only find out when a game comes up letterboxed or refuses the mode.
#
# Which compositor is answering is asked of the helper and not of
# XDG_CURRENT_DESKTOP: Steam hands this script an environment it inherited from
# the session, so the desktop name says what was logged into rather than what is
# up. The flavor is what is switched on here rather than the `monitor-query`
# capability, because knowing the answer is yes does not tell you which IPC to
# speak -- the capability is for callers that only need to decide whether to
# bother asking.
#
# The fallback keeps the old numbers for the case there is nothing to ask --
# running this from a TTY, or from a compositor that cannot be queried.

# Found NEXT TO THIS SCRIPT and not through $PATH: Steam does not necessarily
# have ~/.local/bin on it, and a `compositor` that cannot be run would degrade
# to the fallback resolution without saying so. readlink resolves the stow
# symlink back into the repo, so the helper is found whether this was started
# from ~/.local/bin or straight out of the checkout.
BIN_DIR="$(dirname "$(readlink -f "$0")")"
compositor() { host "$BIN_DIR/compositor" "$@"; }

# ASKING THE COMPOSITOR HAS TO HAPPEN OUTSIDE STEAM'S LOADER ENVIRONMENT.
# Steam exports its own LD_LIBRARY_PATH into everything it launches, this script
# included, and its pinned libraries shadow the system ones. That is not a
# hypothetical here: it is exactly what stopped mpvpaper from restarting and
# left the desktop frozen on a still frame, and it hid from testing because the
# poison only exists when Steam is the launcher.
#
# hyprctl happens to survive it. Whether `niri msg` does was never tested, and
# the failure would be invisible -- an empty answer drops straight through to
# the 2560x1440@165 fallback, so a 4K monitor would quietly get a 1440p
# gamescope and nothing on screen would say why. Cheaper to strip the
# environment than to find that out from a bug report.
host() { env -u LD_LIBRARY_PATH -u LD_PRELOAD "$@"; }

monitor_mode() {
    case "$(compositor 2>/dev/null)" in
        hyprland)
            host hyprctl monitors -j 2>/dev/null \
                | jq -r 'map(select(.focused))[0] // .[0]
                         | "\(.width) \(.height) \(.refreshRate | round)"' 2>/dev/null
            ;;
        niri)
            # focused-output rather than `outputs`, and not only because it
            # saves the picking: `niri msg -j outputs` answers with an OBJECT
            # keyed by connector name, not an array, so `.[0]` and `map()` --
            # the shape the Hyprland branch above uses -- do not apply to it.
            #
            # current_mode is an INDEX into modes and it is null while the
            # output is asleep or off. Guarded here rather than left to throw:
            # jq would exit non-zero, print nothing and drop through to the
            # fallback, which is a defensible answer for a dark screen but an
            # accidental one.
            #
            # refresh_rate is in MILLIHERTZ (165000 = 165 Hz), unlike
            # Hyprland's refreshRate, which is already in Hz.
            host niri msg -j focused-output 2>/dev/null \
                | jq -r 'if .current_mode == null then empty else
                             .modes[.current_mode]
                             | "\(.width) \(.height) \(.refresh_rate / 1000 | round)"
                         end' 2>/dev/null
            ;;
    esac
}
read -r DEF_W DEF_H DEF_HZ < <(monitor_mode) || true
[[ ${DEF_W:-null} == null || -z ${DEF_W:-} ]] && { DEF_W=2560; DEF_H=1440; DEF_HZ=165; }

OUT_W="${GS_OUT_W:-$DEF_W}"
OUT_H="${GS_OUT_H:-$DEF_H}"
HZ="${GS_HZ:-$DEF_HZ}"

args=(
    -W "$OUT_W" -H "$OUT_H"   # virtual monitor resolution = real output
    -r "$HZ"                  # refresh rate (also acts as an FPS cap)
    -f                        # start fullscreen. ALWAYS.
)

# CAREFUL with -e / --steam: do NOT set it by default. In a session nested
# inside Hyprland it makes gamescope create no window at all: the game starts,
# renders and plays sound, but nothing is visible. That flag is for when
# gamescope IS the session compositor (Steam Deck mode), not for launching
# individual games.
[[ ${GS_STEAM:-0} == 1 ]] && args+=( -e )

# Lower internal render resolution + FSR upscaling
if [[ -n ${GS_W:-} && -n ${GS_H:-} ]]; then
    args+=( -w "$GS_W" -h "$GS_H" -F "${GS_FSR:-fsr}" )
fi

# --expose-wayland lets native Wayland games talk to gamescope directly instead
# of going through the XWayland inside it. It is OPT-IN, and it used to be the
# default. Two separate things make it a bad default:
#
# 1. It BREAKS SCREEN SHARING. With --expose-wayland, sharing the screen through
#    the desktop portal (Discord, a browser, OBS) makes the game stick on your
#    own monitor: either a frozen frame pasted over the live game with a narrow
#    strip still repainting, or the whole thing crawling as if it ran at 1 fps
#    while the game is really pushing 165. Stopping the share clears it
#    instantly. Found on 2026-08-12 with Kingdom Come: Deliverance 2, after
#    ruling out, each by measurement: direct scanout (directScanoutTo read 0
#    while already frozen), the portal's own settings (both force_shm and
#    monitor-vs-window capture change nothing), damage tracking
#    (debug:damage_tracking = 0 changes nothing), the sdl backend (worse), and
#    gpu-screen-recorder, which captures the same monitor non-stop over KMS and
#    never triggers it. There is no upstream report of this and no fix; dropping
#    the flag is the fix.
#
# 2. It is INCOMPATIBLE with the HUD: mangoapp is an X11 client, so under
#    --expose-wayland it segfaults in libX11 the instant it starts. gamescope's
#    reaper then restarts it, and it crashes again, about four times a second
#    for as long as the game runs -- each crash writing a 2.8 MB core dump to
#    /var/lib/systemd/coredump. One session left 10716 of them behind. That I/O
#    storm runs alongside the game and stutters it, so the overlay meant to
#    diagnose stuttering was causing it. Upstream:
#    https://github.com/flightlessmango/MangoHud/issues/1741
#
# Almost nothing is lost by leaving it off: games under Proton run through
# XWayland inside gamescope either way, so it only ever mattered for native
# Wayland games. Turn it on per game with GS_WAYLAND=1 if one of those needs it,
# and do not share your screen while it is on.
#
# It is also incompatible with mangoapp, which now runs for every game (see the
# HUD section below), so GS_WAYLAND is the one that gives way: a native Wayland
# game that needs it can turn the HUD off with GS_HUD=off.
if [[ ${GS_WAYLAND:-0} == 1 ]]; then
    if [[ ${GS_HUD:-0} != off ]]; then
        echo "gs: mangoapp needs X11, ignoring GS_WAYLAND (use GS_HUD=off to force it)" >&2
    else
        args+=( --expose-wayland )
    fi
fi

# Hands frame pacing to gamescope instead of the game. Some engines -- Elden
# Ring is the notorious one -- have a frame limiter that misbehaves whenever a
# frame comes in under 16.67 ms, throwing frametime spikes even with the
# in-game vsync switched off. Capping outside the game keeps it away from that
# path.
#
# CAREFUL: gamescope's --framerate-limit is a DIVISOR of the refresh rate, not
# a free-form cap. It only reaches rates that divide the output evenly, so the
# output rate has to be chosen to suit: GS_HZ=120 GS_FPS=60 gives an exact 60,
# while asking for 60 out of a 165 Hz output cannot be expressed.
if [[ -n ${GS_FPS:-} ]]; then
    args+=( --framerate-limit "$GS_FPS" )
fi

[[ ${GS_VRR:-0}  == 1 ]] && args+=( --adaptive-sync )
# --force-grab-cursor is NOT on by default. It forces relative mouse mode
# permanently instead of letting gamescope switch depending on whether the
# game draws a cursor. With it on, during loading and the intro the mouse is
# captured but nothing draws it: it looks stuck until the game menu appears.
# Only turn it on if the mouse escapes to the portrait monitor in some game.
[[ ${GS_GRAB:-0} == 1 ]] && args+=( --force-grab-cursor )

# ---- The HUD is always loaded, and starts hidden ----
# mangoapp runs for EVERY game now, because MangoHud's toggle_hud keybind can
# only show something that is already running -- with mangoapp launched on
# demand there was nothing for Shift_R+F12 to toggle, and seeing the frametimes
# meant quitting, editing the launch options and starting the game again.
#
# It comes up invisible: `no_display` lives in MangoHud.conf, so the default
# costs a hidden process and nothing on screen. GS_HUD=1 starts it visible,
# through MANGOHUD_CONFIG rather than a second config file, since MangoHud
# takes `some_parameter=0` to switch an on/off parameter back off.
#
# GS_HUD=off is the escape hatch: no mangoapp at all, which is what a native
# Wayland game needs before GS_WAYLAND=1 can do anything.
if [[ ${GS_HUD:-0} != off ]]; then
    args+=( --mangoapp )
    [[ ${GS_HUD:-0} == 1 ]] && \
        export MANGOHUD_CONFIG="${MANGOHUD_CONFIG:+$MANGOHUD_CONFIG,}no_display=0"
fi

# ---- The Steam overlay does not belong inside gamescope ----
# Steam preloads gameoverlayrenderer.so into whatever it launches, and what it
# launches here is THIS SCRIPT, so the overlay ends up inside gamescope. It can
# only draw itself in a process that presents through a Vulkan swapchain, which
# gamescope is not, so it never draws anything -- it just stays resident,
# driving its interposed Xlib event hooks against gamescope's nested Xwayland
# for as long as the game runs. That is the long-standing "everything turns to
# treacle after half an hour" bug, gamescope #697, open since 2022 and fixed
# upstream on 2026-08-13 by commit e399345 (PR #2308), whose own message names
# it as "building into the stutter reported after half an hour of play".
#
# Confirmed here rather than assumed: gameoverlayrenderer.so was mapped four
# times in a running gamescope, and its LD_PRELOAD read
#   libgamemodeauto.so.0:.../ubuntu12_32/gameoverlayrenderer.so
#                        :.../ubuntu12_64/gameoverlayrenderer.so
#
# Arch ships 3.16.25, which predates the fix, so it is done here instead --
# same idea as upstream's: strip the overlay from what gamescope inherits and
# hand the original value back to the game, where the overlay works properly.
#
# THE IN-GAME OVERLAY SURVIVES THIS, and for Proton games it would survive even
# without the env below: pressure-vessel injects the overlay into the container
# itself with its own --ld-preload flags, which owe nothing to gamescope's
# environment. Verified the same way -- four mappings inside the game process.
# The env is there for native games, which have no container to re-add it.
#
# This is why the blunt LD_PRELOAD="" workaround costs people Steam Input,
# recording and the overlay: it strips the library from the whole chain instead
# of only from the process that cannot use it.
GAME_LD_PRELOAD="${LD_PRELOAD:-}"
inner=()

if [[ ${GS_OVERLAY:-0} != 1 && -n $GAME_LD_PRELOAD ]]; then
    # Filtered in the shell rather than through `tr | grep | paste`, and the
    # difference is not style. THE COMMON CASE STRIPS EVERY ENTRY: what Steam
    # hands this script is the two gameoverlayrenderer.so paths and nothing
    # else, so grep matched nothing, exited 1, and under `set -o pipefail`
    # with `set -e` that killed gs before it launched anything -- silently,
    # since a game that never starts prints no error of its own. The first
    # version survived testing only because every LD_PRELOAD it was given also
    # held libgamemodeauto.so.0, which outlived the filter and kept grep at 0.
    #
    # Entries are colon-separated, but the loader also accepts spaces, so both
    # are separators here.
    stripped=""
    IFS=': ' read -ra preload_entries <<< "$GAME_LD_PRELOAD"
    for entry in ${preload_entries[@]+"${preload_entries[@]}"}; do
        [[ -z $entry ]] && continue
        [[ $entry == *gameoverlayrenderer.so ]] && continue
        stripped+="${stripped:+:}$entry"
    done

    if [[ $stripped != "$GAME_LD_PRELOAD" ]]; then
        export LD_PRELOAD="$stripped"
        inner=( env "LD_PRELOAD=$GAME_LD_PRELOAD" )
        echo "gs: Steam overlay kept out of gamescope, handed to the game (gamescope #697)" >&2
    fi
fi

# ---- gamemode ----
# gamemoderun goes OUTSIDE, wrapping gamescope. Put inside, it ends up in the
# pressure-vessel container, where it cannot find libgamemode.so and fails
# silently ("gamemodeauto: dlopen failed" in the Steam log). Since gamescope
# is a host process and gamemode's changes are system-wide (CPU governor,
# priorities), the effect on the game is the same.
#
# One gamemode feature has to stay off for games to survive this: core pinning.
# See gamemode.ini, which sets pin_cores=no and explains why.
outer=()
if [[ ${GS_GAMEMODE:-1} == 1 ]] && command -v gamemoderun >/dev/null; then
    outer+=( gamemoderun )
fi

# shellcheck disable=SC2086  # inner may be empty, hence the +expansion guard
launch "${outer[@]}" gamescope "${args[@]}" -- ${inner[@]+"${inner[@]}"} "$@"
