#!/usr/bin/env bash
# =============================================================
#  gs — game launcher for Steam on Hyprland / Wayland
#
#  Usage in Steam:  Game properties -> Launch options:
#
#      ~/.local/bin/gs -- %command%
#
#  Wraps the game in gamescope, which presents it with ONE single virtual
#  "monitor" of 2560x1440@165. The game never sees the two-screen setup (one
#  of them portrait), so it can no longer get the resolution wrong or open in
#  a tiny window.
#
#  Environment variables to tune per game (they go IN FRONT in the launch
#  options, e.g.:  GS_W=1920 GS_H=1080 gs -- %command%)
#
#    GS_OUT_W / GS_OUT_H  Real output resolution      (def. the monitor you are on)
#    GS_HZ                Refresh rate / FPS cap      (def. that monitor's refresh rate)
#    GS_W / GS_H          Internal render resolution; if lower than the
#                         output one, gamescope upscales with FSR.
#                         E.g. GS_W=1920 GS_H=1080 -> renders at 1080p and
#                         scales to 1440p. A good trick for heavy games.
#    GS_FSR               Scaling filter: fsr | nis | linear | nearest
#    GS_FPS               Framerate cap, applied by gamescope rather than the
#                         game. Must divide GS_HZ evenly, e.g.
#                         GS_HZ=120 GS_FPS=60.
#    GS_HUD=1             FPS overlay (MangoHud inside gamescope)
#    GS_WAYLAND=1         Native Wayland games talk to gamescope directly
#                         (--expose-wayland). Off by default: it breaks screen
#                         sharing and the HUD. See the note further down.
#    GS_VRR=1             Enables adaptive sync / FreeSync
#    GS_GRAB=1            Forces permanent relative mouse mode. Only if the
#                         mouse escapes to the other monitor. It makes the
#                         cursor look stuck while the game loads.
#    GS_GAMEMODE=0        Disables gamemoderun
#    GS_OFF=1             Skips gamescope entirely (native Wayland game)
# =============================================================
set -euo pipefail

# Steam passes "gs -- <command>"; swallow the leading --.
[[ ${1:-} == "--" ]] && shift

if [[ $# -eq 0 || ${1:-} == "--help" || ${1:-} == "-h" ]]; then
    # Up to the closing rule rather than to a hardcoded line number, which
    # silently swallowed the last variables as soon as one was added above.
    sed -n '2,/^# =\+$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

# ---- NVIDIA / Proton settings common to every game ----
# Persistent shader cache: fewer stutters the second time you play.
export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
export __GL_SHADER_DISK_CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/nv"
mkdir -p "$__GL_SHADER_DISK_CACHE_PATH"

# DLSS / Reflex / Frame Generation on the 5070 via dxvk-nvapi.
export PROTON_ENABLE_NVAPI=1
# Ray tracing in DX12 games.
export VKD3D_CONFIG="${VKD3D_CONFIG:-dxr11,dxr}"

# ---- Exit without gamescope (native games that already behave) ----
if [[ ${GS_OFF:-0} == 1 ]]; then
    if [[ ${GS_GAMEMODE:-1} == 1 ]] && command -v gamemoderun >/dev/null; then
        exec gamemoderun "$@"
    fi
    exec "$@"
fi

if ! command -v gamescope >/dev/null; then
    echo "gs: gamescope is not installed, launching the game as is" >&2
    exec "$@"
fi

# If Steam is already running inside a gamescope session (steam-gamescope),
# adding another gamescope per game nests it on itself: worse performance,
# odd input and a broken overlay. In that case do nothing and let the game
# through.
if [[ -n ${GAMESCOPE_WAYLAND_DISPLAY:-} ]]; then
    echo "gs: already inside gamescope, not nesting another one" >&2
    if [[ ${GS_GAMEMODE:-1} == 1 ]] && command -v gamemoderun >/dev/null; then
        exec gamemoderun "$@"
    fi
    exec "$@"
fi

# ---- Building the gamescope command line ----
# The virtual output defaults to the monitor you are actually on, queried from
# the compositor. It used to default to 2560x1440@165, which is this machine
# and nothing else: on any other screen gamescope would have been handed a
# resolution the display cannot show, and the literals are wrong in a way you
# only find out when a game comes up letterboxed or refuses the mode.
#
# The fallback keeps the old numbers for the case there is no compositor to
# ask -- running this from a TTY, or from a session that is not Hyprland.
monitor_mode() {
    hyprctl monitors -j 2>/dev/null \
        | jq -r 'map(select(.focused))[0] // .[0]
                 | "\(.width) \(.height) \(.refreshRate | round)"' 2>/dev/null
}
read -r DEF_W DEF_H DEF_HZ < <(monitor_mode) || true
[[ ${DEF_W:-null} == null || -z ${DEF_W:-} ]] && { DEF_W=2560; DEF_H=1440; DEF_HZ=165; }

OUT_W="${GS_OUT_W:-$DEF_W}"
OUT_H="${GS_OUT_H:-$DEF_H}"
HZ="${GS_HZ:-$DEF_HZ}"

args=(
    -W "$OUT_W" -H "$OUT_H"   # virtual monitor resolution = real output
    -r "$HZ"                  # refresh rate (also acts as an FPS cap)
    -f                        # start fullscreen. ALWAYS.
)

# CAREFUL with -e / --steam: do NOT set it by default. In a session nested
# inside Hyprland it makes gamescope create no window at all: the game starts,
# renders and plays sound, but nothing is visible. That flag is for when
# gamescope IS the session compositor (Steam Deck mode), not for launching
# individual games.
[[ ${GS_STEAM:-0} == 1 ]] && args+=( -e )

# Lower internal render resolution + FSR upscaling
if [[ -n ${GS_W:-} && -n ${GS_H:-} ]]; then
    args+=( -w "$GS_W" -h "$GS_H" -F "${GS_FSR:-fsr}" )
fi

# --expose-wayland lets native Wayland games talk to gamescope directly instead
# of going through the XWayland inside it. It is OPT-IN, and it used to be the
# default. Two separate things make it a bad default:
#
# 1. It BREAKS SCREEN SHARING. With --expose-wayland, sharing the screen through
#    the desktop portal (Discord, a browser, OBS) makes the game stick on your
#    own monitor: either a frozen frame pasted over the live game with a narrow
#    strip still repainting, or the whole thing crawling as if it ran at 1 fps
#    while the game is really pushing 165. Stopping the share clears it
#    instantly. Found on 2026-08-12 with Kingdom Come: Deliverance 2, after
#    ruling out, each by measurement: direct scanout (directScanoutTo read 0
#    while already frozen), the portal's own settings (both force_shm and
#    monitor-vs-window capture change nothing), damage tracking
#    (debug:damage_tracking = 0 changes nothing), the sdl backend (worse), and
#    gpu-screen-recorder, which captures the same monitor non-stop over KMS and
#    never triggers it. There is no upstream report of this and no fix; dropping
#    the flag is the fix.
#
# 2. It is INCOMPATIBLE with the HUD: mangoapp is an X11 client, so under
#    --expose-wayland it segfaults in libX11 the instant it starts. gamescope's
#    reaper then restarts it, and it crashes again, about four times a second
#    for as long as the game runs -- each crash writing a 2.8 MB core dump to
#    /var/lib/systemd/coredump. One session left 10716 of them behind. That I/O
#    storm runs alongside the game and stutters it, so the overlay meant to
#    diagnose stuttering was causing it. Upstream:
#    https://github.com/flightlessmango/MangoHud/issues/1741
#
# Almost nothing is lost by leaving it off: games under Proton run through
# XWayland inside gamescope either way, so it only ever mattered for native
# Wayland games. Turn it on per game with GS_WAYLAND=1 if one of those needs it,
# and do not share your screen while it is on.
if [[ ${GS_WAYLAND:-0} == 1 ]]; then
    if [[ ${GS_HUD:-0} == 1 ]]; then
        echo "gs: HUD on, ignoring GS_WAYLAND (mangoapp needs X11)" >&2
    else
        args+=( --expose-wayland )
    fi
fi

# Hands frame pacing to gamescope instead of the game. Some engines -- Elden
# Ring is the notorious one -- have a frame limiter that misbehaves whenever a
# frame comes in under 16.67 ms, throwing frametime spikes even with the
# in-game vsync switched off. Capping outside the game keeps it away from that
# path.
#
# CAREFUL: gamescope's --framerate-limit is a DIVISOR of the refresh rate, not
# a free-form cap. It only reaches rates that divide the output evenly, so the
# output rate has to be chosen to suit: GS_HZ=120 GS_FPS=60 gives an exact 60,
# while asking for 60 out of a 165 Hz output cannot be expressed.
if [[ -n ${GS_FPS:-} ]]; then
    args+=( --framerate-limit "$GS_FPS" )
fi

[[ ${GS_VRR:-0}  == 1 ]] && args+=( --adaptive-sync )
# --force-grab-cursor is NOT on by default. It forces relative mouse mode
# permanently instead of letting gamescope switch depending on whether the
# game draws a cursor. With it on, during loading and the intro the mouse is
# captured but nothing draws it: it looks stuck until the game menu appears.
# Only turn it on if the mouse escapes to the portrait monitor in some game.
[[ ${GS_GRAB:-0} == 1 ]] && args+=( --force-grab-cursor )
[[ ${GS_HUD:-0}  == 1 ]] && args+=( --mangoapp )

# ---- gamemode ----
# gamemoderun goes OUTSIDE, wrapping gamescope. Put inside, it ends up in the
# pressure-vessel container, where it cannot find libgamemode.so and fails
# silently ("gamemodeauto: dlopen failed" in the Steam log). Since gamescope
# is a host process and gamemode's changes are system-wide (CPU governor,
# priorities), the effect on the game is the same.
#
# One gamemode feature has to stay off for games to survive this: core pinning.
# See gamemode.ini, which sets pin_cores=no and explains why.
outer=()
if [[ ${GS_GAMEMODE:-1} == 1 ]] && command -v gamemoderun >/dev/null; then
    outer+=( gamemoderun )
fi

exec "${outer[@]}" gamescope "${args[@]}" -- "$@"
