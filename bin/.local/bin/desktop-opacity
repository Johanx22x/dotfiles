#!/usr/bin/env bash
# =============================================================
#  desktop-opacity — one transparency for the whole desktop
#
#  Every translucent surface on this machine used to carry its own number,
#  tuned on its own: the shell's bar at 0.85, kitty at 0.70, Zen's sidebar at
#  0.85, Nautilus at 0.82 through a Hyprland rule. Four files, four dials, and
#  no way to say "a bit more solid" without editing all of them.
#
#  This is that one dial. The settings window (SUPER + C) calls it; so can you:
#
#      desktop-opacity 0.75     set it
#      desktop-opacity          print the current value
#
#  WHAT IT TOUCHES, and how each one takes it:
#
#    the shell     ~/.local/state/quickshell/.../config.json, owned by the
#                  settings window. NOT written here -- the shell already has
#                  the value before this script runs, which is why the bar
#                  changes before the terminal does.
#    kitty         ~/.config/kitty/opacity.conf, included last by kitty.conf.
#                  SIGUSR1 makes running windows re-read it. INSTANT.
#    Nautilus      a window rule, and how it is delivered is the one thing that
#                  depends on the compositor: Hyprland takes it through
#                  `hyprctl eval`, niri takes it as ~/.config/niri/opacity.kdl,
#                  which it reloads on save. Either way it applies to windows
#                  opened from then on.
#    Zen           ~/.zen/rice/chrome/opacity.css, imported by userChrome.css.
#                  NEEDS A RESTART: userChrome is read once at startup, and
#                  fx-autoconfig -- the way to get live reload -- was
#                  deliberately not installed. See the top of userChrome.css.
#
#  NONE of the generated files is in the dotfiles repo -- kitty's opacity.conf,
#  Zen's opacity.css and niri's opacity.kdl. They are generated state, same as
#  kitty's colors.conf and the shell's colors.json, and the config files that
#  include them are the ones under version control.
# =============================================================
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/desktop-opacity"
KITTY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/opacity.conf"
ZEN_FILE="$HOME/.zen/rice/chrome/opacity.css"
NIRI_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/niri/opacity.kdl"

# Found NEXT TO THIS SCRIPT and not through $PATH: this is called by the
# settings window in Quickshell, whose environment is the compositor's rather
# than a login shell's, and ~/.local/bin is not always on it. readlink resolves
# the stow symlink back into the repo, so the helper is found whether this was
# started from ~/.local/bin or straight out of the checkout -- and a
# `compositor` that could not be run would look exactly like "no compositor",
# which is the silent failure this whole helper exists to stop.
BIN_DIR="$(dirname "$(readlink -f "$0")")"
compositor() { "$BIN_DIR/compositor" "$@"; }

# The floor is not taste, it is legibility: below 0.40 small text over a bright
# wallpaper stops being readable however much blur is behind it. 1.00 is fully
# opaque, which is a legitimate answer -- it is how you turn the effect off.
MIN=0.40
MAX=1.00
DEFAULT=0.85

# Windows whose transparency belongs to the compositor rather than to
# themselves: libadwaita paints its background opaque and user CSS cannot ask it
# for an alpha, so somebody outside the application has to.
#
# ONE spelling for both compositors, which works out only because neither needs
# escaping the other does not: these go into a Hyprland rule and into a niri KDL
# raw string, and a raw string is verbatim. Hyprland calls the field `class` and
# niri calls it `app-id`; the value is the same regex.
#
# They have to keep matching what hyprland.lua and niri/config.kdl already
# match, or the rule written here would stack on top of that one instead of
# replacing it.
GTK_CLASSES=(
  '^org\.gnome\.Nautilus$'
)

die() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }
note() { printf '  %s\n' "$*"; }

current() {
  [[ -r "$STATE_FILE" ]] && cat "$STATE_FILE" || printf '%s\n' "$DEFAULT"
}

if (( $# == 0 )); then
  current
  exit 0
fi

value="$1"

# Validated with awk and not with a bash pattern: this has to reject "0.9.9"
# and ".8." as well as letters, and it has to compare against the range, which
# bash cannot do with decimals at all.
awk -v v="$value" -v lo="$MIN" -v hi="$MAX" 'BEGIN {
  if (v !~ /^[0-9]*\.?[0-9]+$/) exit 1
  if (v + 0 < lo || v + 0 > hi) exit 2
}' || {
  code=$?
  (( code == 1 )) && die "Not a number: '$value'"
  die "Out of range: $value (expected $MIN to $MAX)"
}

# Normalised to two decimals so the file always looks the same, whatever the
# caller passed in -- "0.8", ".80" and "0.800" all land as 0.80.
value=$(awk -v v="$value" 'BEGIN { printf "%.2f", v }')

mkdir -p "$STATE_DIR"
printf '%s\n' "$value" > "$STATE_FILE"
printf 'Desktop opacity: %s\n' "$value"

# ---------------------------------------------------------------------------
# kitty
#
# The write comes first and the signal second: a window that reloads before
# the file is there would read the old value and nothing would tell it to try
# again.
if [[ -d "$(dirname "$KITTY_FILE")" ]]; then
  cat > "$KITTY_FILE" <<EOF
# Generated by desktop-opacity. Do not edit: the settings window rewrites it.
background_opacity $value
EOF
  if pkill -SIGUSR1 -x kitty 2>/dev/null; then
    note "kitty: reloaded"
  else
    note "kitty: nothing running, next window picks it up"
  fi
fi

# ---------------------------------------------------------------------------
# Zen
#
# The file is written even when Zen is not running -- it is read at the next
# startup either way, and skipping the write would mean the value silently
# reverting the day the browser is opened.
if [[ -d "$(dirname "$ZEN_FILE")" ]]; then
  cat > "$ZEN_FILE" <<EOF
/* Generated by desktop-opacity. Do not edit: the settings window rewrites it.

   Imported by userChrome.css, which no longer sets this variable itself.
   !important because the pref's own media query sets it, and only importance
   beats a media query -- the long note in userChrome.css has the rest. */
:root {
  --zen-background-opacity: $value !important;
}
EOF
  # zen-bin and not zen: the binary in /opt/zen-browser-bin is what runs, and
  # `pgrep -x zen` matches nothing -- which made this print "applies at next
  # start" with the browser open in front of it.
  if pgrep -x zen-bin >/dev/null 2>&1; then
    note "Zen: written, but it needs a RESTART to be read"
  else
    note "Zen: written, applies at next start"
  fi
fi

# ---------------------------------------------------------------------------
# The compositor
#
# Asked as a CAPABILITY and not by name -- `window-rules` means "rules can be
# changed in the running compositor", which is the thing this branch actually
# depends on. The niri branch below is the exception the helper's own header
# allows: it is not asking whether it can do something, it is asking which file
# to write, and only the name can answer that.
#
# ---- Hyprland: THROUGH `eval`, AND ONLY THROUGH `eval`.
#
# The first version of this used `hyprctl keyword windowrule ...` plus
# `hyprctl setprop ... alpha`, which is what every guide on the internet says,
# and NEITHER works on this machine:
#
#   $ hyprctl keyword general:border_size 2
#   keyword can't work with non-legacy parsers. Use eval.
#   $ hyprctl setprop address:0x0 alpha 0.85
#   unknown request
#
# The config here is Lua rather than hyprlang, and Hyprland disables the whole
# keyword path when it is. Worse, both commands exit 0 while refusing, so the
# script cheerfully reported success for a rule it had never applied. The same
# discovery is already written down at wallpaper-switch:141, which reaches for
# `hyprctl eval` to push the border colour for exactly this reason.
#
# WHAT THIS DOES AND DOES NOT DO. The rule lands immediately and applies to
# windows opened from here on. Measured: a window already on screen keeps the
# alpha it was mapped with. Reopening it, or `hyprctl reload` (which re-runs
# hyprland.lua, and that reads the state file written above), picks up the new
# value -- so nothing is lost, it just is not instant for that one case.
if compositor can window-rules && command -v hyprctl >/dev/null; then
  for class in "${GTK_CLASSES[@]}"; do
    # Doubled backslashes: the class regexes above are written for hyprlang,
    # and this passes them through a Lua string literal on the way.
    lua_class="${class//\\/\\\\}"
    hyprctl eval "hl.window_rule({
      name = 'desktop-opacity',
      match = { class = '$lua_class' },
      opacity = '$value $value',
    })" >/dev/null
  done
  note "Hyprland: rule set for ${#GTK_CLASSES[@]} class(es), applies to new windows"

# ---- niri: BY WRITING THE FILE, because there is nothing to push it into.
#
# niri has no `hyprctl eval` and no runtime rule editing at all (which is why
# `compositor can window-rules` says no for it). What it does have is a config
# it watches, includes and all, so writing this file IS applying it -- there is
# no reload step to forget, and adding one would only be a way to get it wrong.
#
# The file is pulled in by an `include` near the end of niri/config.kdl, placed
# after every rule in it on purpose: niri applies all the rules that match and
# the last one to set a property wins, so this has to be the last word on
# opacity or the 0.82 literal in the Nautilus rule would beat it.
#
# TWO DIFFERENCES FROM THE HYPRLAND BRANCH ABOVE, both of them measured:
#   - the regex goes in a KDL raw string, r#"..."#, which is verbatim. No
#     doubled backslashes -- that is a Lua-literal problem and it does not
#     exist here.
#   - `opacity` takes ONE number. Hyprland's takes the active/inactive pair.
elif compositor is niri; then
  mkdir -p "$(dirname "$NIRI_FILE")"
  {
    printf '// Generated by desktop-opacity. Do not edit: the settings window\n'
    printf '// rewrites it. Included from config.kdl, and niri watches every file\n'
    printf '// it includes, so saving this is what applies it.\n'
    for class in "${GTK_CLASSES[@]}"; do
      printf '\nwindow-rule {\n'
      printf '    match app-id=r#"%s"#\n' "$class"
      printf '    opacity %s\n' "$value"
      printf '}\n'
    done
  } > "$NIRI_FILE"
  note "niri: rule written for ${#GTK_CLASSES[@]} app-id(s), applies to new windows"

else
  # Said out loud rather than skipped in silence: everything above this point
  # applied, so the run looks like a success, and the one surface that needs a
  # compositor listening would have been the only thing missing from it.
  note "compositor: nothing to tell (none running, or one with no window rules)"
fi
