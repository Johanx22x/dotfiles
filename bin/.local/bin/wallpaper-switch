#!/usr/bin/env bash
# wallpaper-switch - change the wallpaper and regenerate the accent palette
#
#   wallpaper-switch next     next one in the collection (alphabetical)
#   wallpaper-switch prev     previous one
#   wallpaper-switch random   a random one (different from the current)
#   wallpaper-switch set PATH a specific one
#   wallpaper-switch reapply  reapply the current one (handy after editing templates)
#   wallpaper-switch still    freeze the current one to a still frame (see below)
#   wallpaper-switch dir      print the collection's folder
#   wallpaper-switch dir PATH use a different folder from now on
#   wallpaper-switch thumbs   pre-build the thumbnail of every wallpaper, plus
#                             the still frame and preview clip of every video
#
# The collection lives in ~/Pictures/wallpapers unless told otherwise. WHERE
# THAT IS TOLD is a state file, ~/.local/state/wallpaper-dir, and not this
# script: the folder is one person's answer on one machine, and this file is
# shared with another. The WALLPAPER_DIR environment variable still wins over
# both, for a one-off run against some other folder.
#
# ---- Two backends, one entry point ----
# A still goes to awww and a video goes to mpvpaper, and which one runs is
# decided here from the file extension rather than by the caller. Every way of
# changing the wallpaper -- the keybind, the rotation timer, the carousel, the
# settings page -- already goes through this script because it is what
# regenerates the palette as well; making the caller also pick a backend would
# have been four places to teach about videos instead of one.
#
# Animated GIFs are NOT videos here. awww decodes them itself ("Sends an image
# (or animated gif)", per its own --help), so they take the still path and keep
# the transitions, and matugen reads a GIF directly -- verified, unlike mp4,
# which makes it panic on an unsupported format.

set -uo pipefail

DIR_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper-dir"
DEFAULT_DIR="$HOME/Pictures/wallpapers"

# Precedence, highest first: the environment, the state file, the default.
# The environment comes first so a single run can be pointed elsewhere without
# changing what every other run does.
# Remembered because the CACHE SWEEP has to know: a run pointed somewhere else
# by the environment must not decide what the caches of the real collection are
# allowed to keep. See the sweep in the `thumbs` mode.
DIR_FROM_ENV="${WALLPAPER_DIR:-}"

if [[ -z "${WALLPAPER_DIR:-}" && -r "$DIR_STATE" ]]; then
    WALLPAPER_DIR="$(<"$DIR_STATE")"
fi
WALLPAPER_DIR="${WALLPAPER_DIR:-$DEFAULT_DIR}"
STATE_FILE="$HOME/.cache/wallpaper-current"
MODE="${1:-next}"

# ---- Transition ----
# Types: none simple fade left right top bottom wipe wave grow center any outer random
# They can be overridden from the environment, e.g.:
#   TRANSITION_TYPE=wave wallpaper-switch next
TRANSITION_TYPE="${TRANSITION_TYPE:-fade}"
TRANSITION_DURATION="${TRANSITION_DURATION:-1.4}"

# Only applies to 'fade': the curve controlling the acceleration of the
# dissolve. This one starts and ends smoothly (ease-in-out).
# For a linear dissolve use 0.0,0.0,1.0,1.0
TRANSITION_BEZIER="${TRANSITION_BEZIER:-.42,0,.58,1}"

# ---- Video ----
# Options handed to mpv. no-audio is not a preference: a wallpaper that makes
# noise is a wallpaper nobody keeps. panscan=1.0 crops to fill the screen,
# which is what awww does by default for stills, so a video and an image frame
# the same way. hwdec=auto puts the decoding on the GPU -- the whole reason for
# a separate process instead of decoding inside the shell.
#
# --input-ipc-server is what lets `still` freeze THE FRAME THAT IS ON SCREEN
# rather than a fixed one: see capture_live_frame below. mpv only listens on a
# socket if it is told to at startup, so the option has to be here, not at the
# moment the frame is wanted.
IPC_SOCKET="${MPVPAPER_IPC:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mpvpaper.sock}"
MPV_OPTIONS="${MPV_OPTIONS:---no-audio --loop-file=inf --panscan=1.0 --hwdec=auto --input-ipc-server=$IPC_SOCKET}"

# -p pauses when the wallpaper is covered and -a FULL extends that to any
# fullscreen window. FULL and not MAX because this is a tiling compositor: MAX
# also triggers on maximized windows, which here is most windows most of the
# time, and a wallpaper paused whenever you are using the computer is a still
# image with extra steps.
MPVPAPER_FLAGS="${MPVPAPER_FLAGS:--p -a FULL}"

# Every monitor. Named outputs go here if the two ever want different videos.
MPVPAPER_OUTPUT="${MPVPAPER_OUTPUT:-ALL}"

# ---- What counts as a wallpaper ----
# One list, used by the collection scan, by the folder count and by the
# backend dispatch. It was two copies of five extensions inside two `find`
# calls, which is exactly the kind of thing that gets updated in one place.
#
# KEEP IN STEP with wallpaperStillExtensions / wallpaperVideoExtensions in
# ~/.config/quickshell/Config.qml, which is the same list on the other side.
# The shell reads the folder itself through Qt and has no way to ask a script
# what it accepts, so the duplication is down to two copies and not four --
# the carousel and the settings page both read Config's.
STILL_EXT=(jpg jpeg png webp bmp gif)
VIDEO_EXT=(mp4 webm mkv)

# A still frame per video, extracted once and reused: matugen needs one to
# build the palette, and the carousel needs one to draw a card that is not
# moving. Two consumers, one cache, so a video is never decoded twice for the
# same frame.
FRAME_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-frames"

# A SMALL COPY OF EACH STILL, for the carousel to draw.
#
# WHY A PICTURE NEEDS A CACHE AT ALL. These wallpapers are 4K and about half of
# them are PNG, which has no scaled decoding: asked for a 960 px thumbnail of
# one, Qt decodes all 8.3 million pixels and then throws most of them away.
# Measured at 170 to 220 ms and some 35 MB per image -- and the carousel builds
# a card every time one slides into the fan, so that is the price of a single
# press of the arrow key. Against a 960 px JPEG it is about 5 ms and 1.5 MB.
#
# JPEG AND NOT PNG even for wallpapers that came as PNG: this is a thumbnail of
# a photograph, quality 4 is indistinguishable at this size, and it keeps the
# whole cache for sixty-odd wallpapers around 5 MB.
#
# THE WIDTH IS THE PREVIEW'S WIDTH, for the reason spelled out under
# PREVIEW_WIDTH: it is the widest a card gets on a 1440p screen, and a 4K
# monitor upscales it rather than every other monitor paying for that one.
#
# NOT rounded, and not cropped to the shape of the card. The carousel crops to
# whatever monitor it is on -- a card is a scale model of the screen -- and it
# cuts the corners itself with one shared mask. Baking either into the file
# would tie the cache to one monitor.
THUMB_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-thumbs"
THUMB_WIDTH="${WALLPAPER_THUMB_WIDTH:-960}"

# A NUMBERED RUN OF JPEGs PER VIDEO, for the carousel to flip through.
#
# WHY NOT JUST PLAY THE WALLPAPER ITSELF. The collection is 4K -- one of these
# files is 4K at 120 fps and 40 Mbit/s -- and the carousel draws five cards at
# once, the largest of them under a thousand pixels wide. Playing the originals
# means five 4K decoders running to fill five thumbnails: measured at about
# two thirds of a core EACH, before any of them has been scaled down.
#
# WHY NOT A SMALL VIDEO EITHER, which is what this cache used to hold: a 960x540
# clip at 24 fps, played by a QtMultimedia MediaPlayer on the centred card. The
# clip was not the problem. The PLAYER was, and on this hardware specifically.
# Measured on an RTX 5070 (driver 610.57.04) against these very wallpapers:
#
#   * A MediaPlayer costs the same whatever you feed it. One playing a 960x540
#     24 fps clip and one playing a 480x270 15 fps clip both cost 9.8% of a
#     core. Shrinking the clip further bought nothing at all.
#   * The cost is a CUDA context. qt6-multimedia-ffmpeg picks NVDEC here, and
#     the two `cuda-EvtHandlr` threads that come with it burn a flat 3.2% of a
#     core doing no decoding, plus 412 MB of VRAM for as long as a player
#     exists. On Intel or AMD this would be VA-API and those threads would not
#     be there -- the tax is specific to this machine.
#   * Building or destroying one costs 250 to 466 ms, and a third of that lands
#     on the GUI thread. That was the whole of "it sticks when I move through
#     the videos": stepping through the fan created and tore down a decoder per
#     step, 6.7% of frames arrived late, and the process sat at 65% of a core.
#     Re-pointing an existing player at another file is just as expensive --
#     Qt rebuilds the decoder either way.
#
# So the carousel no longer decodes video at all. It flips an Image through a
# run of numbered JPEGs on a timer, which costs the same as the MediaPlayer did
# at rest (9.7% of a core against 9.8%), half the memory (311 MB against 622),
# no VRAM, no CUDA context, and -- the point of the exercise -- no stall at all
# when you step through the fan.
#
# THE NUMBERS, and what each of them is paying for:
#
#   WIDTH    960, unchanged, and for the reason it always was: it is the widest
#            a card gets on a 1440p screen. A frame wider than the card it is
#            drawn in is pixels decoded and thrown away by the scaler; a 4K
#            monitor upscales rather than every other monitor paying for it.
#   FPS      15, down from the clip's 24. These are ambient loops -- clouds,
#            rain, a character breathing -- and every frame is now a file on
#            disk rather than a delta against the one before it, so frames are
#            the thing that costs. 15 is where the motion still reads.
#   SECONDS  6, down from twelve, for the same reason. See the arithmetic
#            below: seconds are megabytes here in a way they never were in an
#            h264 clip.
#   QUALITY  8, ffmpeg's -q:v scale where 2 is best and 31 is worst. At 960 px
#            this is a photograph seen for a fifteenth of a second inside a
#            card, not something anyone inspects.
#   THREADS  4 and nice 19, because this runs while someone is using the
#            machine. Unrestrained it takes every core.
#
# WHAT IT COSTS ON DISK, because this is the one place the new design is worse
# and the number should be written down rather than discovered. An h264 clip
# spends bits only on what CHANGED between frames; a run of JPEGs pays full
# price for every one. Twelve seconds of 960x540 at 24 fps came to about 300 KB.
# Six seconds at 15 fps comes to about 2.9 MB -- ninety files of roughly 32 KB.
# Measured over the eight videos in this collection: 23 MB, against 2 MB before.
#
# That is about 2.9 MB per video per six seconds, so a longer loop is roughly
# half a megabyte per video per extra second. `WALLPAPER_PREVIEW_SECONDS=12`
# doubles both the loop and the bill; it is a knob rather than a rewrite.
PREVIEW_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-previews"
PREVIEW_WIDTH="${WALLPAPER_PREVIEW_WIDTH:-960}"
PREVIEW_FPS="${WALLPAPER_PREVIEW_FPS:-15}"
PREVIEW_SECONDS="${WALLPAPER_PREVIEW_SECONDS:-6}"
PREVIEW_QUALITY="${WALLPAPER_PREVIEW_QUALITY:-8}"
PREVIEW_THREADS="${WALLPAPER_PREVIEW_THREADS:-4}"

# The frozen frame `still` puts up, which is NOT one of those thumbnails and so
# deliberately does not live among them: `thumbs` sweeps FRAME_CACHE for PNGs
# that no longer belong to any video and would carry this one off with them.
# One file, overwritten on every freeze -- it stands for a moment, not a video.
STILL_FRAME="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-still.png"

mkdir -p "$(dirname "$STATE_FILE")"

# `die`, `warn`, `wait_until` and `compositor` come from the library beside this
# script, resolved through readlink rather than $PATH: the caller that matters
# is wallpaper-rotate.timer, and a systemd --user unit has neither ~/.local/bin
# on its PATH nor a terminal to print to. See the note on lib_notify in
# desktop-lib.sh -- half of what this file has to say went into the journal and
# nowhere else.
WS_BIN_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/desktop-lib.sh
. "$WS_BIN_DIR/../lib/desktop-lib.sh"

# The find expression for every accepted extension: -iname a -o -iname b ...
# Built rather than written out so the arrays above stay the only list.
find_expr() {
    local ext first=1
    for ext in "${STILL_EXT[@]}" "${VIDEO_EXT[@]}"; do
        (( first )) || printf '%s\0' "-o"
        printf '%s\0%s\0' "-iname" "*.$ext"
        first=0
    done
}

# Everything in a folder that this script would accept, sorted.
collect() {
    local -a expr
    mapfile -d '' -t expr < <(find_expr)
    find -L "$1" -maxdepth 2 -type f \( "${expr[@]}" \) | sort
}

is_video() {
    local ext="${1##*.}"
    ext="${ext,,}"
    local v
    for v in "${VIDEO_EXT[@]}"; do
        [[ "$ext" == "$v" ]] && return 0
    done
    return 1
}

# Path of the cached still frame for a video. The whole source path with its
# slashes flattened, not the basename: the collection is scanned two levels
# deep, so two folders can hold a "loop.mp4" and one thumbnail would end up
# standing for both.
frame_path() {
    local flat="${1#/}"
    printf '%s/%s.png' "$FRAME_CACHE" "${flat//\//_}"
}

# Extract that frame if it is missing or older than the video, and print where
# it is. Seeks two seconds in because videos so often open on black or on a
# fade -- a palette built from the first frame comes out grey for a wallpaper
# that is not. Falls back to the very beginning for anything shorter.
frame_for() {
    local src="$1" out
    out="$(frame_path "$src")"

    if [[ -f "$out" && "$out" -nt "$src" ]]; then
        printf '%s\n' "$out"
        return 0
    fi

    mkdir -p "$FRAME_CACHE"
    extract_frame "$src" "$out" '1280:-2' || return 1
    printf '%s\n' "$out"
}

# One frame of $1 written to $2, optionally through a scale filter given as $3.
# Split out of frame_for because the still wants the same seeking but at the
# video's own size, and a second copy of it would have been a second thing to
# get right.
#
# Both attempts are checked for a non-empty FILE and not for an exit code.
# Seeking past the end of a short clip is not an error to ffmpeg: it exits 0,
# having written nothing, and a bare `||` chain would take that for success and
# never try the second seek.
extract_frame() {
    local src="$1" out="$2" scale="${3:-}" seek args
    command -v ffmpeg >/dev/null || return 1
    for seek in 2 0; do
        args=(-y -loglevel error -ss "$seek" -i "$src" -frames:v 1)
        [[ -n "$scale" ]] && args+=(-vf "scale=$scale")
        ffmpeg "${args[@]}" "$out" >/dev/null 2>&1
        [[ -s "$out" ]] && return 0
    done

    # Leave no empty file behind: it would be newer than the video and so pass
    # frame_for's freshness check forever.
    rm -f "$out"
    return 1
}

# Path of the cached thumbnail for a still. Named the way the video caches are
# -- the whole source path with its slashes flattened -- so all three answer to
# the same question and none of them can confuse two files of the same basename.
thumb_path() {
    local flat="${1#/}"
    printf '%s/%s.jpg' "$THUMB_CACHE" "${flat//\//_}"
}

# Build that thumbnail if it is missing or older than the wallpaper, and print
# where it is. Checked for CONTENT and not for an exit code, like everything
# else that shells out to ffmpeg here, and an empty file is removed rather than
# left behind: it would be newer than the source and so pass the freshness test
# above for ever.
thumb_for() {
    local src="$1" out
    out="$(thumb_path "$src")"

    if [[ -f "$out" && "$out" -nt "$src" ]]; then
        printf '%s\n' "$out"
        return 0
    fi

    command -v ffmpeg >/dev/null || return 1
    mkdir -p "$THUMB_CACHE"

    # WRITTEN BESIDE ITSELF AND MOVED INTO PLACE. Encoding straight over the
    # cached file means a run that is killed halfway -- or a full disk -- takes
    # a perfectly good thumbnail with it and leaves nothing. A rename is atomic;
    # the worst case becomes "the old one is still there".
    #
    # An animated GIF is a still here -- awww animates it on the desktop -- so
    # -frames:v 1 is what stops this writing a numbered file per frame.
    nice -n 19 ffmpeg -y -loglevel error -i "$src" -frames:v 1 \
        -vf "scale=w='min($THUMB_WIDTH,iw)':h=-2" -q:v 4 "$out.part.jpg" >/dev/null 2>&1

    if [[ ! -s "$out.part.jpg" ]]; then
        rm -f "$out.part.jpg"
        return 1
    fi

    mv -f "$out.part.jpg" "$out"
    printf '%s\n' "$out"
}

# The DIRECTORY of the cached preview frames for a video. Named the same way
# the still frame is -- the whole source path with its slashes flattened -- so
# the two caches answer to the same question and neither can confuse two videos
# of the same basename. The frames inside it are 001.jpg, 002.jpg and so on.
#
# A DIRECTORY AND NOT A PREFIX, which was the other way to file ninety numbered
# files: `<flat>.001.jpg` beside its neighbours would have let sweep_cache stay
# as it is, but it also means the sweep's keep-list carries every frame of every
# video -- hundreds of paths compared against hundreds of files -- to answer a
# question one directory name already answers.
preview_path() {
    local flat="${1#/}"
    printf '%s/%s' "$PREVIEW_CACHE" "${flat//\//_}"
}

# Build those frames if they are missing or older than the video, and print the
# directory. See the note on PREVIEW_CACHE for what the numbers are for.
#
# PUBLISHED ATOMICALLY, and here that is load-bearing rather than tidy. The
# carousel finds the end of the sequence by asking for one frame past the last
# one it managed to load, so a directory caught half-written would teach it that
# the loop is however long ffmpeg had got to, and it would keep believing that
# for as long as the card lives. Frames are written into a `.part` directory and
# the whole thing is moved into place, so a directory that is visible is
# complete.
#
# THE FILE COUNT IS CHECKED, not the exit code, for the same reason
# extract_frame checks for content: ffmpeg has ways of exiting 0 having written
# nothing, and an empty directory left behind would be newer than the video and
# so pass the freshness test above forever.
#
# scale takes min(width, iw) so a video that is already smaller than the preview
# width is copied rather than blown up.
#
# IT STARTS WHERE THE STILL FRAME WAS TAKEN, two seconds in, and that is not a
# detail. Every card that is not the centred one shows the still frame, and the
# centred one shows this sequence; a card being stepped onto swaps one for the
# other. Starting both at the same second makes 001.jpg and the still the same
# picture, so the swap is invisible and no crossfade is needed to hide it. The
# same fallback as extract_frame for a clip too short to seek into, and for the
# same reason: seeking past the end is not an error to ffmpeg, it just writes
# nothing.
preview_for() {
    local src="$1" out part seek=2 duration

    out="$(preview_path "$src")"

    if [[ -d "$out" && "$out" -nt "$src" ]]; then
        printf '%s\n' "$out"
        return 0
    fi

    command -v ffmpeg >/dev/null || return 1
    mkdir -p "$PREVIEW_CACHE"

    # ONLY SHORTEN THE SEEK WHEN THE DURATION IS KNOWN AND SMALL. No ffprobe,
    # or a container that answers "N/A", used to fall through to seek 0 -- and
    # a sequence starting at zero against a still frame taken at two seconds is
    # exactly the mismatch that turns stepping onto a card into a flash.
    # Unknown means keep the seek; the empty-output check below catches a clip
    # too short for it.
    if command -v ffprobe >/dev/null; then
        duration="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$src" 2>/dev/null)"
        awk -v d="${duration:-0}" 'BEGIN { exit !(d + 0 > 0 && d + 0 < 6) }' && seek=0
    fi

    part="$out.part"
    rm -rf -- "$part"
    mkdir -p -- "$part" || return 1

    nice -n 19 ffmpeg -y -loglevel error \
        -ss "$seek" -t "$PREVIEW_SECONDS" -i "$src" \
        -an -sn -threads "$PREVIEW_THREADS" \
        -vf "scale=w='min($PREVIEW_WIDTH,iw)':h=-2,fps=$PREVIEW_FPS" \
        -q:v "$PREVIEW_QUALITY" "$part/%03d.jpg" >/dev/null 2>&1

    # A seek past the end is not an error to ffmpeg: it exits 0 having written
    # nothing. So the retry is on the DIRECTORY, and it is what covers a clip
    # whose duration could not be read.
    if [[ -z "$(ls -A -- "$part" 2>/dev/null)" && "$seek" != 0 ]]; then
        seek=0
        nice -n 19 ffmpeg -y -loglevel error \
            -ss "$seek" -t "$PREVIEW_SECONDS" -i "$src" \
            -an -sn -threads "$PREVIEW_THREADS" \
            -vf "scale=w='min($PREVIEW_WIDTH,iw)':h=-2,fps=$PREVIEW_FPS" \
            -q:v "$PREVIEW_QUALITY" "$part/%03d.jpg" >/dev/null 2>&1
    fi

    if [[ -z "$(ls -A -- "$part" 2>/dev/null)" ]]; then
        rm -rf -- "$part"
        return 1
    fi

    # `mv` cannot replace a directory the way it replaces a file -- moving onto
    # an existing one puts the source INSIDE it -- so the old sequence goes
    # first. Narrow on purpose: $out is a path this function computed inside a
    # cache directory this script owns, never anything a caller handed in.
    rm -rf -- "$out"
    mv -f -- "$part" "$out"
    printf '%s\n' "$out"
}

# Delete everything in $1 matching $2 that is not one of the paths given after
# them, and print how many went. Three caches hold one file each per wallpaper
# -- a thumbnail for every one of them, a frame and a clip for the videos -- and
# a rename orphans an entry in all of them.
#
# ONLY inside the given directory, only that one pattern, and only files the
# caller did not just vouch for. These directories belong to this script alone
# -- they are not somewhere the user keeps anything -- but a delete loop
# deserves the narrow version regardless of who owns the folder.
sweep_cache() {
    local dir="$1" pattern="$2" gone=0 cached keep
    shift 2

    if [[ -d "$dir" ]]; then
        while IFS= read -r -d '' cached; do
            for keep in "$@"; do
                [[ "$cached" == "$keep" ]] && continue 2
            done
            rm -f -- "$cached" && gone=$(( gone + 1 ))
        done < <(find "$dir" -maxdepth 1 -type f -name "$pattern" -print0)
    fi

    printf '%s\n' "$gone"
}

# The same narrowing, for a cache whose entries are DIRECTORIES rather than
# files: one per video, holding that video's numbered preview frames.
#
# A SEPARATE FUNCTION AND NOT A `-type` ARGUMENT ON THE ONE ABOVE. What makes
# sweep_cache safe to read is that every clause in it is a constant -- one
# directory, one depth, files only -- and a caller cannot widen any of them.
# Passing in the type is exactly the parameter that would let a future caller
# turn a file sweep into `rm -rf` by accident.
sweep_dirs() {
    local dir="$1" gone=0 cached keep
    shift

    if [[ -d "$dir" ]]; then
        while IFS= read -r -d '' cached; do
            for keep in "$@"; do
                [[ "$cached" == "$keep" ]] && continue 2
            done
            rm -rf -- "$cached" && gone=$(( gone + 1 ))
        done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -print0)
    fi

    printf '%s\n' "$gone"
}

# THE FRAME THAT IS ACTUALLY ON SCREEN, full size, written to $1.
#
# mpvpaper is mpv, so the picture it is showing can simply be asked for over
# mpv's JSON IPC socket. `screenshot-to-file <path> video` writes the decoded
# frame with no OSD and at the video's own resolution -- 3840x2194 for the
# wallpapers here, against the 1280 of the thumbnail cache.
#
# python3 and not socat: socat is one more package to install on every machine
# that shares these dotfiles, and python is already there. Every failure --
# no socket because mpvpaper was started without the option, no python, mpv not
# answering -- is a plain non-zero return, and the caller falls back.
capture_live_frame() {
    local out="$1"
    [[ -S "$IPC_SOCKET" ]] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    rm -f "$out"

    python3 - "$IPC_SOCKET" "$out" <<'PY' >/dev/null 2>&1 || return 1
import json, socket, sys

sock_path, out = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5)
s.connect(sock_path)
s.sendall((json.dumps({"command": ["screenshot-to-file", out, "video"]}) + "\n").encode())

# mpv interleaves unsolicited events with replies, so read until the message
# carrying an "error" field turns up -- that one is the answer to the command.
buf = b""
while True:
    chunk = s.recv(4096)
    if not chunk:
        sys.exit(1)
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        if not line.strip():
            continue
        if "error" in (msg := json.loads(line)):
            sys.exit(0 if msg["error"] == "success" else 1)
PY

    [[ -s "$out" ]]
}

# ---------------------------------------------------------------
# The folder itself, handled before anything looks inside it: asking where the
# collection is must not fail because the collection is empty, which is
# exactly what the enumeration below does.
# ---------------------------------------------------------------
if [[ "$MODE" == "dir" ]]; then
    if (( $# < 2 )); then
        printf '%s\n' "$WALLPAPER_DIR"
        exit 0
    fi

    NEW_DIR="$2"

    # "pick" opens GTK's folder chooser, the same one desktop-avatar borrows
    # for the profile picture. The dialog belongs to the script and not to the
    # settings window for the reason that keeps coming back: a shell that
    # grows its own file browser has to maintain a file browser.
    if [[ "$NEW_DIR" == "pick" ]]; then
        command -v zenity >/dev/null || die "zenity is not installed (pacman -S zenity)"
        NEW_DIR="$(zenity --file-selection --directory \
            --title="Choose the wallpaper folder" \
            --filename="$WALLPAPER_DIR/" 2>/dev/null)" || {
                echo "Cancelled."
                exit 0
            }
    fi
    # Expanded and resolved, so what is stored is what find will be given --
    # a path with a ~ in it is a directory literally called "~" to everything
    # downstream, and a relative one means whatever the caller's cwd was.
    NEW_DIR="${NEW_DIR/#\~/$HOME}"
    NEW_DIR="$(realpath -m "$NEW_DIR")"

    [[ -d "$NEW_DIR" ]] || die "not a folder: $NEW_DIR"

    mkdir -p "$(dirname "$DIR_STATE")"
    printf '%s\n' "$NEW_DIR" > "$DIR_STATE"

    COUNT=$(collect "$NEW_DIR" | wc -l)

    echo "Wallpaper folder: $NEW_DIR"
    # Said rather than treated as an error: an empty folder is a perfectly
    # reasonable thing to point at just before filling it.
    echo "  $COUNT wallpaper(s) found"
    exit 0
fi

# ---------------------------------------------------------------
# 1. Gather the collection
# ---------------------------------------------------------------
mapfile -t WALLPAPERS < <(collect "$WALLPAPER_DIR")

# EXCEPT FOR `thumbs`, which has work to do precisely when the folder is empty:
# every cached thumbnail, frame and clip in there belongs to a wallpaper that is
# no longer in the collection, and the sweep below is the only thing that ever
# collects them. Dying here left the caches orphaned for good -- megabytes of
# preview clips, not the kilobytes the frame cache used to be.
if (( ${#WALLPAPERS[@]} == 0 )) && [[ "$MODE" != "thumbs" ]]; then
    die "no wallpapers in $WALLPAPER_DIR"
fi

# ---------------------------------------------------------------
# 1b. Thumbnails and previews, on request
# ---------------------------------------------------------------
# THREE CACHES, ONE PASS. Every wallpaper gets a thumbnail, because decoding a
# 4K PNG to draw a card costs a fifth of a second. A video gets two more: a
# still frame, because an Image cannot decode an mp4 and every card that is not
# the centred one shows exactly that, and a run of numbered preview frames,
# because the centred card moves and the original is 4K at up to 120 fps.
#
# All three are named after the file they came from, all three are rebuilt when
# it is newer, and all three are swept when it goes away, so they are built
# together. The first two are files; the third is a directory per video, which
# is the only reason the sweep below needs two functions instead of one.
#
# A separate mode and not something every run does in passing: this is a
# fraction of a second of ffmpeg per still and seconds per video, and the
# rotation timer's `wallpaper-switch random` has to be over before anyone
# notices it ran. The shell calls it
# when the collection changes and then points at thumb_path(), frame_path() and
# preview_path() itself.
if [[ "$MODE" == "thumbs" ]]; then
    THUMBS=0
    MADE=0
    CLIPS=0
    KEEP_THUMBS=()
    KEEP_FRAMES=()
    KEEP_PREVIEWS=()

    for W in "${WALLPAPERS[@]}"; do
        if ! is_video "$W"; then
            THUMB="$(thumb_path "$W")"
            KEEP_THUMBS+=("$THUMB")

            if [[ ! -f "$THUMB" || ! "$THUMB" -nt "$W" ]]; then
                thumb_for "$W" >/dev/null && THUMBS=$(( THUMBS + 1 ))
            fi

            continue
        fi

        FRAME="$(frame_path "$W")"
        PREVIEW="$(preview_path "$W")"
        KEEP_FRAMES+=("$FRAME")
        KEEP_PREVIEWS+=("$PREVIEW")

        if [[ ! -f "$FRAME" || ! "$FRAME" -nt "$W" ]]; then
            frame_for "$W" >/dev/null && MADE=$(( MADE + 1 ))
        fi

        if [[ ! -d "$PREVIEW" || ! "$PREVIEW" -nt "$W" ]]; then
            preview_for "$W" >/dev/null && CLIPS=$(( CLIPS + 1 ))
        fi
    done

    # ---- Sweep ----
    # A cached file is named after the wallpaper it came from, so renaming or
    # deleting one orphans its entries and nothing would ever collect them.
    # Rename a few downloads and the caches keep a copy under each old name for
    # good -- which for the previews is megabytes, not kilobytes.
    #
    # NOT WHEN THE FOLDER CAME FROM THE ENVIRONMENT. This run vouches only for
    # the folder it just scanned, so `WALLPAPER_DIR=/tmp/x wallpaper-switch
    # thumbs` -- a one-off look at some other folder, which is what that
    # variable is for -- would take every cached file of the REAL collection
    # for an orphan and delete it. Recovering from that is a full re-encode of
    # every preview.
    GONE=0
    if [[ -z "$DIR_FROM_ENV" ]]; then
        GONE=$(sweep_cache "$THUMB_CACHE" '*.jpg' ${KEEP_THUMBS[@]+"${KEEP_THUMBS[@]}"})
        GONE=$(( GONE + $(sweep_cache "$FRAME_CACHE" '*.png' ${KEEP_FRAMES[@]+"${KEEP_FRAMES[@]}"}) ))
        GONE=$(( GONE + $(sweep_dirs "$PREVIEW_CACHE" ${KEEP_PREVIEWS[@]+"${KEEP_PREVIEWS[@]}"}) ))

        # AND THE PREVIEWS THIS CACHE USED TO HOLD. Until the carousel stopped
        # decoding video, every entry here was a `<flat>.mp4` clip; they are now
        # directories of JPEGs, and nothing else would ever collect the old
        # files. Swept with an empty keep-list, so the first run after the
        # change takes all of them and every run afterwards finds none -- which
        # is why this needs no flag, no version marker and no removing later.
        GONE=$(( GONE + $(sweep_cache "$PREVIEW_CACHE" '*.mp4') ))
    fi

    echo "wallpaper thumbnails: $THUMBS stills, $MADE frames, $CLIPS preview sequences, $GONE stale removed"
    exit 0
fi

CURRENT=""
[[ -r "$STATE_FILE" ]] && CURRENT="$(<"$STATE_FILE")"

# Index of the current one within the collection (-1 if not there)
INDEX=-1
for i in "${!WALLPAPERS[@]}"; do
    [[ "${WALLPAPERS[$i]}" == "$CURRENT" ]] && { INDEX=$i; break; }
done

# ---------------------------------------------------------------
# 2. Pick the next one
# ---------------------------------------------------------------
TOTAL=${#WALLPAPERS[@]}
case "$MODE" in
    next)   TARGET="${WALLPAPERS[$(( (INDEX + 1) % TOTAL ))]}" ;;
    prev)   TARGET="${WALLPAPERS[$(( (INDEX - 1 + TOTAL) % TOTAL ))]}" ;;
    random)
        if (( TOTAL == 1 )); then
            TARGET="${WALLPAPERS[0]}"
        else
            # Repeat until we get one different from the current
            while :; do
                PICK=$(( RANDOM % TOTAL ))
                [[ "${WALLPAPERS[$PICK]}" != "$CURRENT" ]] && break
            done
            TARGET="${WALLPAPERS[$PICK]}"
        fi
        ;;
    set)
        TARGET="${2:-}"
        [[ -f "$TARGET" ]] || die "no such file: ${TARGET:-<empty>}"
        TARGET="$(realpath "$TARGET")"
        ;;
    reapply)
        [[ -f "$CURRENT" ]] || die "no current wallpaper to reapply"
        TARGET="$CURRENT"
        ;;
    still)
        [[ -f "$CURRENT" ]] || die "no current wallpaper to freeze"
        TARGET="$CURRENT"
        ;;
    *) die "unknown mode '$MODE' (use next|prev|random|set|reapply|still|dir|thumbs)" ;;
esac

# ---------------------------------------------------------------
# 3. Graphical environment
# ---------------------------------------------------------------
# Under systemd --user these variables may be missing. Without them
# neither awww nor hyprctl can find the compositor.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    WAYLAND_DISPLAY="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-[0-9]*' \
        -printf '%f\n' 2>/dev/null | sort | head -1)"
    export WAYLAND_DISPLAY
fi

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -d "$XDG_RUNTIME_DIR/hypr" ]]; then
    HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
    export HYPRLAND_INSTANCE_SIGNATURE
fi

# The same recovery for the other flavor. niri publishes $NIRI_SOCKET, and a
# systemd --user unit does not inherit it any more than it inherits Hyprland's
# signature.
if [[ -z "${NIRI_SOCKET:-}" ]]; then
    NIRI_SOCKET="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'niri.*.sock' 2>/dev/null | head -1)"
    [[ -n "$NIRI_SOCKET" ]] && export NIRI_SOCKET
fi

# ---------------------------------------------------------------
# 4. Set the wallpaper
# ---------------------------------------------------------------
# ONLY ONE BACKEND IS LEFT ALIVE, but the order is BRING UP THEN TEAR DOWN and
# never the other way round.
#
# The first version killed first, and it was wrong in a way that shows: for the
# moment between the two there is no surface at all on the background layer, so
# Hyprland fills it with its own default wallpaper. Every switch into or out of
# a video flashed the anime mascot.
#
# Overlapping them is safe. Whichever of the two the compositor decides to put
# on top, both are showing A wallpaper, and the one underneath is gone a moment
# later -- so the worst case is that the new one appears a few frames late,
# instead of a hole in the middle of the transition.

# The pids owning a layer-shell surface under this namespace, one per line.
# Hyprland only: niri's layer list has no pid, see below.
layer_pids() {
    hyprctl layers 2>/dev/null \
        | grep "namespace: $1" \
        | sed -n 's/.*pid: \([0-9]*\).*/\1/p' \
        | sort -u
}

# HOW MANY layer-shell surfaces answer to this namespace right now.
#
# niri's IPC reports namespace, output, layer and keyboard interactivity for
# each surface -- and NO pid. Verified against a live session, and it is the one
# thing that makes the wait below work differently on the two compositors.
#
# Counting is enough because of a measured fact: ONE mpvpaper owns exactly ONE
# surface per monitor. So while the outgoing and incoming processes overlap the
# count is strictly higher than it was, and "higher than before" means the new
# one has a surface -- which is the same proof the pid gave, arrived at without
# one.
layer_count() {
    niri msg -j layers 2>/dev/null \
        | jq --arg ns "$1" '[.[] | select(.namespace == $ns)] | length' 2>/dev/null \
        || echo 0
}

# Wait until $1 has a surface belonging to a pid that is NOT in $2, a
# space-separated list of the ones that were there before.
#
# Waiting on the NAMESPACE alone is not enough, and the difference is the whole
# video-to-video case: the outgoing mpvpaper already answers to that name, so a
# plain "is there an mpvpaper surface" is true from the start and the old video
# gets killed the instant the new process exists -- long before it has drawn
# anything. Measured that way: 600ms of the compositor's own background.
#
# The pid is also why this asks the compositor rather than the process table.
# mpvpaper is alive well before it has a surface, and a pid is only proof of a
# surface when it came out of the surface list.
wait_for_new_layer() {
    local ns="$1" before="$2" _
    if compositor can monitor-query 2>/dev/null && compositor is niri 2>/dev/null; then
        # No pid to compare, so the proof is the COUNT going up -- see
        # layer_count above for why that is equivalent here.
        wait_until 80 0.05 layer_count_above "$ns" "${before:-0}"
        return
    fi

    wait_until 80 0.05 layer_pid_other_than "$ns" "$before"
}

# The two questions wait_for_new_layer waits on, one per flavor, as predicates
# of their own -- wait_until takes a command, and a command is the only shape a
# poll loop needs to be written in once.
layer_count_above() {
    [[ "$(layer_count "$1")" -gt "$2" ]]
}

layer_pid_other_than() {
    local old=" $2 " pid
    while read -r pid; do
        [[ -n "$pid" && "$old" != *" $pid "* ]] && return 0
    done < <(layer_pids "$1")
    return 1
}

# What to hand wait_for_new_layer as "before": pids on one compositor, a count
# on the other. One call site, so the difference stays in here.
layer_state() {
    if compositor is niri 2>/dev/null; then
        layer_count "$1"
    else
        layer_pids "$1" | tr '\n' ' '
    fi
}

# ---- A wallpaper daemon belongs to the session, not to its caller ----
# awww-daemon and mpvpaper outlive the command that started them by design, so
# they must not be born inside the process tree of whoever happened to ask for a
# wallpaper. Steam is where that bites. It wraps every game in
# steam-runtime-supervisor --terminate-when-signaled, which implies --subreaper:
# "Do not exit until all descendant processes have exited", per the supervisor's
# own --help. A subreaper also ADOPTS orphans, so backgrounding or setsid does
# not get out from under it.
#
# The game launcher freezes the wallpaper on the way in and reapplies it on the
# way out, both through this script, so the daemon started for a game landed in
# that tree -- and Steam went on showing the game as running for as long as the
# wallpaper played. Measured on 2026-08-19: awww-daemon with the Steam
# supervisor as its parent, and that supervisor still alive with nothing else
# left under it, a good ten minutes after the game had gone.
#
# systemd-run hands the daemon to the user's systemd manager instead, which is
# nobody's descendant. It is only taken when the manager can actually reach the
# compositor, because a daemon started without WAYLAND_DISPLAY is a daemon that
# draws nothing; anywhere else the plain background start is kept unchanged.
spawn_daemon() {
    if command -v systemd-run >/dev/null 2>&1 &&
       systemctl --user show-environment 2>/dev/null | grep -q '^WAYLAND_DISPLAY='; then
        systemd-run --user --collect --quiet \
            --description="wallpaper: $1" -- "$@" && return 0
        warn "systemd-run could not start $1, starting it here"
    fi
    "$@" >/dev/null 2>&1 &
}

# ---- Stopping the video, by pid and for good ----
# BY PID, AND ONLY THE ONES THAT WERE ALREADY THERE. This was `pkill -x
# mpvpaper`, which signals whatever answers to the name AT THE INSTANT IT RUNS
# -- including a process that appeared between the check and the signal, and
# including one somebody started by hand for a single output, which is a
# supported use of this machine: MPVPAPER_OUTPUT is a variable at the top of
# this file precisely so a second monitor can be given its own video. Taking a
# snapshot of the pids first and signalling those is what apply_video below
# already does, for the same reason. A list of pids cannot grow behind your
# back, and it is the only way to signal a process you can name.
#
# AND THEN MAKE SURE THEY ARE GONE. The old loop waited one second and returned
# whether or not anything was left, so a video that did not answer SIGTERM in
# time still held its layer surface -- and the ~2 GB of decoder memory measured
# under `still` below -- while the caller went on to put another wallpaper on
# top of it. That is the state this function is called to prevent, and it was
# reported as reached.
#
# SIGTERM FIRST, because mpvpaper closes its wl_surface from its own handler and
# a surface torn down under the compositor is the noisier failure. SIGKILL after
# two seconds, because by then nothing about it is going to be tidy anyway.
stop_video() {
    local pids left pid waited=0 _

    pids="$(pgrep -x -u "$(id -u)" mpvpaper 2>/dev/null | tr '\n' ' ')"
    [[ -n "${pids// /}" ]] || return 0

    # shellcheck disable=SC2086  # a pid list, deliberately split
    kill $pids 2>/dev/null

    # Three seconds in 50 ms steps: SIGKILL goes out on the fortieth.
    for _ in {1..60}; do
        left=""
        for pid in $pids; do
            kill -0 "$pid" 2>/dev/null && left+="$pid "
        done
        [[ -n "${left// /}" ]] || return 0
        pids="$left"

        (( ++waited == 40 )) && {
            # shellcheck disable=SC2086  # a pid list, deliberately split
            kill -9 $pids 2>/dev/null
        }
        sleep 0.05
    done

    warn "mpvpaper ${pids% } would not stop"
    return 1
}

# Is every output showing $1 right now? awww answers one line per output,
# ending in the path it has up. Anything other than "all of them" is a
# half-applied wallpaper, which is the state this file exists to avoid.
awww_shows_everywhere() {
    local out total matched
    out="$(awww query 2>/dev/null)" || return 1

    total="$(printf '%s\n' "$out" | grep -c 'currently displaying')"
    [[ "$total" -gt 0 ]] || return 1

    matched="$(printf '%s\n' "$out" | grep -F -- "$1" | grep -c 'currently displaying')"
    [[ "$matched" -eq "$total" ]]
}

# The same question, given time to become true. Long enough to cover a
# transition: awww goes on reporting the outgoing image while it dissolves, so
# checking the instant `awww img` returns would fail on every fade.
awww_wait_for() {
    wait_until 18 0.15 awww_shows_everywhere "$1"
}

apply_image() {
    # The daemon takes a moment to come up the first time.
    if ! awww query >/dev/null 2>&1; then
        # --no-cache OR THE DAEMON COMPETES WITH US FOR THE WALLPAPER. awww
        # remembers the last image of each output under
        # ~/.cache/awww/<version>/<output> and restores it as it starts. That
        # restore is asynchronous and `awww query` begins answering before it
        # has finished, so the `awww img` below was racing it -- and on
        # whichever output the restore landed last, an old wallpaper won.
        #
        # Measured on 2026-08-19, freezing the wallpaper for a game: DP-3 sat
        # on an autumn-path.jpg nobody had asked for while HDMI-A-1 showed the
        # frame that had just been applied. The cache file for DP-3 held
        # exactly that path. It reads as "the wallpaper changed by itself",
        # and it only happens when the daemon has to be started -- which is
        # every single freeze, since the video wallpaper leaves awww stopped.
        #
        # Nothing is lost by not restoring: every route into this function
        # applies an image immediately after, which is the only reason the
        # daemon is being started at all.
        spawn_daemon awww-daemon --no-cache
        wait_until 20 0.15 awww query >/dev/null 2>&1 || true
    fi

    # 165 fps = the real refresh rate of both monitors. Any less and the
    # transition looks choppy even when the effect itself is right.
    awww img "$1" \
        --transition-type "$TRANSITION_TYPE" \
        --transition-duration "$TRANSITION_DURATION" \
        --transition-bezier "$TRANSITION_BEZIER" \
        --transition-fps 165 \
        || die "awww could not apply the wallpaper"

    # AND THEN CHECK THAT IT HAPPENED, on every output. --no-cache removes the
    # one cause that was found, but "the same picture on every screen" is what
    # this function promises, it was quietly broken for weeks, and asking costs
    # one query. A monitor coming back mid-apply would break it again.
    #
    # The retry carries no transition on purpose: a second fade over a picture
    # the eye has already accepted looks like the desktop apologising.
    if ! awww_wait_for "$1"; then
        awww img "$1" --transition-type none >/dev/null 2>&1
        awww_wait_for "$1" \
            || warn "awww left an output on a different image"
    fi

    # Only once the still is up. awww img has returned by here, so the image
    # is on the layer and the video can go without leaving a hole.
    stop_video
}

apply_video() {
    command -v mpvpaper >/dev/null || die "mpvpaper is not installed (yay -S mpvpaper)"

    # Noted, NOT killed. Going from one video to another, this is the only
    # thing on screen, and stopping it here is what put the compositor's
    # default wallpaper on the screen for half a second.
    #
    # TWO DIFFERENT QUESTIONS, and conflating them is what broke this under
    # niri. WHO TO KILL is a process question, answered by pgrep and the same
    # everywhere. WHETHER THE NEW ONE IS DRAWING is a compositor question, and
    # the compositor answers it differently: Hyprland hands out the pid owning
    # each surface, niri does not and only the surface count is available.
    #
    # The old code asked pgrep for both. On Hyprland the two lists happened to
    # be the same numbers so it worked; on niri the surface side came back empty
    # forever, the wait timed out, and the branch that kills the outgoing
    # process never ran -- which is why every switch left another mpvpaper
    # behind, four deep, all still playing the first video.
    local old_pids old_layers
    old_pids="$(pgrep -x -u "$(id -u)" mpvpaper 2>/dev/null | tr '\n' ' ')"
    old_layers="$(layer_state mpvpaper)"

    # No -f any more. Forking was how this held the process open when the
    # script is run from a keybind or a timer, and spawn_daemon covers that
    # now: under systemd the daemon IS the unit's main process, and a unit
    # whose main process forks away and exits is a unit systemd tears straight
    # back down, taking the wallpaper with it.
    #
    # What that gives up is catching mpvpaper failing a moment after it starts,
    # since spawn_daemon only reports whether it got off the ground. That is
    # already wait_for_new_layer's job below: no surface means nothing is torn
    # down and the wallpaper that was up stays up.
    # shellcheck disable=SC2086  # both are lists of flags, deliberately split
    spawn_daemon mpvpaper $MPVPAPER_FLAGS -o "$MPV_OPTIONS" "$MPVPAPER_OUTPUT" "$1" \
        || die "mpvpaper could not play the video"

    # Nothing is torn down until the new video is genuinely on the layer. If it
    # never gets there, both the old backends are left exactly as they were:
    # a wallpaper that did not change is a better failure than a black screen.
    if wait_for_new_layer mpvpaper "$old_layers"; then
        awww kill >/dev/null 2>&1
        # shellcheck disable=SC2086  # a pid list, deliberately split
        [[ -n "${old_pids// /}" ]] && kill $old_pids 2>/dev/null
    fi

    return 0
}

# ---------------------------------------------------------------
# 4b. still -- the same wallpaper, minus the decoder
# ---------------------------------------------------------------
# The screen keeps showing what it was showing; what goes away is mpvpaper.
# It exists for gs, which runs it before a game and `reapply` after.
#
# The point is VIDEO MEMORY, and only exiting gives that back. mpvpaper already
# pauses playback on its own when a fullscreen window covers it (-p -a FULL),
# and measured here on 2026-08-13 it still held 2045 MiB while paused --
# SIGSTOP does not move that figure either, because the buffers belong to the
# decoder and not to playback. On a 12 GB card shared with a game that wants 7,
# those 2 GB are the difference between playing and watching the driver page
# textures over PCIe. See the note in gs.
#
# Freezing rather than blanking because gamescope only covers ONE monitor: the
# portrait one stays in view for the whole session, and killing the wallpaper
# outright leaves it empty.
#
# STATE_FILE is deliberately NOT written: the video is still the current
# wallpaper, it is only off screen for a while, and `reapply` has to bring back
# the video and not the frame.
#
# The palette is NOT regenerated either, and since the frame is now captured
# live that is a deliberate choice rather than a free one: the colours of the
# moment being frozen may differ from the ones matugen built off the thumbnail.
# Recomputing would re-theme every open application at the exact instant a game
# is starting, for a picture that goes away when it ends. The palette follows
# the wallpaper, and the wallpaper has not changed -- it is paused.
if [[ "$MODE" == "still" ]]; then
    if is_video "$TARGET"; then
        # THE FRAME HAS TO BE THE ONE ON SCREEN, AND AT THE SIZE OF THE SCREEN.
        # Reusing frame_for's thumbnail was wrong on both counts, and both were
        # visible: it is the frame at second 2 scaled to 1280 wide, so freezing
        # a 115 s loop threw the picture back to a different moment of it --
        # which reads as a different wallpaper, not as a pause -- and then those
        # 1280 pixels were blown up to 2560x1440 and 1080x1920, which is what
        # made the desktop and niri's overview look muddy.
        #
        # The thumbnail is not wrong for what it was made for: matugen and the
        # QML pickers want ONE small deterministic frame per video, and they
        # still get exactly that.
        #
        # The capture has to happen BEFORE apply_image, which is what stops
        # mpvpaper: no mpv, no frame to ask for.
        STILL="$STILL_FRAME"
        mkdir -p "$(dirname "$STILL")"
        if ! capture_live_frame "$STILL"; then
            # Ground is given up one step at a time: same timestamp as the old
            # behaviour but at the video's real size, and only then the
            # thumbnail, which at least always exists.
            if extract_frame "$TARGET" "$STILL"; then
                warn "mpv did not answer, froze to the opening frame instead"
            else
                STILL="$(frame_for "$TARGET")" \
                    || die "could not extract a frame from $(basename "$TARGET") (is ffmpeg installed?)"
            fi
        fi
        # apply_image brings awww up FIRST and only then stops mpvpaper, so the
        # background layer is never empty in between.
        apply_image "$STILL"
        echo "wallpaper: $(basename "$TARGET") frozen to a still frame"
    else
        echo "wallpaper: $(basename "$TARGET") is already a still, nothing to freeze"
    fi
    exit 0
fi

if is_video "$TARGET"; then
    apply_video "$TARGET"
else
    apply_image "$TARGET"
fi

echo "$TARGET" > "$STATE_FILE"

# ---------------------------------------------------------------
# 5. Regenerate the palette
# ---------------------------------------------------------------
# matugen takes an image and only an image: handed an mp4 it does not fail
# politely, it panics on "Unsupported(PathExtension)". So a video is coloured
# from the frame extracted above -- the same cached file the pickers draw.
PALETTE_SOURCE="$TARGET"
if is_video "$TARGET"; then
    PALETTE_SOURCE="$(frame_for "$TARGET")" \
        || die "could not extract a frame from $(basename "$TARGET") (is ffmpeg installed?)"
fi

# --prefer is mandatory: with no interactive terminal matugen cannot tell
# which colour to pick when the image has several candidates.
# saturation gives accents with more character than darkness/lightness.
matugen image "$PALETTE_SOURCE" --mode dark --prefer saturation --quiet \
    || die "matugen failed"

# ---------------------------------------------------------------
# 6. Apply the accent border live
# ---------------------------------------------------------------
# ONLY HYPRLAND NEEDS THIS STEP AT ALL.
#
# matugen has just written both flavors' colour files. Hyprland reads its one at
# startup, so making the change show up NOW takes a second push into the running
# compositor. niri watches every file it includes and reloads itself, so the
# write above already was the push -- there is nothing to do here and doing
# nothing is the correct behaviour rather than a gap.
#
# CAREFUL: "hyprctl keyword" does NOT work with a Lua config -- it answers
# "keyword can't work with non-legacy parsers". You have to use
# "hyprctl eval", which runs Lua code against the live config.
COLORS_LUA="$HOME/.config/hypr/colors.lua"
if [[ -r "$COLORS_LUA" ]] && command -v hyprctl >/dev/null && compositor can live-config 2>/dev/null; then
    ACCENT=$(grep -oP 'accent\s*=\s*"\K[0-9a-fA-F]{6}'  "$COLORS_LUA" | head -1)
    ACCENT2=$(grep -oP 'accent2\s*=\s*"\K[0-9a-fA-F]{6}' "$COLORS_LUA" | head -1)
    if [[ -n "$ACCENT" && -n "$ACCENT2" ]]; then
        hyprctl eval "hl.config({ general = { col = { active_border = {\
 colors = {\"rgba(${ACCENT}ee)\", \"rgba(${ACCENT2}ee)\"}, angle = 45 } } } })" \
            >/dev/null
    fi
fi

# ---------------------------------------------------------------
# 7. Point the cursor at the new accent
# ---------------------------------------------------------------
# AFTER matugen and not instead of it: cursor-match reads the accent out of
# ~/.config/quickshell/colors.json, which the step above has just written.
#
# `|| true` is the same judgement the wallpaper backends get and the opposite
# of the one matugen gets. A palette that cannot be generated leaves every app
# on the machine holding the colours of the wrong image, so that one is fatal;
# a pointer that stays the colour it already was is a wallpaper change that
# worked. The script is quiet by design in every case it declines to act --
# the pack not installed, the theme unchanged, the setting turned off -- so
# nothing here has to ask whether it is worth calling.
command -v cursor-match >/dev/null && cursor-match || true

echo "wallpaper: $(basename "$TARGET")"
