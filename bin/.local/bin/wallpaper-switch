#!/usr/bin/env bash
# wallpaper-switch - change the wallpaper and regenerate the accent palette
#
#   wallpaper-switch next     next one in the collection (alphabetical)
#   wallpaper-switch prev     previous one
#   wallpaper-switch random   a random one (different from the current)
#   wallpaper-switch set PATH a specific one
#   wallpaper-switch reapply  reapply the current one (handy after editing templates)
#
# The collection lives in ~/Pictures/wallpapers

set -uo pipefail

WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
STATE_FILE="$HOME/.cache/wallpaper-current"
MODE="${1:-next}"

# ---- Transition ----
# Types: none simple fade left right top bottom wipe wave grow center any outer random
# They can be overridden from the environment, e.g.:
#   TRANSITION_TYPE=wave wallpaper-switch next
TRANSITION_TYPE="${TRANSITION_TYPE:-fade}"
TRANSITION_DURATION="${TRANSITION_DURATION:-1.4}"

# Only applies to 'fade': the curve controlling the acceleration of the
# dissolve. This one starts and ends smoothly (ease-in-out).
# For a linear dissolve use 0.0,0.0,1.0,1.0
TRANSITION_BEZIER="${TRANSITION_BEZIER:-.42,0,.58,1}"

mkdir -p "$(dirname "$STATE_FILE")"

die() { echo "wallpaper-switch: $*" >&2; exit 1; }

# ---------------------------------------------------------------
# 1. Gather the collection
# ---------------------------------------------------------------
mapfile -t WALLPAPERS < <(
    find -L "$WALLPAPER_DIR" -maxdepth 2 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
           -o -iname '*.webp' -o -iname '*.bmp' \) | sort
)

(( ${#WALLPAPERS[@]} == 0 )) && die "no images in $WALLPAPER_DIR"

CURRENT=""
[[ -r "$STATE_FILE" ]] && CURRENT="$(<"$STATE_FILE")"

# Index of the current one within the collection (-1 if not there)
INDEX=-1
for i in "${!WALLPAPERS[@]}"; do
    [[ "${WALLPAPERS[$i]}" == "$CURRENT" ]] && { INDEX=$i; break; }
done

# ---------------------------------------------------------------
# 2. Pick the next one
# ---------------------------------------------------------------
TOTAL=${#WALLPAPERS[@]}
case "$MODE" in
    next)   TARGET="${WALLPAPERS[$(( (INDEX + 1) % TOTAL ))]}" ;;
    prev)   TARGET="${WALLPAPERS[$(( (INDEX - 1 + TOTAL) % TOTAL ))]}" ;;
    random)
        if (( TOTAL == 1 )); then
            TARGET="${WALLPAPERS[0]}"
        else
            # Repeat until we get one different from the current
            while :; do
                PICK=$(( RANDOM % TOTAL ))
                [[ "${WALLPAPERS[$PICK]}" != "$CURRENT" ]] && break
            done
            TARGET="${WALLPAPERS[$PICK]}"
        fi
        ;;
    set)
        TARGET="${2:-}"
        [[ -f "$TARGET" ]] || die "no existe el archivo: ${TARGET:-<vacio>}"
        TARGET="$(realpath "$TARGET")"
        ;;
    reapply)
        [[ -f "$CURRENT" ]] || die "no current wallpaper to reapply"
        TARGET="$CURRENT"
        ;;
    *) die "modo desconocido '$MODE' (usa next|prev|random|set|reapply)" ;;
esac

# ---------------------------------------------------------------
# 3. Graphical environment
# ---------------------------------------------------------------
# Under systemd --user these variables may be missing. Without them
# neither awww nor hyprctl can find the compositor.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    WAYLAND_DISPLAY="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-[0-9]*' \
        -printf '%f\n' 2>/dev/null | sort | head -1)"
    export WAYLAND_DISPLAY
fi

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -d "$XDG_RUNTIME_DIR/hypr" ]]; then
    HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
    export HYPRLAND_INSTANCE_SIGNATURE
fi

# ---------------------------------------------------------------
# 4. Set the wallpaper
# ---------------------------------------------------------------
# The daemon takes a moment to come up the first time.
if ! awww query >/dev/null 2>&1; then
    awww-daemon >/dev/null 2>&1 &
    for _ in {1..20}; do
        awww query >/dev/null 2>&1 && break
        sleep 0.15
    done
fi

# 165 fps = the real refresh rate of both monitors. Any less and the
# transition looks choppy even when the effect itself is right.
awww img "$TARGET" \
    --transition-type "$TRANSITION_TYPE" \
    --transition-duration "$TRANSITION_DURATION" \
    --transition-bezier "$TRANSITION_BEZIER" \
    --transition-fps 165 \
    || die "awww no pudo aplicar el wallpaper"

echo "$TARGET" > "$STATE_FILE"

# ---------------------------------------------------------------
# 5. Regenerate the palette
# ---------------------------------------------------------------
# --prefer is mandatory: with no interactive terminal matugen cannot tell
# which colour to pick when the image has several candidates.
# saturation gives accents with more character than darkness/lightness.
matugen image "$TARGET" --mode dark --prefer saturation --quiet \
    || die "matugen fallo"

# ---------------------------------------------------------------
# 6. Apply the Hyprland border live
# ---------------------------------------------------------------
# matugen already wrote colors.lua (which is read at startup), but for the
# change to show up right now it has to be pushed to the compositor.
#
# CAREFUL: "hyprctl keyword" does NOT work with a Lua config -- it answers
# "keyword can't work with non-legacy parsers". You have to use
# "hyprctl eval", which runs Lua code against the live config.
COLORS_LUA="$HOME/.config/hypr/colors.lua"
if [[ -r "$COLORS_LUA" ]] && command -v hyprctl >/dev/null; then
    ACCENT=$(grep -oP 'accent\s*=\s*"\K[0-9a-fA-F]{6}'  "$COLORS_LUA" | head -1)
    ACCENT2=$(grep -oP 'accent2\s*=\s*"\K[0-9a-fA-F]{6}' "$COLORS_LUA" | head -1)
    if [[ -n "$ACCENT" && -n "$ACCENT2" ]]; then
        hyprctl eval "hl.config({ general = { col = { active_border = {\
 colors = {\"rgba(${ACCENT}ee)\", \"rgba(${ACCENT2}ee)\"}, angle = 45 } } } })" \
            >/dev/null
    fi
fi

echo "wallpaper: $(basename "$TARGET")"
