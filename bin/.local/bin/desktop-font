#!/usr/bin/env bash
# =============================================================
#  desktop-font — one type size for the shell and the terminal
#
#  Theme.qml says it plainly: "kitty.conf says `font_size 11.0`, and kitty
#  measures in points... the shell asks for the same 11pt the terminal does
#  and lets Qt do the conversion. Change it here only if kitty changes."
#  Those two are one decision, so they get one dial.
#
#      desktop-font 12                  set the size
#      desktop-font 12 "JetBrainsMono Nerd Font Propo"    size and family
#      desktop-font                     print the current pair
#
#  THE FAMILY IS NOT A FREE CHOICE, and the settings window enforces the same
#  short list this does. Every icon in this shell -- the bar, the island, the
#  notifications, the launcher -- is a Nerd Font codepoint drawn as text in
#  Theme.fontFamily. Point that at a font without the glyph set and the whole
#  desktop turns into tofu boxes. Only the JetBrainsMono Nerd Font variants
#  carry it here, which still leaves a real choice: monospaced or
#  proportional, ligatures or not.
#
#  Same shape as desktop-opacity, its sibling: one state file under
#  ~/.local/state that everything reads, one generated include for kitty, and
#  a signal for what can take one.
# =============================================================
set -euo pipefail

# FOUND NEXT TO THIS SCRIPT AND NOT THROUGH $PATH. ~/.local/bin is on the PATH
# of a login shell and of very little else -- the settings window in Quickshell
# inherits the compositor's environment, a systemd --user unit gets neither, and
# install.sh calls these scripts by absolute path with whatever PATH it was
# started with. readlink resolves the stow symlink back into the repo, so the
# library is found whether this was started from ~/.local/bin or straight out of
# the checkout.
BIN_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/desktop-lib.sh
. "$BIN_DIR/../lib/desktop-lib.sh"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/desktop-font"
KITTY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/font.conf"

# Below 8 the bar's glyphs stop resolving; above 16 the bar no longer fits its
# own height, which is a fixed 48 in Theme.qml.
MIN=8
MAX=16
DEFAULT_SIZE=11
DEFAULT_FAMILY="JetBrainsMono Nerd Font"

# Checked against `fc-list :family` on this machine. Anything not on this list
# is refused rather than silently accepted, because the failure mode is a
# desktop full of empty rectangles and no obvious way back.
ALLOWED_FAMILIES=(
  "JetBrainsMono Nerd Font"
  "JetBrainsMono Nerd Font Mono"
  "JetBrainsMono Nerd Font Propo"
  "JetBrainsMonoNL Nerd Font"
  "JetBrainsMonoNL Nerd Font Mono"
  "JetBrainsMonoNL Nerd Font Propo"
)

current_size() {
  [[ -r "$STATE_FILE" ]] && sed -n '1p' "$STATE_FILE" || printf '%s\n' "$DEFAULT_SIZE"
}

current_family() {
  local value
  value=$([[ -r "$STATE_FILE" ]] && sed -n '2p' "$STATE_FILE" || true)
  printf '%s\n' "${value:-$DEFAULT_FAMILY}"
}

if (( $# == 0 )); then
  printf '%s\n%s\n' "$(current_size)" "$(current_family)"
  exit 0
fi

size="$1"
family="${2:-$(current_family)}"

[[ "$size" =~ ^[0-9]+$ ]] || die "Not a whole number of points: '$size'"
(( size >= MIN && size <= MAX )) || die "Out of range: $size (expected $MIN to $MAX)"

found=0
for allowed in "${ALLOWED_FAMILIES[@]}"; do
  [[ "$family" == "$allowed" ]] && { found=1; break; }
done
(( found )) || die "Not a Nerd Font family this desktop can draw its icons with: '$family'"

# THROUGH state_write AND NOT `>`. Two things wanted that. The file is a
# read-modify-write -- `desktop-font 12` keeps whatever family current_family()
# just read -- so two callers racing lose one of the two values, and the store
# is truncated before it is refilled, so a reader landing in the gap sees an
# empty file and falls back to 11pt. It is short enough that the gap is short,
# which is a reason it was never noticed rather than a reason it was safe.
printf '%s\n%s\n' "$size" "$family" | state_write "$STATE_FILE"
printf 'Desktop font: %s %spt\n' "$family" "$size"

# ---------------------------------------------------------------------------
# kitty
#
# Included last by kitty.conf so it overrides the font_family and font_size
# set further up, which stay as the values a fresh clone starts at.
#
# The MONO variant regardless of what the shell uses: a terminal with a
# proportional font is not a terminal. This is the one place the two configs
# are allowed to disagree, and the reason is the whole point of the setting.
if [[ -d "$(dirname "$KITTY_FILE")" ]]; then
  kitty_family="${family/ Nerd Font Propo/ Nerd Font Mono}"
  kitty_family="${kitty_family/%Nerd Font/Nerd Font Mono}"

  # Written whole and renamed over the old one: kitty is told to re-read this
  # the moment it is there, and a SIGUSR1 arriving while a redirection had it
  # emptied would have kitty read a file with no font in it.
  kitty_conf() {
    echo "# Generated by desktop-font. Do not edit: the settings window rewrites it."
    echo "font_family $kitty_family"
    echo "font_size   $size.0"
  }
  write_generated "$KITTY_FILE" kitty_conf

  if pkill -SIGUSR1 -x kitty 2>/dev/null; then
    note "kitty: reloaded as $kitty_family"
  else
    note "kitty: nothing running, next window picks it up"
  fi
fi
