#!/usr/bin/env bash
# =============================================================
#  hypr-monitor — the old name of `desktop-monitors`, kept working
#
#  This script used to be the Hyprland-only monitor writer. It now serves both
#  compositors and is called `desktop-monitors`, because the name was a promise
#  it no longer keeps: the same command writes KDL under niri.
#
#  THIS FILE IS NOT A COPY AND MUST NEVER BECOME ONE. It forwards, so there is
#  exactly one implementation to fix a bug in. It exists at all because a script
#  in ~/.local/bin is a command a person types and a line in somebody's notes,
#  and renaming one is not a thing that should quietly break a shell history.
#
#  The messages come back saying "desktop-monitors", deliberately: the answer to
#  "what do I type" is the new name, and echoing the old one back would keep it
#  alive for another year.
#
#  Nothing in this repository calls it any more. The day that is true of the
#  machines too, this file goes.
# =============================================================
set -euo pipefail

# The sibling of THIS file, resolved through any symlink stow made, rather than
# whatever a PATH lookup finds: this is a compatibility shim, and a shim that
# forwards to a different installation of the thing it is shimming is worse than
# no shim at all.
exec "$(dirname "$(readlink -f "$0")")/desktop-monitors" "$@"
