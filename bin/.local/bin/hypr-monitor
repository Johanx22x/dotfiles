#!/usr/bin/env bash
# =============================================================
#  hypr-monitor — monitor overrides that survive a reload
#
#  hyprland.lua declares the monitors this machine was set up with, and those
#  declarations are the good kind of config: hand written, commented, in git.
#  Nothing here touches them. What this does is keep a SECOND file, generated,
#  untracked, applied after them, holding only what has been changed since:
#
#      ~/.config/hypr/monitors.lua
#
#  hyprland.lua dofile()s it at the end of its monitor section, so a `hyprctl
#  reload` re-runs the hand-written block and then this one on top. Later
#  hl.monitor calls for the same output win -- measured, not assumed: setting
#  the secondary panel to 120 Hz through `hyprctl eval` after the config had
#  already put it at 165 took effect immediately.
#
#  It is the same arrangement colors.lua already uses: generated into
#  ~/.config/hypr, listed in .gitignore, dofile'd defensively so a missing or
#  broken file leaves the hand-written values standing.
#
#      hypr-monitor set <desc> <mode> <position> <scale> <transform>
#      hypr-monitor forget <desc>          drop one override
#      hypr-monitor clear                  drop them all
#      hypr-monitor                        show what is overridden
#
#  <desc> is the monitor's EDID description WITHOUT the "desc:" prefix -- the
#  same string hyprland.lua puts in MONITOR_MAIN. Descriptions and not
#  connector names, for the reason written at the top of that file: connector
#  names are assigned by the kernel and change across kernel versions.
#
#  The settings window calls this after you confirm a change you can see. It
#  is equally usable by hand, which is the point of it being a script.
# =============================================================
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
# The overrides in a form this script can rewrite: one tab-separated record
# per monitor. Lua is the OUTPUT, not the store -- regenerating a whole file
# from a table is safe, and editing Lua in place with sed is how generated
# configs get corrupted.
STATE_FILE="$STATE_DIR/hypr-monitors"
OUT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua"

die() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }
note() { printf '  %s\n' "$*"; }

# Lua single-quoted string. Descriptions carry dots and spaces but no quotes
# in practice; escaped anyway, because "in practice" is how a config file ends
# up with a syntax error in it.
lua_escape() { printf '%s' "${1//\'/\\\'}"; }

generate() {
  # LOCAL, and the reason is a bug this had for exactly one run: `read` in the
  # loop below assigns to the caller's scope unless told otherwise, so after
  # generating the file it left every one of these empty -- and the apply that
  # follows went out with a blank monitor description. The file was correct,
  # the screen did not move, and nothing said why.
  local desc mode position scale transform

  mkdir -p "$(dirname "$OUT_FILE")"

  {
    echo "-- GENERATED BY hypr-monitor. Do not edit by hand: the settings"
    echo "-- window (SUPER + C) rewrites this file whenever a display change is"
    echo "-- confirmed. Delete it and hyprland.lua's own monitor block stands"
    echo "-- on its own again."
    echo "--"
    echo "-- Applied AFTER that block, so every entry here is an override."
    echo ""

    if [[ -s "$STATE_FILE" ]]; then
      while IFS=$'\t' read -r desc mode position scale transform; do
        [[ -n "$desc" ]] || continue
        printf 'hl.monitor({\n'
        printf "    output    = 'desc:%s',\n" "$(lua_escape "$desc")"
        printf "    mode      = '%s',\n" "$(lua_escape "$mode")"
        printf "    position  = '%s',\n" "$(lua_escape "$position")"
        printf '    scale     = %s,\n' "$scale"
        printf '    transform = %s,\n' "$transform"
        printf '})\n\n'
      done < "$STATE_FILE"
    else
      echo "-- Nothing overridden."
    fi
  } > "$OUT_FILE"
}

# Push the same thing into the running compositor, so confirming in the
# settings window does not need a reload to take effect. `eval` and not
# `keyword`: with a Lua config, keyword is refused outright ("keyword can't
# work with non-legacy parsers") and still exits 0. See desktop-opacity, which
# shipped that bug once.
apply_live() {
  local desc="$1" mode="$2" position="$3" scale="$4" transform="$5"
  hyprctl eval "hl.monitor({
    output    = 'desc:$(lua_escape "$desc")',
    mode      = '$mode',
    position  = '$position',
    scale     = $scale,
    transform = $transform,
  })" >/dev/null
}

case "${1:-show}" in
  show)
    if [[ -s "$STATE_FILE" ]]; then
      while IFS=$'\t' read -r desc mode position scale transform; do
        [[ -n "$desc" ]] || continue
        printf '%s\n    %s at %s, scale %s, transform %s\n' \
          "$desc" "$mode" "$position" "$scale" "$transform"
      done < "$STATE_FILE"
    else
      echo "No monitor overrides. hyprland.lua stands on its own."
    fi
    ;;

  set)
    (( $# == 6 )) || die "Usage: hypr-monitor set <desc> <mode> <position> <scale> <transform>"
    desc="$2"; mode="$3"; position="$4"; scale="$5"; transform="$6"

    # Validated here rather than trusted, because everything downstream of a
    # bad value is a monitor that does not come back: hyprland.lua would carry
    # the broken line through every reload from now on.
    [[ "$mode" =~ ^[0-9]+x[0-9]+@[0-9.]+$ || "$mode" == "preferred" || "$mode" == "highrr" || "$mode" == "highres" ]] \
      || die "Not a mode: '$mode' (expected WIDTHxHEIGHT@RATE, or preferred/highrr/highres)"
    [[ "$position" =~ ^-?[0-9]+x-?[0-9]+$ || "$position" == "auto" ]] \
      || die "Not a position: '$position' (expected XxY, or auto)"
    [[ "$scale" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "Not a scale: '$scale'"
    [[ "$transform" =~ ^[0-7]$ ]] || die "Not a transform: '$transform' (expected 0 to 7)"

    mkdir -p "$STATE_DIR"
    touch "$STATE_FILE"

    # Upsert: everything but this monitor, then this monitor. Rewritten whole
    # rather than edited in place, so a crash halfway leaves the old file.
    tmp="$(mktemp)"
    grep -v -P "^\Q$desc\E\t" "$STATE_FILE" > "$tmp" || true
    printf '%s\t%s\t%s\t%s\t%s\n' "$desc" "$mode" "$position" "$scale" "$transform" >> "$tmp"
    mv "$tmp" "$STATE_FILE"

    generate
    apply_live "$desc" "$mode" "$position" "$scale" "$transform"

    printf 'Saved: %s\n' "$desc"
    note "$mode at $position, scale $scale, transform $transform"
    note "written to ${OUT_FILE/#$HOME/\~}, applied live"
    ;;

  forget)
    (( $# == 2 )) || die "Usage: hypr-monitor forget <desc>"
    desc="$2"

    [[ -s "$STATE_FILE" ]] || { echo "Nothing to forget."; exit 0; }

    tmp="$(mktemp)"
    grep -v -P "^\Q$desc\E\t" "$STATE_FILE" > "$tmp" || true
    mv "$tmp" "$STATE_FILE"

    generate
    # NOT applied live, and that is deliberate: undoing an override means
    # going back to whatever hyprland.lua says, and this script does not know
    # what that is -- parsing it to find out is exactly the thing this whole
    # arrangement exists to avoid. The file is correct now; `hyprctl reload`
    # is what makes the screen agree with it.
    printf 'Forgotten: %s\n' "$desc"
    note "run 'hyprctl reload' to go back to the value in hyprland.lua"
    ;;

  clear)
    : > "$STATE_FILE"
    generate
    echo "All monitor overrides dropped."
    note "run 'hyprctl reload' to go back to the values in hyprland.lua"
    ;;

  *)
    die "Unknown command: '$1' (expected set, forget, clear or show)"
    ;;
esac
