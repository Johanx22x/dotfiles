#!/usr/bin/env bash
# laptop-modules -- whether this machine gets the battery indicator and the
# brightness slider.
#
# OFF UNLESS SOMEBODY SAYS OTHERWISE. These dotfiles are shared between a
# desktop and a laptop, and the two pieces of hardware that differ most are
# exactly these: a battery and a backlight. A tracked config cannot know which
# machine it landed on, so this is the one answer that has to be given per
# machine -- install.sh asks it once, and this file is where the answer lives.
#
# TWO KEYS AND NOT ONE, because they are two widgets in two places and a
# person may well want one without the other: a desktop with a DDC-capable
# monitor could grow brightness one day, and a laptop docked to a screen may
# want the battery and nothing else. install.sh sets both together because at
# that moment it is asking one question ("is this a laptop?"); the settings
# window then treats them separately, which is what the rows in it are for.
#
# WHY NOT DETECT IT. Detection is what the widgets ALREADY do: the battery one
# hides when UPower reports no laptop battery, the brightness one hides when
# /sys/class/backlight is empty. That is the safety net, not the switch. A
# desktop with a UPS reports a battery, and a machine whose driver has not
# loaded yet reports none, so hardware presence alone would put a widget on
# one bar and take it off another for reasons nobody asked for. The flag is
# the intention; the detection is the check that the intention is possible.
#
# WHY NOT Config.qml's JSON. install.sh runs before the shell has ever
# started, so it would be writing a file the shell is about to create. A flat
# file in the state directory is what every other cross-program value here
# uses, and it is readable from a script, from QML and by hand.

set -euo pipefail

# FOUND NEXT TO THIS SCRIPT AND NOT THROUGH $PATH. ~/.local/bin is on the PATH
# of a login shell and of very little else -- the settings window in Quickshell
# inherits the compositor's environment, a systemd --user unit gets neither, and
# install.sh calls these scripts by absolute path with whatever PATH it was
# started with. readlink resolves the stow symlink back into the repo, so the
# library is found whether this was started from ~/.local/bin or straight out of
# the checkout.
BIN_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/desktop-lib.sh
. "$BIN_DIR/../lib/desktop-lib.sh"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/laptop-modules"

readonly KEYS=(battery brightness)

usage() {
    cat >&2 <<'EOF'
Usage:
  laptop-modules                    print both keys
  laptop-modules on | off           set both at once (install.sh does this)
  laptop-modules battery on|off     the bar's battery indicator
  laptop-modules brightness on|off  the island's brightness slider

Both are off unless set. They also hide themselves when the hardware is not
there, so turning one on for a machine without a battery or a backlight
shows nothing.
EOF
    exit 2
}

declare -A VALUES=()

load() {
    state_load "$STATE_FILE" VALUES
}

# BOTH KEYS, ALWAYS, whichever one was asked about -- this file owns the pair,
# and a store with one row in it would leave the other reading as unset. So the
# whole file goes through state_write in one piece rather than key by key: one
# lock and one rename instead of two of each, and no moment where the file holds
# a row the shell has not been told about.
#
# The lock is not decoration even here. This is a read (load, further down)
# followed by a write of what was read, so two of these at once -- install.sh
# and a settings row on a first run -- would otherwise be the lost update the
# header of desktop-lib.sh describes.
save() {
    local key
    for key in "${KEYS[@]}"; do
        printf '%s\t%s\n' "$key" "${VALUES[$key]:-0}"
    done | state_write "$STATE_FILE"
}

set_key() {
    case "$2" in
        on)  VALUES[$1]=1 ;;
        off) VALUES[$1]=0 ;;
        *)   usage ;;
    esac
}

load

case "${1:-show}" in
    show)
        for key in "${KEYS[@]}"; do
            [[ ${VALUES[$key]:-0} == 1 ]] && state=on || state=off
            printf '%-11s %s\n' "$key" "$state"
        done
        ;;

    on|off)
        for key in "${KEYS[@]}"; do
            set_key "$key" "$1"
        done
        save
        ;;

    battery|brightness)
        [[ $# -eq 2 ]] || usage
        set_key "$1" "$2"
        save
        ;;

    *) usage ;;
esac
