#!/usr/bin/env bash
#
# wofi-drun — application launcher in a grid, with a glass background.
#
# Bound to SUPER + SPACE in hyprland.lua.
#
# It exists as a script and not as a plain "wofi --show drun" for one reason:
# it has to be launched with XDG_CONFIG_HOME pointing at an empty directory
# (see below), and that cannot be done from hl.dsp.exec_cmd().

set -euo pipefail

# ---------------------------------------------------------------------------
# One instance only.
#
# Without this, pressing the shortcut again opens a wofi on top of the
# previous one and the layers pile up. Chosen behaviour:
#   - if the one already open is THIS menu -> close it and do not open
#     another, so the shortcut acts as a toggle;
#   - if the one open is the OTHER menu -> close it and open this one.
#
# The marker is the stylesheet path, the only thing telling the two apart on
# the command line (`pgrep -a wofi`).
only_one() {   # only_one <marker>
    pgrep -x wofi >/dev/null 2>&1 || return 0
    local was_this=1
    pgrep -a wofi | grep -q -- "$1" || was_this=0
    pkill -x wofi
    # Wait for it to release the layer, or the new one overlaps the old.
    local i
    for i in $(seq 40); do
        pgrep -x wofi >/dev/null 2>&1 || break
        sleep 0.025
    done
    (( was_this )) && exit 0
    return 0
}

only_one "drun.css"

# XDG_CONFIG_HOME pointing at an empty directory is what makes the glass
# possible.
#
# ~/.config/gtk-3.0/gtk.css (generated by matugen) carries this rule:
#
#     window, .background, dialog, ... { background-color: @theme_bg_color; }
#
# and GTK loads that sheet at USER priority, above the one wofi passes with
# --style. Result: the background comes up opaque and there is no
# transparency for the compositor to blur. Verified that it CANNOT be won
# from wofi's CSS: not with `window`, not with `#window`, not with
# `!important`. The only way out is for GTK not to find that file.
#
# The price is that wofi cannot find its ~/.config/wofi/config either, so
# EVERYTHING that came from there is passed explicitly here.
ISOLATED="${XDG_RUNTIME_DIR:-/tmp}/wofi-no-gtkcss"
mkdir -p "$ISOLATED"

# Width: 3 columns of ~340 px. It is the EXACT layer width because #outer-box
# carries no padding -- if it did, that padding would be added to this value
# and the window would stop being centred. Capped to the focused monitor.
# An odd transform means a rotated monitor: the sides have to be swapped.
read_monitor_width() {
    hyprctl monitors -j | python3 -c '
import json, sys
for m in json.load(sys.stdin):
    if m["focused"]:
        w, h, s = m["width"], m["height"], m.get("scale", 1) or 1
        if m["transform"] % 2:
            w, h = h, w
        print(int(w / s))
        break
'
}
MON=$(read_monitor_width); : "${MON:=1920}"

WIDTH=1080
(( WIDTH > MON - 80 )) && WIDTH=$(( MON - 80 ))

# A 3 x 4 grid.
#
# --lines sets the height in ROWS and overrides --height, so it is used here
# instead of giving a height: 4 lines with 3 columns = 12 applications in
# view, the rest on scroll. That is why --height is not passed.
#
# The icon sits to the LEFT of the name, not above it: that order is fixed by
# wofi inside each entry and there is no option to change it. Tried
# orientation=vertical (does not affect the inside of the entry, only the
# direction of the list) and orientation=horizontal (puts everything in a
# single row, useless).
exec env XDG_CONFIG_HOME="$ISOLATED" wofi \
    --show drun \
    --allow-images \
    --style "$HOME/.config/wofi/drun.css" \
    --width "$WIDTH" \
    --columns 3 \
    --lines 4 \
    --prompt "Search" \
    --insensitive \
    --matching fuzzy \
    --hide-scroll \
    --no-actions \
    --term kitty \
    --define layer=overlay \
    --define image_size=48 \
    --define content_halign=center
