# ---- Seleccion: AQUI es donde mas se nota el wallpaper ----
# El archivo seleccionado en Dolphin se pinta con el acento primario, el
# mismo que el borde activo de Hyprland y @accent de waybar.
# on_primary como texto: matugen lo calcula para tener contraste
# suficiente CONTRA primary, asi que el nombre del archivo se lee sea
# cual sea el acento que toque.
[Colors:Selection]
BackgroundNormal={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
BackgroundAlternate={{colors.primary_container.default.red}},{{colors.primary_container.default.green}},{{colors.primary_container.default.blue}}
