# ---- Efectos de estado ----
# Sin estos bloques KDE aplica sus valores por defecto, que aclaran el
# fondo de los elementos deshabilitados y los vuelven ilegibles sobre
# un tema oscuro. Aqui se opta por atenuar el TEXTO y dejar el fondo.
[ColorEffects:Disabled]
Color=86,95,137
ColorAmount=0
ColorEffect=0
ContrastAmount=0.35
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=86,95,137
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

# ---- Iconos ----
# breeze-dark es el unico set oscuro que hay instalado ahora mismo.
# Si en el paso 4 entra Papirus-Dark, cambiar aqui tambien.
[Icons]
Theme=breeze-dark
