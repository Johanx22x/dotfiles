# GENERADO POR MATUGEN - no editar a mano.
# Plantilla: ~/.config/matugen/templates/kdeglobals
# Wallpaper: {{image}}
#
# AVISO: comprobado que Dolphin NO lee esto (ver la nota larga en
# config.toml). KF6 le impone su BreezeDark interno desde el portal.
# Se mantiene generado porque es gratis y se activaria solo si algun
# dia entra plasma-integration. Las apps Qt6 que SI se tinen lo hacen
# via qt6ct (~/.config/qt6ct/colors/matugen.conf).
#
# OJO: aqui los colores van en R,G,B DECIMAL separados por comas, no en
# hexadecimal. Por eso la plantilla usa .red/.green/.blue en vez de .hex.
#
# Misma regla que el resto del sistema (ver config.toml): los fondos y
# el texto son fijos de Tokyo Night para garantizar contraste con
# cualquier wallpaper. Solo la SELECCION, el foco, los enlaces y el
# hover salen de matugen.

[General]
ColorScheme=Matugen
Name=Matugen
shadeSortColumn=true

# ---- Ventana: el fondo del chrome (barras, paneles laterales) ----
# 26,27,38 = #1a1b26, el mismo background de kitty y @base de waybar.
[Colors:Window]
BackgroundNormal=26,27,38
BackgroundAlternate=41,46,66
ForegroundNormal=192,202,245
ForegroundInactive=86,95,137
ForegroundActive={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
ForegroundLink={{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}}
ForegroundVisited={{colors.secondary.default.red}},{{colors.secondary.default.green}},{{colors.secondary.default.blue}}
ForegroundNegative=247,118,142
ForegroundNeutral=224,175,104
ForegroundPositive=158,206,106
DecorationFocus={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}
DecorationHover={{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}}

# ---- Vista: la lista de archivos, los campos de texto ----
# Un punto mas oscuro que la ventana (#15161e, el color0 de kitty) para
# que el area de contenido se despegue del chrome que la rodea.
