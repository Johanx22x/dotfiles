// GENERATED BY MATUGEN - do not edit by hand.
// Template: ~/.config/matugen/templates/fastfetch-config.jsonc
// Wallpaper: {{image}}
//
// fastfetch does not support "include" (same as dunst), so the whole file is
// regenerated. To change modules, icons or the logo edit the TEMPLATE, not
// this file.
//
// Theme: a port of "remfetch" from Chick2D/neofetch-themes.
// Requires a Nerd Font (JetBrainsMono Nerd Font).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        // CAREFUL: kitty-direct requires PNG. kitty only decodes PNG or raw
        // RGB; a JPEG or GIF is silently dropped, with no error and no
        // image. For other formats use "kitty" (it converts with
        // imagemagick), at the cost of a slightly slower start.
        "type": "kitty-direct",
        // A glob, not a file: if it expands to several, fastfetch picks one
        // AT RANDOM on each run. It is native, no script needed.
        // Drop more PNGs into logos/ and they join the rotation on their
        // own.
        "source": "~/.config/fastfetch/logos/*.png",
        // The box is fixed (26x15), so the text always takes 16 rows no
        // matter what. But preserveAspectRatio fits INSIDE the box: a wider
        // image will look smaller and leave a gap. For consistent framing,
        // use images with a ratio close to rei.png (462x586 = 0.79,
        // portrait).
        "width": 26,
        "height": 15,
        "preserveAspectRatio": true,
        "padding": { "top": 1, "right": 3 }
    },

    "display": {
        "separator": " ",
        "color": {
            // Wallpaper accents, same roles as kitty and waybar:
            // primary for the title, tertiary for the keys.
            "title": "{{colors.primary.default.hex}}",
            "keys": "{{colors.tertiary.default.hex}}",
            // The VALUES are not derived: they are the text you actually
            // read. Pinned to kitty.conf's foreground so they do not depend
            // on how light the current wallpaper accent comes out.
            "output": "#c0caf5"
        }
    },

    "modules": [
        "title",
        { "type": "separator",    "string": "─" },
        { "type": "os",           "key": " " },
        { "type": "kernel",       "key": " ", "format": "{release}" },
        { "type": "shell",        "key": " " },
        { "type": "terminal",     "key": " " },
        { "type": "terminalfont", "key": " " },
        //  = the "linux-hyprland" glyph from Nerd Fonts. The original
        // theme carried a generic "squared plus" (U+229E), not a logo.
        { "type": "wm",           "key": " " },
        { "type": "theme",        "key": " " },
        // "13th Gen Intel(R) Core(TM) i5-13600K" is 36 characters of which
        // only 9 matter. fastfetch has no search/replace in its format
        // strings, but it does have a Lua sandbox: the module data arrives
        // as a table in the first vararg (camelCase keys, inspect with
        // format = 'lua:return json_encode({...})' ).
        // If you ever build an AMD machine the pattern will not match and it
        // falls back to the full name, without breaking.
        { "type": "cpu",          "key": " ",
          "format": "lua:local c=... local v=c.vendor:gsub('^Genuine',''):gsub('^Authentic','') return v .. ' ' .. (c.name:gsub('^.*Core%(TM%)%s*','')) .. ' (' .. c.coreTypes .. ') @ ' .. c.freqMax" },
        // The discrete one only: the UHD 770 has no monitors attached and
        // draws nothing. The row it frees up is taken by the disk.
        { "type": "gpu",          "key": "󰢮 ", "format": "{name}", "hideType": "integrated" },
        { "type": "memory",       "key": "󰍛 ", "format": "{used} / {total}" },
        // "/" only (like remfetch's disk_show=('/')). Unfiltered, the data
        // mounts show up too and it would exceed the 16 rows of the logo.
        // With an explicit "format" to drop the "- btrfs" fastfetch appends
        // by default: the filesystem never changes and it only makes the row
        // longer.
        { "type": "disk",         "key": " ", "folders": "/",
          "format": "{size-used} / {size-total} ({size-percentage})" },
        "break",
        { "type": "colors", "symbol": "block", "block": { "width": 2 } }
    ]
}
