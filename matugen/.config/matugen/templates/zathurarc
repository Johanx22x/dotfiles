# GENERATED BY MATUGEN - do not edit by hand.
# Template: ~/.config/matugen/templates/zathurarc
# Wallpaper: {{image}}
#
# The file is generated WHOLE, like fastfetch: zathura cannot
# include another file from zathurarc, so "config" and "colours" cannot be
# split in two. That is why zathura has no stow package.
#
# Fixed Tokyo Night base, matugen accent. Same roles as everywhere else:
# primary for the active thing, tertiary for the secondary one.

# ---- Document ----
# recolor inverts the white of the PDF to dark. recolor-keephue keeps the
# colour of figures and photos instead of flattening everything to two tones.
set recolor                   true
set recolor-keephue           true
set recolor-lightcolor        "#1a1b26"
set recolor-darkcolor         "#c0caf5"

# Ctrl+R toggles recolor. Turning it off shows the PDF as its author made it,
# which is needed when the document carries signatures, stamps or colour
# graphics.

# ---- Chrome ----
set default-bg                "#1a1b26"
set default-fg                "#c0caf5"
set statusbar-bg              "#15161e"
set statusbar-fg              "#c0caf5"
set inputbar-bg               "#15161e"
set inputbar-fg               "#c0caf5"
set completion-bg             "#292e42"
set completion-fg             "#c0caf5"
set completion-group-bg       "#15161e"
set completion-group-fg       "#565f89"
set completion-highlight-bg   "{{colors.primary.default.hex}}"
set completion-highlight-fg   "#15161e"

# ---- Search ----
# The match under the cursor gets the accent; the rest get the secondary one.
#
# The alpha goes in the colour itself, via rgba(). The
# highlight-transparency option NO longer exists (removed upstream) and
# setting it prints a warning at startup. Without translucency the highlight
# covers the very text you are searching for.
set highlight-color           "rgba({{colors.tertiary.default.red}},{{colors.tertiary.default.green}},{{colors.tertiary.default.blue}},0.4)"
set highlight-active-color    "rgba({{colors.primary.default.red}},{{colors.primary.default.green}},{{colors.primary.default.blue}},0.55)"

# ---- Notifications ----
set notification-bg           "#15161e"
set notification-fg           "#c0caf5"
set notification-warning-bg   "#e0af68"
set notification-warning-fg   "#15161e"
set notification-error-bg     "#f7768e"
set notification-error-fg     "#15161e"

# ---- Behaviour ----
set window-title-basename     true
set statusbar-home-tilde      true
set selection-clipboard       clipboard
set scroll-step               80
set guioptions                ""
set adjust-open               width
set font                      "monospace 10"
