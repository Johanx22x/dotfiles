# GENERATED BY MATUGEN - do not edit by hand.
# Edit the template: ~/.config/matugen/templates/dunstrc
# and then run: wallpaper-switch reapply
#
# Current wallpaper: {{image}}
#
# Based on /etc/dunst/dunstrc. dunst does not support "include", which is why
# the whole file is regenerated instead of just the colours.
# Reference: man 5 dunst

[global]
    # ---- Position ----
    # follow = mouse makes notifications appear on whichever monitor the
    # cursor is on; handy with two screens.
    follow = mouse
    width = (300, 450)
    height = (0, 300)
    origin = top-right
    # CAREFUL: the offset is relative to the USABLE AREA, not to the screen
    # edge. That area already starts below waybar's exclusive zone (20 of
    # margin + 44 of height = 64), so aligning the top corner with the
    # windows only takes gaps_out on both axes.
    offset = (20, 20)
    scale = 0
    notification_limit = 20

    # ---- Appearance ----
    # Same rounding and border as windows in hyprland.lua
    corner_radius = 10
    corners = all
    frame_width = 2
    frame_color = "{{colors.primary.default.hex}}"
    separator_height = 2
    separator_color = frame
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 8
    # 15% transparency = 0.85 opacity, the setup's "glass" standard.
    # The blur comes from the blur-dunst layer_rule.
    transparency = 15

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 400
    progress_bar_corner_radius = 5

    # ---- Text ----
    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no
    show_age_threshold = 60

    # ---- Icons ----
    enable_recursive_icon_lookup = true
    # Three themes, and the order matters. Modern Adwaita only ships
    # "-symbolic.svg" variants: classic names such as dialog-information do
    # NOT resolve, so the default_icon entries in the urgency sections below
    # drew nothing and notifications without their own icon came up bare.
    # AdwaitaLegacy (package adwaita-icon-theme-legacy) keeps the classic
    # PNGs.
    #
    # Verified with: find /usr/share/icons/Adwaita -name 'dialog-information.*'
    # which returns nothing, and the same in AdwaitaLegacy, which does.
    #
    # And breeze-dark third for a very specific reason, tied to the min/max
    # below: dunst DISCARDS the theme icon if the theme does not offer it at
    # the requested size, it does not take the largest one available. With
    # min_icon_size = 72, AdwaitaLegacy (which stops at 48 px) stopped being
    # usable and notifications without their own icon came up bare again.
    # breeze-dark ships SVG, which render at any size, and in a light tone,
    # which is what reads over the dark background.
    #
    # If you ever raise min_icon_size, check this with:
    #   dunstify -a test "No icon" "the default_icon should show up"
    icon_theme = "Adwaita, AdwaitaLegacy, breeze-dark"
    icon_position = left
    # Both at the SAME value on purpose: that way every icon comes out
    # exactly the same size. dunst scales up anything below min_icon_size
    # and scales down anything above max_icon_size, so
    # matching them leaves a single possible size and notifications do not
    # jump around depending on the resolution each app happens to send.
    #
    # 72 and not 96: the previous cap made the icon outweigh the text. With
    # recursive_icon_lookup on, dunst picks the closest size from the Adwaita
    # theme before scaling, so system icons do not look soft.
    #
    # Non-square images keep their aspect ratio: the cover art from
    # mpris-notify are 16:9 thumbnails, and they fit to 72 wide.
    min_icon_size = 72
    max_icon_size = 72
    icon_corner_radius = 6

    # ---- Comportamiento ----
    indicate_hidden = yes
    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    sticky_history = yes
    history_length = 20

    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    # Native Wayland, no XWayland
    force_xwayland = false

    # ---- Mouse ----
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    # Pauses the auto-dismiss while the cursor is over it
    pause_on_mouse_over = true

# Palette aligned with waybar: base #1a1b26, text #c0caf5
[urgency_low]
    background = "#1a1b26"
    foreground = "#7f88a8"
    frame_color = "{{colors.primary.default.hex}}"
    timeout = 8
    default_icon = dialog-information

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "{{colors.primary.default.hex}}"
    timeout = 10
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning

# ---- Claude Code ----
# Claude Code does not talk to the notification server itself: it asks the
# terminal to (kitty, OSC 99 sequence), and kitty signs the notification as
# its own. That is why the kitty logo shows up even when the alert is
# Claude's.
#
# It cannot be fixed from Claude Code or from kitty, so it is corrected on
# arrival. Both criteria are needed together: filtering by appname alone
# would repaint ANY alert launched from kitty (btop, an own script, whatever).
#
# The icon does not ship with the package -- Claude Code installs as a
# standalone binary with no resources -- so it is kept in the repo, in the
# "icons" stow package. It came from
# https://claude.ai/images/claude_app_icon.png
# It is stored at its original resolution (338 px): the on-screen size is set
# by min_icon_size / max_icon_size in [global], which are equal to each
# other, not by the file. A dunst rule cannot override those two -- they are
# not among the options it accepts, see the list in /etc/dunst/dunstrc -- but
# since every icon is the same size, it is not needed either.
[claude-code]
    appname = "kitty"
    summary = "Claude Code"
    new_icon = /home/johan/.local/share/icons/claude.png
