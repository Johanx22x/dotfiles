# GENERADO POR MATUGEN - no editar a mano.
# Edita la plantilla: ~/.config/matugen/templates/dunstrc
# y luego corre: wallpaper-switch reapply
#
# Wallpaper actual: {{image}}
#
# Basado en /etc/dunst/dunstrc. dunst no soporta "include", por eso
# se regenera el archivo entero en vez de solo los colores.
# Referencia: man 5 dunst

[global]
    # ---- Posicion ----
    # follow = mouse hace que las notificaciones salgan en el monitor
    # donde este el cursor; util con dos pantallas.
    follow = mouse
    width = (300, 450)
    height = (0, 300)
    origin = top-right
    # OJO: el offset es relativo al AREA UTILIZABLE, no al borde de la
    # pantalla. Esa area ya empieza debajo de la zona exclusiva de waybar
    # (20 de margen + 44 de alto = 64), asi que para alinear la esquina
    # superior con la de las ventanas basta con gaps_out en ambos ejes.
    offset = (20, 20)
    scale = 0
    notification_limit = 20

    # ---- Apariencia ----
    # Mismo redondeo y borde que las ventanas en hyprland.lua
    corner_radius = 10
    corners = all
    frame_width = 2
    frame_color = "{{colors.primary.default.hex}}"
    separator_height = 2
    separator_color = frame
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 8
    # 15% de transparencia = 0.85 de opacidad, el estandar "glass"
    # del setup. El desenfoque lo pone la layer_rule blur-dunst.
    transparency = 15

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 400
    progress_bar_corner_radius = 5

    # ---- Texto ----
    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no
    show_age_threshold = 60

    # ---- Iconos ----
    enable_recursive_icon_lookup = true
    # Dos temas, y el orden importa. Adwaita moderno solo trae variantes
    # "-symbolic.svg": nombres clasicos como dialog-information NO
    # resuelven, asi que los default_icon de las secciones de urgencia
    # de mas abajo no pintaban nada y las notificaciones sin icono
    # propio salian peladas. AdwaitaLegacy (paquete
    # adwaita-icon-theme-legacy) conserva los PNG de toda la vida.
    #
    # Comprobado con: find /usr/share/icons/Adwaita -name 'dialog-information.*'
    # que no devuelve nada, y lo mismo en AdwaitaLegacy que si.
    #
    # Y breeze-dark el tercero por una razon muy concreta, ligada a los
    # min/max de abajo: dunst DESCARTA el icono del tema si este no lo
    # ofrece al tamano pedido, no coge el mas grande que tenga. Con
    # min_icon_size = 72, AdwaitaLegacy (que se queda en 48 px) dejaba
    # de servir y las notificaciones sin icono propio volvian a salir
    # peladas. breeze-dark trae SVG, que se rinden a cualquier tamano, y
    # ademas en tono claro, que es lo que se ve sobre el fondo oscuro.
    #
    # Si algun dia subes min_icon_size, comprueba esto con:
    #   dunstify -a prueba "Sin icono" "deberia salir el default_icon"
    icon_theme = "Adwaita, AdwaitaLegacy, breeze-dark"
    icon_position = left
    # Los dos al MISMO valor a proposito: asi todos los iconos salen
    # exactamente igual de grandes. dunst amplia lo que baja de
    # min_icon_size y reduce lo que pasa de max_icon_size, asi que
    # igualarlos deja una unica medida posible y las notificaciones no
    # bailan de tamano segun la resolucion que traiga cada app.
    #
    # 72 y no 96: el tope anterior hacia que el icono pesara mas que el
    # texto. Con recursive_icon_lookup activo, dunst elige del tema
    # Adwaita el tamano mas cercano antes de escalar, asi que los iconos
    # del sistema no se ven blandos.
    #
    # Las imagenes que no son cuadradas conservan su proporcion: las
    # caratulas de mpris-notify son miniaturas 16:9, y se ajustan a 72
    # de ancho.
    min_icon_size = 72
    max_icon_size = 72
    icon_corner_radius = 6

    # ---- Comportamiento ----
    indicate_hidden = yes
    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    sticky_history = yes
    history_length = 20

    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    # Wayland nativo, sin XWayland
    force_xwayland = false

    # ---- Mouse ----
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    # Pausa el cierre automatico mientras el cursor esta encima
    pause_on_mouse_over = true

# Paleta alineada con waybar: base #1a1b26, texto #c0caf5
[urgency_low]
    background = "#1a1b26"
    foreground = "#7f88a8"
    frame_color = "{{colors.primary.default.hex}}"
    timeout = 8
    default_icon = dialog-information

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "{{colors.primary.default.hex}}"
    timeout = 10
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning

# ---- Claude Code ----
# Claude Code no habla con el servidor de notificaciones por su cuenta:
# se lo pide a la terminal (kitty, secuencia OSC 99), y kitty firma la
# notificacion como suya. De ahi que salga el logo de kitty aunque el
# aviso sea de Claude.
#
# No se puede arreglar desde Claude Code ni desde kitty, asi que se
# corrige al recibirla. Los dos criterios juntos hacen falta: filtrar
# solo por appname repintaria CUALQUIER aviso lanzado desde kitty
# (btop, un script propio, lo que sea).
#
# El icono no viene con el paquete -- Claude Code se instala como un
# binario suelto, sin recursos -- asi que se guarda en el repo, en el
# paquete stow "icons". Salio de https://claude.ai/images/claude_app_icon.png
# Se guarda a su resolucion original (338 px): el tamano en pantalla lo
# fijan min_icon_size / max_icon_size de [global], iguales entre si, no
# el archivo. Una regla de dunst no puede sobrescribir esos dos -- no
# estan entre las opciones que admite, ver la lista en
# /etc/dunst/dunstrc -- pero al ser el mismo tamano para todos, tampoco
# hace falta.
[claude-code]
    appname = "kitty"
    summary = "Claude Code"
    new_icon = /home/johan/.local/share/icons/claude.png
