[Unit]
Description=Rotate the wallpaper every 30 minutes

[Timer]
# First change 5 min after the timer starts, then every 30 min.
#
# CAREFUL: this is OnActiveSec, not OnStartupSec. OnStartupSec is measured
# from when systemd --user started; if you enable the timer after that, the
# moment has already passed and the timer is left with no next run (NEXT = -).
# OnActiveSec is measured from when the timer is activated, which is what we
# want.
#
# To change the interval, edit OnUnitActiveSec and run:
#   systemctl --user daemon-reload && systemctl --user restart wallpaper-rotate.timer
OnActiveSec=5min
OnUnitActiveSec=30min
# Keeps several timers from firing at exactly the same instant
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
