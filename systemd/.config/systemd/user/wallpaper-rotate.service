[Unit]
Description=Rota el wallpaper y regenera la paleta de acentos
# Solo tiene sentido con una sesion grafica viva
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/wallpaper-switch random
# El script necesita hablar con Hyprland y con awww
Environment=XDG_RUNTIME_DIR=%t
