[Unit]
Description=Rotate the wallpaper and regenerate the accent palette
# Only makes sense with a live graphical session
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/wallpaper-switch random
# The script needs to talk to Hyprland and to awww
Environment=XDG_RUNTIME_DIR=%t
