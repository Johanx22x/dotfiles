# The Arch PKGBUILD for xwayland-satellite 0.8.2, plus the one-line fix from
# upstream PR #480, because without it DaVinci Resolve cannot be opened at all
# under niri.
#
# WHAT IT FIXES. 0.8.2 misclassifies a resizable DIALOG that carries
# WM_TRANSIENT_FOR and client-side _MOTIF_WM_HINTS as an xdg_popup, and parents
# it to the hidden 1x1 WM_CLIENT_LEADER window. Resolve's project manager is
# exactly that window, so it is never handed to the compositor: the splash
# appears, the splash closes, and nothing is left on screen. Resolve itself is
# fine -- it initialises CUDA and OpenGL without one error and reaches
# "Launching main loop" -- and `niri msg windows` lists nothing, because the
# window never reaches niri to be listed.
#
# It is a REGRESSION, introduced by commit ade7778e after 0.8.1 and first
# shipped in 0.8.2. That is why the same machine ran Resolve happily on
# 2026-08-17: it opened straight into the last project, and a session that
# never shows the project manager never touches the bug.
#
#   https://github.com/Supreeeme/xwayland-satellite/issues/470
#   https://github.com/Supreeeme/xwayland-satellite/issues/481
#   https://github.com/Supreeeme/xwayland-satellite/pull/480
#
# The upstream test added by the patch is called davinci_resolve_project_manager
# and matches on wm_class "resolve". This is not a workaround shaped to fit;
# it is the case the fix was written for.
#
# DELETE THIS WHOLE DIRECTORY once the fix is in the repos. pkgrel is 1.1 rather
# than 2 on purpose: it beats the current 0.8.2-1 so pacman installs it, and it
# LOSES to any future 0.8.2-2 or 0.8.3, so a released fix replaces this package
# on its own with no pin to remember and nothing in IgnorePkg to clean up.
#
# Build and install:   cd this directory && makepkg -si
# (-s pulls clang and rust as build dependencies; add -r to drop them after.)
#
# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=xwayland-satellite
pkgver=0.8.2
pkgrel=1.1
pkgdesc="Xwayland outside your Wayland"
arch=(x86_64)
url="https://github.com/Supreeeme/xwayland-satellite"
license=(MPL-2.0)
depends=(
  glibc
  libgcc
  libxcb
  xcb-util-cursor
  xorg-xwayland
)
makedepends=(
  clang
  rust
)
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  480-dialog-toplevel.patch
)
sha512sums=(
  'a125fe92591c7c39c4ae05e5d7a5b737d4104419165b98e4d486c5e2208b30b95173f2793141ef897f23f22c87c15f80daf8dcc2dbb4327c2fdf3288d56acd80'
  'd75cb3f6e45a68214400a7d7b674bc51f01725848b811bb7bf4fcd683716f2bf53fa608d39a7c1ef2de2860c013a88cc4754887a10cf37e6fdbab1367b779f4e'
)
b2sums=(
  '3bd8880386f0b2f73d2587e9ad5803ded1e107be4f4b8fe75f17453a3e98624f9f34c15a2ef11a2bb8362809100b6d9ce4fd6e1d350af164b3cf954cae7653db'
  'SKIP'
)

prepare() {
  cd $pkgname-$pkgver
  patch -Np1 -i "$srcdir/480-dialog-toplevel.patch"
  sed 's|/usr/local|/usr|' -i resources/$pkgname.service
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname-$pkgver
  cargo build --frozen --release --features systemd
}

# KEPT, AND THE REASON IS THE PATCH ITSELF. Upstream PR #480 is two hunks: the
# classification change in src/xstate/mod.rs and a regression test beside it in
# src/xstate/tests.rs called davinci_resolve_project_manager. This block is what
# runs that test, so deleting it -- or reaching for `makepkg --nocheck` -- would
# leave the one thing this whole directory exists for verified by nobody.
#
# --lib, AND EVERYTHING BELOW IS WHY. `cargo test` here builds four test
# binaries, of which two hold anything at all:
#
#   unittests src/lib.rs     81 tests   <- davinci_resolve_project_manager
#   unittests src/main.rs     0 tests
#   tests/integration.rs     28 tests   <- drives a real Xwayland
#   Doc-tests                 0 tests
#
# `--lib` is the first of those and nothing else. The regression test this
# directory exists for is a pure unit test of guess_window_role, so it is in
# the 81 and is still run on every build; what stops being run is upstream's
# 28-test Xwayland integration suite.
#
# THIS WAS ASKED ONCE BEFORE AND THE ANSWER WAS NO, correctly. The note that
# used to stand here said the suite was "green on every build of this package
# since the job was added", and when the first flake report came in, a sweep of
# every installer job the repository then had -- 40 of them -- found not one
# FAILED line. Turning off 109 tests to quiet a failure that had never actually
# happened would have been a straight loss, so nothing was turned off. That
# reasoning was right. The data underneath it is what changed.
#
# WHAT THE DATA SAYS NOW, from all 66 installer jobs that have built this
# package, which between them ran the suites 72 times:
#
#   unittests src/lib.rs     72 of 72 green   0 failures, ever
#   tests/integration.rs     65 of 72 green   7 failures, ~10% of executions
#
# and the seven failures are spread over SEVEN DIFFERENT TESTS -- toplevel_flow
# four times, copy_from_wayland three, and one each of fake_selection_targets,
# xdg_decorations, xsettings_scale, output_offset_xdg_matches_crtcs and
# funny_window_title_class. A quarter of the suite has flaked in four bad jobs.
#
# SO `--skip` BY NAME, WHICH IS WHAT THIS COMMENT USED TO TELL THE NEXT PERSON
# TO DO, IS THE WRONG SHAPE. That advice assumed one bad test. Naming seven
# would not be excluding the tests that flake, it would be excluding the ones
# that have flaked SO FAR, and the list would grow by attrition every few days
# with nobody able to say when it was finished. The failing unit is the suite,
# not any test in it.
#
# AND IT IS NOT GLAMOR, WHICH IS THE OBVIOUS SUSPECT AND A RED HERRING. The
# failing runs all show "Failed to initialize glamor, falling back to sw" and
# the green ones appear not to, but that is an artifact of how the test harness
# reports: it captures each test's output and prints it only for the ones that
# FAILED. Every Xwayland in every run says it, green included; you only get to
# read it when something has already gone wrong. What the panics actually say
# is timing -- ten of the twelve are "Did not receive any events", one is "Did
# not get any X11 events", and the last is an assertion that read an output's
# geometry before the update to it arrived. These are fixed-timeout waits on a
# shared two-core runner, and no amount of retrying makes a deadline generous.
#
# WHAT THAT COSTS, said plainly rather than left to be discovered. Upstream's
# end-to-end coverage of v0.8.2 -- selections, decorations, output geometry,
# window title and class round-trips through a real Xwayland -- is no longer
# checked by anything in this repository. The judgement is that it was not this
# repository's to check: this builds a RELEASED TAG plus three lines, and the
# three lines are a pure function whose own test module (81 tests, of which the
# window_role_heuristics group alone is over twenty) covers it directly.
# Upstream's reviewer said the same thing on PR #480 in as many words, asking
# for the integration-test changes to be dropped because the unit test was
# enough. Re-verifying somebody else's release on every one of Johan's
# quickshell pull requests, at a 10% cost in false failures, is not a trade
# worth making -- and a check that fails one time in ten teaches everybody to
# press rerun, which is precisely how a real failure eventually gets rerun into
# green.
#
# TO PUT IT BACK, drop the `--lib`. If you want the coverage without the flake,
# the thing to try first is `--test-threads=1` on the integration binary: the
# whole suite finishes in nine seconds with everything running at once, so the
# contention is self-inflicted and serialising it is cheap. That is a
# hypothesis and not a measurement, which is why it is written here as the next
# experiment rather than shipped as the fix.
#
# XDG_RUNTIME_DIR went with the integration suite. Nothing in src/ or tests/
# reads it -- it was there so the Wayland server those tests stand up had a
# directory to put its socket in, and no unit test stands one up.
check() {
  cd $pkgname-$pkgver
  cargo test --frozen --lib
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 resources/$pkgname.service -t "$pkgdir/usr/lib/systemd/user/"
  # $pkgname, NOT $pkgdir, AND THE UPSTREAM PKGBUILD HAS THIS WRONG. Arch's
  # own file says `licenses/$pkgdir/`, which expands to the absolute path of
  # the build directory pasted inside itself. The CI build log shows where the
  # licence landed:
  #
  #   usr/share/licenses//tmp/tmp.4JmHBBNZH9/repo/packages/xwayland-satellite/
  #     pkg/xwayland-satellite/LICENSE
  #
  # -- a path made of whoever's machine did the build, so no two builds of this
  # package agree, and `pacman -Ql xwayland-satellite` cannot find the licence
  # where every other package keeps it. This is the one place this file departs
  # from upstream other than the patch; it is a typo, not a decision, and it
  # goes with the directory when the directory goes.
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
