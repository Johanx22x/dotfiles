# -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
# WOFI - behaviour
#
# Only the clipboard history menu (SUPER + V) reads this file. The app
# launcher and the power menu are started by ~/.local/bin/wofi-drun and
# ~/.local/bin/hypr-powermenu, which run wofi with XDG_CONFIG_HOME pointing
# at an empty directory and therefore pass every option on the command line.
#
# Appearance lives in style.css.
# -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

# Window size. Accepts px or a percentage.
width=600
height=420

# Placeholder text in the search bar
prompt=Search

# Case-insensitive and fuzzy search (no exact match required)
insensitive=true
matching=fuzzy

# Application icons
allow_images=true
image_size=28

# Hide the scrollbar (the stylesheet assumes it is hidden)
hide_scroll=true

# Run the app as soon as a single result is left? No: it gets in the way
# while typing. Leave it false unless you want to launch without Enter.
# auto_select=false

# Terminal for apps declaring Terminal=true in their .desktop
term=kitty

# Hide the extra .desktop "actions" (Open new window, etc.)
# Set to false if you want to see them.
no_actions=true

# Compositor layer. overlay = always on top, even over waybar.
layer=overlay
